{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AddressLookup": {
    "BaseUrl": "https://provinces.open-api.vn/api/v2/",
    "TimeoutSeconds": 5,
    "CacheHours": 24,
    "FailureCacheSeconds": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
