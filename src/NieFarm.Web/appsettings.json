{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AddressLookup": {
    "BaseUrl": "https://provinces.open-api.vn/api/v2/",
    "TimeoutSeconds": 5,
    "CacheHours": 24,
    "FailureCacheSeconds": 60
  },
  "Payments": {
    "BankTransfer": {
      "Enabled": false,
      "BankBin": "",
      "BankName": "",
      "AccountNumber": "",
      "AccountName": "",
      "Branch": ""
    },
    "SePay": {
      "Enabled": false,
      "TimestampToleranceSeconds": 300
    }
  },
  "Site": {
    "PublicBaseUrl": "https://niefarm.vn"
  },
  "Traceability": {
    "RateLimitPerMinute": 30,
    "ScanDedupeMinutes": 30,
    "FlushIntervalSeconds": 120,
    "DailyScanAlertThreshold": 200,
    "PackCountAlertMultiplier": 3
  },
  "ReverseProxy": {
    "Enabled": false,
    "TrustedNetworks": [],
    "ForwardLimit": 1
  },
  "CartCleanup": {
    "Enabled": true,
    "IntervalMinutes": 360,
    "EmptyCartIdleDays": 7,
    "IdleCartDays": 0,
    "BatchSize": 500,
    "MaxBatchesPerRun": 20,
    "InitialDelaySeconds": 120,
    "InitialDelayJitterSeconds": 300
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
