@page "/hoat-dong"
@using NieFarm.Application.Features.Activities.Dtos
@using NieFarm.Application.Features.Activities.Queries
@using NieFarm.Domain.Enums
@inject ISender Sender

@*
    Full markup rewrite onto the NieFarm 2.0 design language (docs/plans/public-site-redesign-nf2.md
    §7, step 3.4). @code is unchanged — GetActivitiesQuery, Open/Close, HeightClass, FormatPeriod/
    FormatFullDate all preserved. The masonry and the modal are the page: ".masonry-grid"/
    ".masonry-item" -> ".nf-masonry"/".nf-masonry__item" (same column-count technique, hairline card
    edges instead of borders/shadow); HeightClass keeps mapping ActivityCardSize in C# but now to
    ".nf-masonry__img--sm/md/lg/xl" instead of Tailwind "h-64"/"h-72"/"h-80"/"h-96". ".modal-overlay"/
    ".modal-content" -> ".nf-modal"/".nf-modal__panel", keeping the "active" class, @onclick:stopPropagation,
    role="dialog", aria-modal, aria-labelledby and the backdrop-click close. ".rich-text-content" on
    the body is untouched (ported by name in nf.css).

    Note: the current implementation closes the modal on backdrop click only — there is no Escape-key
    listener in the pre-redesign markup to preserve, so none is added here (see the phase-3 report).
*@

<PageTitle>Nhật ký hoạt động - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="description"
          content="Khoảnh khắc từ nông trại Nie Farm: mùa thu hoạch, kiểm định chất lượng, hội thảo canh tác bền vững và nâng cấp cơ sở chế biến." />
</HeadContent>

<section style="padding-block:clamp(7.5rem,14vh,10rem) clamp(1.5rem,3vw,2.5rem);text-align:center">
    <div class="shell" style="max-width:760px;margin-inline:auto">
        <p class="eyebrow" style="justify-content:center" data-reveal="fade">Nhật ký hoạt động</p>
        <h1 style="margin-top:1rem" data-reveal>
            Câu chuyện từ <span class="accent">nông trại</span>
        </h1>
        <p class="lede" style="margin:1.5rem auto 0;text-align:center" data-reveal="fade">
            Khám phá những khoảnh khắc chân thực nhất từ nông trại Nie Farm, nơi sự tâm huyết và kỹ
            thuật canh tác hiện đại hòa quyện để tạo nên những hạt cà phê chất lượng cao.
        </p>
    </div>
</section>

<section style="padding-bottom:clamp(3rem,7vw,6rem)">
    <div class="shell">
        @if (_activities.Count == 0)
        {
            <p class="muted" style="text-align:center;padding-block:3rem">
                Chưa có hoạt động nào được đăng tải.
            </p>
        }
        else
        {
            <div class="nf-masonry">
                @for (var i = 0; i < _activities.Count; i++)
                {
                    var current = _activities[i];
                    var delay = (i % 3) * 0.08;

                    <div class="nf-masonry__item" data-reveal="fade" style="--d:@(delay.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture))s">
                        <button type="button" class="nf-masonry__card" @onclick="() => Open(current)">
                            <span class="nf-masonry__media">
                                <img class="@($"nf-masonry__img {HeightClass(current.CardSize)}")"
                                     src="@current.ImageUrl" alt="@current.ImageAlt" />
                            </span>
                            <span class="nf-masonry__body">
                                <span class="nf-masonry__title">@current.Title</span>
                                <span class="nf-masonry__date">
                                    <NfIcon Name="calendar" Size="15" /> @FormatPeriod(current.EventDate)
                                </span>
                            </span>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
</section>

@* Detail modal *@
<div class="nf-modal @(_selected is null ? null : "active")"
     role="dialog" aria-modal="true" aria-labelledby="activity-modal-title"
     aria-hidden="@(_selected is null)" @onclick="Close">

    @if (_selected is not null)
    {
        <div class="nf-modal__panel" @onclick:stopPropagation="true">

            <button type="button" @onclick="Close" aria-label="Đóng" class="nf-modal__close">
                <NfIcon Name="close" Size="18" />
            </button>

            <img class="nf-modal__media" src="@_selected.ImageUrl" alt="@_selected.ImageAlt" />

            <div class="nf-modal__body">
                <p class="nf-modal__date">
                    <NfIcon Name="calendar" Size="17" /> @FormatFullDate(_selected.EventDate)
                </p>

                <h2 id="activity-modal-title">@_selected.ModalTitle</h2>

                <div class="rich-text-content" style="margin-top:1.5rem">
                    @((MarkupString)_selected.Body)
                </div>

                <div class="nf-modal__foot">
                    <span class="eyebrow eyebrow--plain" style="color:var(--gold)">Nie Farm Việt Nam</span>
                    <button type="button" @onclick="Close" class="btn btn--ghost"><span>Đóng</span></button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<ActivityDto> _activities = [];
    private ActivityDto? _selected;

    protected override async Task OnInitializedAsync() =>
        _activities = await Sender.Send(new GetActivitiesQuery());

    private void Open(ActivityDto activity) => _selected = activity;

    private void Close() => _selected = null;

    private static string HeightClass(ActivityCardSize size) => size switch
    {
        ActivityCardSize.Short => "nf-masonry__img--sm",
        ActivityCardSize.Medium => "nf-masonry__img--md",
        ActivityCardSize.Tall => "nf-masonry__img--lg",
        ActivityCardSize.ExtraTall => "nf-masonry__img--xl",
        _ => "nf-masonry__img--md"
    };

    private static string FormatPeriod(DateOnly date) => $"Tháng {date.Month}, {date.Year}";

    private static string FormatFullDate(DateOnly date) => date.ToString("dd 'Tháng' M, yyyy");
}
