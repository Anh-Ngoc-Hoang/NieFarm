@page "/bai-viet/{Slug}"
@using NieFarm.Application.Features.Articles.Dtos
@using NieFarm.Application.Features.Articles.Queries
@using NieFarm.Application.Features.Products.Dtos
@using NieFarm.Application.Features.Products.Queries
@inject ISender Sender
@inject NavigationManager Navigation

@*
    NieFarm 2.0 design language. Data comes from GetArticleDetailQuery (docs/plans/R-08-articles-real-data.md):
    an unknown / unpublished / hidden-category slug is a real 404. The body is admin-authored HTML,
    rendered through MarkupString; that is safe only because GetArticleDetailQueryHandler sanitises
    it server-side on every read (as well as on write). Never render a body that did not come
    through that query. ".premium-divider" -> ".hairline"; CTA banner -> ".cupout"; sidebar -> a
    sticky column (".apage__sidebar"). No Tags row and no comments: there is no data behind them.
*@

@if (Data is { } data)
{
    <PageTitle>@data.Article.Title - Nie Farm Việt Nam</PageTitle>

    <HeadContent>
        <meta name="description" content="@data.Article.Summary" />
    </HeadContent>

    <section class="apage">
        <div class="shell apage__grid">

            @* Article body *@
            <article style="min-width:0">
                <div class="apage__meta">
                    <a class="chip" href="/kien-thuc?danh-muc=@Uri.EscapeDataString(data.Article.CategorySlug)">@data.Article.CategoryName</a>
                    <span style="display:inline-flex;align-items:center;gap:.4rem">
                        <NfIcon Name="calendar" Size="15" /> @data.Article.PublishedOn.ToString("dd/MM/yyyy")
                    </span>
                    <span style="display:inline-flex;align-items:center;gap:.4rem">
                        <NfIcon Name="user" Size="15" /> @data.Article.Author
                    </span>
                </div>

                <h1 style="margin-bottom:0">@data.Article.Title</h1>

                @if (data.Article.HeroImageUrl is not null)
                {
                    <figure class="apage__hero" style="margin:2rem 0 clamp(2.5rem,5vw,3.5rem)">
                        <img src="@data.Article.HeroImageUrl" alt="@data.Article.HeroImageAlt" />
                    </figure>
                }
                else
                {
                    <div style="margin-bottom:clamp(2.5rem,5vw,3.5rem)"></div>
                }

                <div class="article-content">
                    @if (string.IsNullOrWhiteSpace(data.Article.BodyHtml))
                    {
                        <p>@data.Article.Summary</p>
                        <p>Nội dung đầy đủ của bài viết đang được cập nhật.</p>
                    }
                    else
                    {
                        @* Safe: BodyHtml is sanitised server-side in GetArticleDetailQueryHandler. *@
                        @((MarkupString)data.Article.BodyHtml)
                    }
                </div>

                @* Share *@
                <hr class="hairline" style="margin-top:3rem" />
                <div style="padding-top:1.75rem;display:flex;flex-wrap:wrap;justify-content:flex-end;align-items:center;gap:1.25rem">
                    <div style="display:flex;align-items:center;gap:.75rem">
                        <span class="muted" style="font-size:var(--fs-xs)">Chia sẻ:</span>
                        <button type="button" class="iconbtn" style="box-shadow:inset 0 0 0 1px var(--line)"
                                data-copy="@Navigation.Uri" aria-label="Sao chép liên kết bài viết" title="Sao chép liên kết">
                            <NfIcon Name="share" Size="17" />
                        </button>
                    </div>
                </div>
            </article>

            @* Sidebar *@
            <aside class="apage__sidebar">

                @if (data.Article.Related.Count > 0)
                {
                    <div class="apage__side-card">
                        <h2>Bài viết liên quan</h2>
                        <ul class="apage__side-list">
                            @foreach (var related in data.Article.Related)
                            {
                                <li class="apage__side-item">
                                    <a href="/bai-viet/@related.Slug" style="display:contents">
                                        <span class="apage__side-thumb">
                                            @if (related.ImageUrl is not null)
                                            {
                                                <img src="@related.ImageUrl" alt="@related.ImageAlt" loading="lazy" />
                                            }
                                        </span>
                                        <span>
                                            <span style="display:block;font-weight:600;line-height:1.35;margin-bottom:.35rem">
                                                @related.Title
                                            </span>
                                            <span class="muted" style="font-size:var(--fs-xs)">
                                                @related.PublishedOn.ToString("dd/MM/yyyy")
                                            </span>
                                        </span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <hr class="hairline" />
                }

                @if (data.SidebarProducts.Count > 0)
                {
                <div class="apage__side-card">
                    <h2>Sản phẩm nổi bật</h2>
                    <ul class="apage__side-list">
                        @foreach (var product in data.SidebarProducts)
                        {
                            <li class="apage__side-item">
                                <a href="@($"/san-pham/{product.Slug}")" style="display:contents">
                                    <span class="apage__side-thumb">
                                        <img src="@product.ImageUrl" alt="@product.ImageAlt" />
                                    </span>
                                    <span>
                                        <span style="display:block;font-weight:600;margin-bottom:.35rem">@product.Name</span>
                                        <span style="display:block;font-weight:700;margin-bottom:.35rem">@Money.Vnd(product.Price)</span>
                                        <span class="linkline" style="font-size:var(--fs-xs)">
                                            Xem chi tiết <NfIcon Name="arrow-right" Size="13" />
                                        </span>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <hr class="hairline" />
                }

                <div class="cupout" style="padding:clamp(1.75rem,4vw,2.5rem);text-align:left">
                    <div class="cupout__glow" aria-hidden="true"></div>
                    <h2 style="font-size:var(--fs-h3)">Khám phá dòng sản phẩm Specialty</h2>
                    <p style="margin:.85rem 0 1.5rem;margin-inline:0">
                        Trải nghiệm những hạt cà phê được tuyển chọn khắt khe nhất từ các vùng trồng nổi tiếng.
                    </p>
                    <a class="btn btn--red btn--block" href="/cua-hang"><span>Xem sản phẩm</span></a>
                </div>
            </aside>
        </div>
    </section>
}

@code {
    /// <summary>
    /// The article plus the sidebar products, kept as one [PersistentState] blob so the interactive
    /// render after prerendering does not re-query and flash an empty shell. The slug check in
    /// OnParametersSetAsync also covers in-circuit /bai-viet/a -> /bai-viet/b navigation.
    /// </summary>
    public record DetailData(ArticleDetailDto Article, IReadOnlyList<ProductCardDto> SidebarProducts);

    [Parameter]
    public string? Slug { get; set; }

    [PersistentState]
    public DetailData? Data { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        var slug = (Slug ?? string.Empty).Trim().ToLowerInvariant();

        if (Data is not null && string.Equals(Data.Article.Slug, slug, StringComparison.Ordinal))
            return;

        // Both are read-only queries on their own contexts, so they can run in parallel.
        var articleTask = Sender.Send(new GetArticleDetailQuery(slug));
        var productsTask = Sender.Send(new GetHomeFeaturedProductsQuery(2));
        await Task.WhenAll(articleTask, productsTask);

        var article = await articleTask;
        // A newer navigation (a -> b -> c) may have changed Slug while this one was in flight.
        if (!string.Equals((Slug ?? string.Empty).Trim().ToLowerInvariant(), slug, StringComparison.Ordinal))
            return;

        if (article is null)
        {
            Data = null;
            // Render the 404 page with a real 404 status rather than an empty article shell.
            Navigation.NotFound();
            return;
        }

        Data = new DetailData(article, await productsTask);
    }
}
