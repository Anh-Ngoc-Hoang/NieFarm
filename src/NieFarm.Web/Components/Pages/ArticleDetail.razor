@page "/bai-viet/{Slug}"
@inject NavigationManager Navigation

@if (_article is not null)
{
    <PageTitle>@_article.Title - Nie Farm Việt Nam</PageTitle>

    <HeadContent>
        <meta name="description" content="@_article.Summary" />
    </HeadContent>

    <div class="pt-12 pb-section-padding-y max-w-container-max mx-auto px-gutter">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">

            @* Article body *@
            <article class="lg:col-span-8 min-w-0">

                <div class="flex flex-wrap items-center gap-4 mb-6">
                    <a class="bg-amber-gold/10 text-amber-gold px-3 py-1 rounded-full text-label-bold font-semibold hover:bg-amber-gold/20 transition-colors"
                       href="/kien-thuc">
                        @_article.Category
                    </a>
                    <span class="text-on-surface-variant text-body-sm flex items-center">
                        <span class="material-symbols-outlined text-[16px] mr-1" aria-hidden="true">calendar_today</span>
                        @_article.PublishedOn.ToString("dd/MM/yyyy")
                    </span>
                    <span class="text-on-surface-variant text-body-sm flex items-center">
                        <span class="material-symbols-outlined text-[16px] mr-1" aria-hidden="true">person</span>
                        @_article.Author
                    </span>
                </div>

                <h1 class="text-headline-lg-mobile md:text-headline-lg text-deep-red mb-8">@_article.Title</h1>

                <div class="w-full h-[400px] md:h-[500px] rounded-xl overflow-hidden mb-12 shadow-sm border border-amber-gold/20">
                    <img class="w-full h-full object-cover" src="@_article.HeroImageUrl" alt="@_article.HeroImageAlt" />
                </div>

                <div class="article-content">
                    @if (_article.Blocks.Length == 0)
                    {
                        <p>@_article.Summary</p>
                        <p>Nội dung đầy đủ của bài viết đang được cập nhật.</p>
                    }
                    else
                    {
                        @foreach (var block in _article.Blocks)
                        {
                            switch (block.Kind)
                            {
                                case SiteContent.ArticleBlockKind.Heading2:
                                    <h2>@block.Html</h2>
                                    break;

                                case SiteContent.ArticleBlockKind.Heading3:
                                    <h3>@block.Html</h3>
                                    break;

                                case SiteContent.ArticleBlockKind.Paragraph:
                                    <p>@((MarkupString)block.Html!)</p>
                                    break;

                                case SiteContent.ArticleBlockKind.BulletList:
                                    <ul>
                                        @foreach (var item in block.Items!)
                                        {
                                            <li>@((MarkupString)item)</li>
                                        }
                                    </ul>
                                    break;

                                case SiteContent.ArticleBlockKind.Image:
                                    <div class="w-full h-[300px] rounded-xl overflow-hidden my-8 shadow-sm border border-amber-gold/20">
                                        <img class="w-full h-full object-cover"
                                             src="@block.ImageUrl" alt="@block.ImageAlt" />
                                    </div>
                                    break;
                            }
                        }
                    }
                </div>

                @* Tags and share *@
                <div class="mt-12 pt-8 premium-divider flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
                    <div class="flex items-center flex-wrap gap-2">
                        <span class="text-label-bold font-semibold text-on-surface-variant mr-2">Tags:</span>
                        @foreach (var tag in _article.Tags)
                        {
                            <span class="px-3 py-1 bg-surface-container rounded text-body-sm">@tag</span>
                        }
                    </div>
                    <div class="flex items-center gap-4">
                        <span class="text-label-bold font-semibold text-on-surface-variant">Chia sẻ:</span>
                        <button type="button" aria-label="Chia sẻ bài viết"
                                class="w-10 h-10 rounded-full border border-amber-gold/50 flex items-center justify-center text-amber-gold hover:bg-amber-gold hover:text-white transition-colors">
                            <span class="material-symbols-outlined" aria-hidden="true">share</span>
                        </button>
                    </div>
                </div>

                @* Comments *@
                <section class="mt-16">
                    <h2 class="text-headline-md text-deep-red mb-8">Bình luận (@_article.Comments.Length)</h2>

                    <div class="mb-10 bg-white p-6 rounded-xl border border-soft-border shadow-sm">
                        <label class="sr-only" for="comment">Bình luận của bạn</label>
                        <textarea id="comment" rows="4"
                                  placeholder="Chia sẻ suy nghĩ của bạn về bài viết này..."
                                  class="w-full border border-surface-dim rounded-lg p-4 focus:ring-2 focus:ring-forest-green focus:border-transparent outline-none resize-none text-body-sm mb-4"></textarea>
                        <div class="flex justify-end">
                            <button type="button" class="btn-brand px-6 py-2 rounded font-label-bold text-label-bold">
                                Gửi bình luận
                            </button>
                        </div>
                    </div>

                    @if (_article.Comments.Length == 0)
                    {
                        <p class="text-body-sm text-on-surface-variant">
                            Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm nhận.
                        </p>
                    }
                    else
                    {
                        <ul class="space-y-6">
                            @foreach (var comment in _article.Comments)
                            {
                                <li class="flex gap-4 pb-6 border-b border-amber-gold/30 last:border-0 last:pb-0">
                                    <span class="w-12 h-12 rounded-full bg-amber-gold/20 flex items-center justify-center text-amber-gold font-bold shrink-0"
                                          aria-hidden="true">@comment.Initials</span>
                                    <div>
                                        <div class="flex flex-wrap items-baseline gap-2 mb-1">
                                            <h3 class="text-label-bold font-semibold text-deep-red">@comment.Name</h3>
                                            <span class="text-xs text-on-surface-variant">@comment.Ago</span>
                                        </div>
                                        <p class="text-body-sm text-on-surface-variant">@comment.Text</p>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>
            </article>

            @* Sidebar *@
            <aside class="lg:col-span-4">
                <div class="sticky top-28">

                    @if (_related.Count > 0)
                    {
                        <div class="bg-white p-6 rounded-xl border border-soft-border shadow-sm mb-8">
                            <h2 class="text-headline-sm font-bold text-deep-red mb-6 border-b border-amber-gold/20 pb-4">
                                Bài viết liên quan
                            </h2>
                            <ul class="space-y-6">
                                @foreach (var related in _related)
                                {
                                    <li>
                                        <a class="group flex gap-4 items-start" href="@related.Url">
                                            <div class="w-24 h-24 rounded-lg overflow-hidden shrink-0">
                                                <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                                     src="@related.ImageUrl" alt="@related.ImageAlt" />
                                            </div>
                                            <div>
                                                <h3 class="text-label-bold font-semibold text-on-background group-hover:text-amber-gold transition-colors line-clamp-2 mb-2">
                                                    @related.Title
                                                </h3>
                                                <span class="text-xs text-on-surface-variant">
                                                    @related.PublishedOn.ToString("dd/MM/yyyy")
                                                </span>
                                            </div>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="bg-white p-6 rounded-xl border border-soft-border shadow-sm mb-8">
                        <h2 class="text-headline-sm font-bold text-deep-red mb-6 border-b border-amber-gold/20 pb-4">
                            Sản phẩm nổi bật
                        </h2>
                        <ul class="space-y-6">
                            @foreach (var product in SiteContent.ArticleSidebarProducts)
                            {
                                <li class="group flex gap-4 items-start">
                                    <a class="w-24 h-24 rounded-lg overflow-hidden shrink-0 border border-surface-dim block"
                                       href="@($"/san-pham/{product.Slug}")">
                                        <img class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                             src="@product.ImageUrl" alt="@product.ImageAlt" />
                                    </a>
                                    <div class="flex-1">
                                        <h3 class="text-label-bold font-semibold text-on-background mb-1">@product.Name</h3>
                                        <p class="text-deep-red font-bold text-body-sm mb-2">@SiteContent.Vnd(product.Price)</p>
                                        <a class="text-xs font-semibold text-forest-green hover:text-amber-gold transition-colors inline-flex items-center gap-1"
                                           href="@($"/san-pham/{product.Slug}")">
                                            Xem chi tiết
                                            <span class="material-symbols-outlined text-[14px]" aria-hidden="true">arrow_forward</span>
                                        </a>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>

                    <div class="bg-deep-red rounded-xl p-6 text-center shadow-md relative overflow-hidden">
                        <div class="absolute inset-0 opacity-10 dotted-overlay" aria-hidden="true"></div>
                        <h2 class="text-headline-sm font-bold text-cream-ivory mb-4 relative z-10">
                            Khám phá dòng sản phẩm Specialty
                        </h2>
                        <p class="text-body-sm text-cream-ivory/80 mb-6 relative z-10">
                            Trải nghiệm những hạt cà phê được tuyển chọn khắt khe nhất từ các vùng trồng nổi tiếng.
                        </p>
                        <a class="btn-brand w-full py-3 rounded font-label-bold text-label-bold relative z-10 inline-flex items-center justify-center"
                           href="/cua-hang">
                            Xem Sản Phẩm
                        </a>
                    </div>
                </div>
            </aside>
        </div>
    </div>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private SiteContent.Article? _article;
    private List<SiteContent.Article> _related = [];

    protected override void OnParametersSet()
    {
        _article = SiteContent.Articles.FirstOrDefault(a =>
            string.Equals(a.Slug, Slug, StringComparison.OrdinalIgnoreCase));

        if (_article is null)
        {
            // Render the 404 page with a real 404 status rather than an empty article shell.
            Navigation.NotFound();
            return;
        }

        _related = SiteContent.RelatedArticles(_article).ToList();
    }
}
