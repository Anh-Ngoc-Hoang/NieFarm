@page "/bai-viet/{Slug}"
@inject NavigationManager Navigation

@*
    Full markup rewrite onto the NieFarm 2.0 design language (docs/plans/public-site-redesign-nf2.md
    §7, step 3.3). The ArticleBlock switch and MarkupString rendering are kept exactly as they are —
    the compile-time-constant safety note in CLAUDE.md still applies, this is presentation only.
    ".premium-divider" -> ".hairline"; the ".dotted-overlay" CTA banner -> the ".cupout" ink panel
    (already in nf-pages.css from /quy-trinh); comments -> a hairline list; sidebar -> a sticky
    column (".apage__sidebar", nf-pages.css). ".article-content" itself is retuned in nf.css
    (ported by name, unchanged here).
*@

@if (_article is not null)
{
    <PageTitle>@_article.Title - Nie Farm Việt Nam</PageTitle>

    <HeadContent>
        <meta name="description" content="@_article.Summary" />
    </HeadContent>

    <section class="apage">
        <div class="shell apage__grid">

            @* Article body *@
            <article style="min-width:0">
                <div class="apage__meta">
                    <a class="chip" href="/kien-thuc">@_article.Category</a>
                    <span style="display:inline-flex;align-items:center;gap:.4rem">
                        <NfIcon Name="calendar" Size="15" /> @_article.PublishedOn.ToString("dd/MM/yyyy")
                    </span>
                    <span style="display:inline-flex;align-items:center;gap:.4rem">
                        <NfIcon Name="user" Size="15" /> @_article.Author
                    </span>
                </div>

                <h1 style="margin-bottom:0">@_article.Title</h1>

                <figure class="apage__hero" style="margin:2rem 0 clamp(2.5rem,5vw,3.5rem)">
                    <img src="@_article.HeroImageUrl" alt="@_article.HeroImageAlt" />
                </figure>

                <div class="article-content">
                    @if (_article.Blocks.Length == 0)
                    {
                        <p>@_article.Summary</p>
                        <p>Nội dung đầy đủ của bài viết đang được cập nhật.</p>
                    }
                    else
                    {
                        @foreach (var block in _article.Blocks)
                        {
                            switch (block.Kind)
                            {
                                case SiteContent.ArticleBlockKind.Heading2:
                                    <h2>@block.Html</h2>
                                    break;

                                case SiteContent.ArticleBlockKind.Heading3:
                                    <h3>@block.Html</h3>
                                    break;

                                case SiteContent.ArticleBlockKind.Paragraph:
                                    <p>@((MarkupString)block.Html!)</p>
                                    break;

                                case SiteContent.ArticleBlockKind.BulletList:
                                    <ul>
                                        @foreach (var item in block.Items!)
                                        {
                                            <li>@((MarkupString)item)</li>
                                        }
                                    </ul>
                                    break;

                                case SiteContent.ArticleBlockKind.Image:
                                    <figure class="apage__hero" style="margin:2rem 0">
                                        <img src="@block.ImageUrl" alt="@block.ImageAlt" />
                                    </figure>
                                    break;
                            }
                        }
                    }
                </div>

                @* Tags and share *@
                <hr class="hairline" style="margin-top:3rem" />
                <div style="padding-top:1.75rem;display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:1.25rem">
                    <div style="display:flex;align-items:center;flex-wrap:wrap;gap:.5rem">
                        <span class="muted" style="font-size:var(--fs-xs)">Tags:</span>
                        @foreach (var tag in _article.Tags)
                        {
                            <span class="chip">@tag</span>
                        }
                    </div>
                    <div style="display:flex;align-items:center;gap:.75rem">
                        <span class="muted" style="font-size:var(--fs-xs)">Chia sẻ:</span>
                        <button type="button" class="iconbtn" style="box-shadow:inset 0 0 0 1px var(--line)" aria-label="Chia sẻ bài viết">
                            <NfIcon Name="share" Size="17" />
                        </button>
                    </div>
                </div>

                @* Comments *@
                <section style="margin-top:clamp(3rem,6vw,4.5rem)">
                    <h2>Bình luận (@_article.Comments.Length)</h2>

                    <div class="reviews__form" style="margin-top:1.75rem">
                        <label class="sr-only" for="comment">Bình luận của bạn</label>
                        <textarea id="comment" rows="4" class="nf-field"
                                  placeholder="Chia sẻ suy nghĩ của bạn về bài viết này..."></textarea>
                        <div style="display:flex;justify-content:flex-end;margin-top:1rem">
                            <button type="button" class="btn"><span>Gửi bình luận</span></button>
                        </div>
                    </div>

                    @if (_article.Comments.Length == 0)
                    {
                        <p class="muted" style="margin-top:1.75rem">
                            Chưa có bình luận nào. Hãy là người đầu tiên chia sẻ cảm nhận.
                        </p>
                    }
                    else
                    {
                        <div class="apage__comments" style="margin-top:1.75rem">
                            @foreach (var comment in _article.Comments)
                            {
                                <div class="apage__comment">
                                    <span class="apage__comment-avatar" aria-hidden="true">@comment.Initials</span>
                                    <div>
                                        <div style="display:flex;flex-wrap:wrap;align-items:baseline;gap:.6rem;margin-bottom:.3rem">
                                            <span style="font-weight:600">@comment.Name</span>
                                            <span class="muted" style="font-size:var(--fs-xs)">@comment.Ago</span>
                                        </div>
                                        <p class="muted" style="font-size:var(--fs-sm)">@comment.Text</p>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </article>

            @* Sidebar *@
            <aside class="apage__sidebar">

                @if (_related.Count > 0)
                {
                    <div class="apage__side-card">
                        <h2>Bài viết liên quan</h2>
                        <ul class="apage__side-list">
                            @foreach (var related in _related)
                            {
                                <li class="apage__side-item">
                                    <a href="@related.Url" style="display:contents">
                                        <span class="apage__side-thumb">
                                            <img src="@related.ImageUrl" alt="@related.ImageAlt" />
                                        </span>
                                        <span>
                                            <span style="display:block;font-weight:600;line-height:1.35;margin-bottom:.35rem">
                                                @related.Title
                                            </span>
                                            <span class="muted" style="font-size:var(--fs-xs)">
                                                @related.PublishedOn.ToString("dd/MM/yyyy")
                                            </span>
                                        </span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                    <hr class="hairline" />
                }

                <div class="apage__side-card">
                    <h2>Sản phẩm nổi bật</h2>
                    <ul class="apage__side-list">
                        @foreach (var product in SiteContent.ArticleSidebarProducts)
                        {
                            <li class="apage__side-item">
                                <a href="@($"/san-pham/{product.Slug}")" style="display:contents">
                                    <span class="apage__side-thumb">
                                        <img src="@product.ImageUrl" alt="@product.ImageAlt" />
                                    </span>
                                    <span>
                                        <span style="display:block;font-weight:600;margin-bottom:.35rem">@product.Name</span>
                                        <span style="display:block;font-weight:700;margin-bottom:.35rem">@Money.Vnd(product.Price)</span>
                                        <span class="linkline" style="font-size:var(--fs-xs)">
                                            Xem chi tiết <NfIcon Name="arrow-right" Size="13" />
                                        </span>
                                    </span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
                <hr class="hairline" />

                <div class="cupout" style="padding:clamp(1.75rem,4vw,2.5rem);text-align:left">
                    <div class="cupout__glow" aria-hidden="true"></div>
                    <h2 style="font-size:var(--fs-h3)">Khám phá dòng sản phẩm Specialty</h2>
                    <p style="margin:.85rem 0 1.5rem;margin-inline:0">
                        Trải nghiệm những hạt cà phê được tuyển chọn khắt khe nhất từ các vùng trồng nổi tiếng.
                    </p>
                    <a class="btn btn--red btn--block" href="/cua-hang"><span>Xem sản phẩm</span></a>
                </div>
            </aside>
        </div>
    </section>
}

@code {
    [Parameter]
    public string? Slug { get; set; }

    private SiteContent.Article? _article;
    private List<SiteContent.Article> _related = [];

    protected override void OnParametersSet()
    {
        _article = SiteContent.Articles.FirstOrDefault(a =>
            string.Equals(a.Slug, Slug, StringComparison.OrdinalIgnoreCase));

        if (_article is null)
        {
            // Render the 404 page with a real 404 status rather than an empty article shell.
            Navigation.NotFound();
            return;
        }

        _related = SiteContent.RelatedArticles(_article).ToList();
    }
}
