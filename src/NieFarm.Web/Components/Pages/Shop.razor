@page "/cua-hang"
@using System.Globalization
@using NieFarm.Application.Features.Products.Dtos
@using NieFarm.Application.Features.Products.Queries
@inject ISender Sender

@*
    Full markup rewrite from docs/design-preview/cua-hang.html
    (docs/plans/public-site-redesign-nf2.md §7, step 2.6). The whole @code block is unchanged:
    SortOptions, _selectedCategoryIds, _sort, the Task.WhenAll parallel read, ClearFiltersAsync,
    ReloadProductsAsync, _loading. _selectedCategoryIds stays a multi-select HashSet<int> — the
    prototype's chip group is single-select, but GetShopProductsQuery takes an array, so narrowing
    to single-select would be a silent behaviour regression (plan §2.3/§10 decision 3). ToggleCategory
    is adapted from a checkbox's ChangeEventArgs to a plain int parameter since a <button> chip
    supplies neither — the add-if-absent/remove-if-present toggle semantics are unchanged.
    Ratings, old price and category counts are omitted: ProductCardDto/ProductCategoryFilterDto
    carry none of them (plan §2.3). The dead 1-page pagination <nav> is deleted outright; the count
    line is now honest ("Hiển thị N sản phẩm"). The inert "Thêm vào giỏ" button is replaced by
    ".pcard__quick" ("Xem chi tiết →"), which needs no product decision (D11 stays open).
*@

<PageTitle>Cửa hàng - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="description"
          content="Bộ sưu tập cà phê hạt rang mộc nguyên bản và dụng cụ pha chế chuyên dụng của Nie Farm, tuyển chọn từ nông trại đến tách cà phê của bạn." />
</HeadContent>

<section class="shophead">
    <div class="shell shophead__row">
        <div>
            <p class="eyebrow" data-reveal="fade">Cửa hàng</p>
            <h1 data-reveal style="--d:.06s">Cà phê <span class="accent">đang có sẵn</span></h1>
        </div>
        <p class="muted" data-reveal="fade" style="--d:.12s;font-size:.9375rem;max-width:34ch">
            Khám phá bộ sưu tập cà phê hạt rang mộc nguyên bản và dụng cụ pha chế chuyên dụng, tuyển
            chọn kỹ lưỡng từ nông trại đến tách cà phê của bạn.
        </p>
    </div>
</section>

@if (_categories.Count > 0)
{
    <div class="filterbar">
        <div class="shell filterbar__in">
            <div class="chips" role="group" aria-label="Danh mục">
                <button type="button" class="chip" aria-pressed="@(_selectedCategoryIds.Count == 0 ? "true" : "false")"
                        @onclick="ClearFiltersAsync">
                    Tất cả
                </button>
                @foreach (var category in _categories)
                {
                    var categoryId = category.Id;
                    <button type="button" class="chip" aria-pressed="@(_selectedCategoryIds.Contains(categoryId) ? "true" : "false")"
                            @onclick="() => ToggleCategory(categoryId)">
                        @category.Name
                    </button>
                }
            </div>
            <label class="sortwrap">
                Sắp xếp
                <select @bind="_sort" @bind:after="ReloadProductsAsync">
                    @foreach (var option in SortOptions)
                    {
                        <option value="@option.Value">@option.Label</option>
                    }
                </select>
            </label>
        </div>
    </div>
}

<section style="padding-bottom:clamp(3rem,7vw,6rem)">
    <div class="shell">
        @if (_products.Count == 0)
        {
            <div style="text-align:center;padding-block:4rem;border-top:1px solid var(--line)">
                <p class="muted" style="margin-bottom:1.5rem">Không tìm thấy sản phẩm phù hợp với bộ lọc.</p>
                <button type="button" class="btn btn--ghost" @onclick="ClearFiltersAsync"><span>Xóa bộ lọc</span></button>
            </div>
        }
        else
        {
            <p class="muted" style="font-size:.875rem;margin-bottom:1.5rem">Hiển thị @_products.Count sản phẩm</p>

            <div class="grid-products">
                @for (var i = 0; i < _products.Count; i++)
                {
                    var product = _products[i];
                    var delay = (i % 3) * 0.06;

                    <article class="pcard" data-reveal style="--d:@(delay.ToString("0.00", CultureInfo.InvariantCulture))s">
                        <a class="pcard__media" href="@($"/san-pham/{product.Slug}")">
                            @if (product.Badge is not null)
                            {
                                <span class="pcard__tag pcard__tag--new">@product.Badge</span>
                            }
                            <img src="@product.ImageUrl" alt="@product.ImageAlt" />
                            <span class="pcard__quick">
                                Xem chi tiết <i><NfIcon Name="arrow-right" Size="13" /></i>
                            </span>
                        </a>
                        <div class="pcard__body">
                            <p class="pcard__cat">@product.CategoryName</p>
                            <h3 class="pcard__name"><a href="@($"/san-pham/{product.Slug}")">@product.Name</a></h3>
                            <div class="pcard__foot">
                                <span class="pcard__price">@Money.Vnd(product.Price)</span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@* Editorial strip: quietly sells the process instead of shouting a banner —
   ported verbatim from docs/design-preview/cua-hang.html:230-257. *@
<section class="section" style="padding-block:0">
    <div class="shell">
        <hr class="hairline" />
        <div style="display:grid;gap:2rem;padding-block:clamp(3rem,6vw,5rem);grid-template-columns:repeat(auto-fit,minmax(220px,1fr))">
            <div data-reveal="fade">
                <svg class="ico draw" width="30" height="30" viewBox="0 0 48 48" style="color:var(--green)"><path d="M24 6l15 5v11c0 10-6 17-15 21-9-4-15-11-15-21V11l15-5Z"/><path d="M18 28c0-6 5-10 12-10 0 7-5 11-12 10Z"/></svg>
                <h3 style="margin:1rem 0 .5rem">Canh tác hữu cơ</h3>
                <p class="muted" style="font-size:.9375rem">Không thuốc diệt cỏ, không phân bón tổng hợp trong suốt chu kỳ cây.</p>
            </div>
            <div data-reveal="fade" style="--d:.08s">
                <svg class="ico draw" width="30" height="30" viewBox="0 0 48 48" style="color:var(--green)"><path d="M24 16a13 13 0 1 0 0 26 13 13 0 0 0 0-26Z"/><path d="M18 29c4-4 8 4 12 0"/><path d="M24 3c-2 3.5 2 4.5 0 8"/></svg>
                <h3 style="margin:1rem 0 .5rem">Rang theo mẻ nhỏ</h3>
                <p class="muted" style="font-size:.9375rem">Ngày rang in trên túi. Giao trong 48 giờ kể từ khi ra lò.</p>
            </div>
            <div data-reveal="fade" style="--d:.16s">
                <svg class="ico draw" width="30" height="30" viewBox="0 0 48 48" style="color:var(--green)"><path d="M8 14h24l-2 20a4 4 0 0 1-4 3.5H14A4 4 0 0 1 10 34L8 14Z"/><path d="M32 18h4a6 6 0 0 1 0 12h-3"/></svg>
                <h3 style="margin:1rem 0 .5rem">Truy xuất từng lô</h3>
                <p class="muted" style="font-size:.9375rem">Mã lô trên bao bì dẫn ngược về đúng vườn và mẻ rang.</p>
            </div>
            <div data-reveal="fade" style="--d:.24s">
                <a class="linkline" href="/quy-trinh">
                    Xem toàn bộ quy trình <NfIcon Name="arrow-right" Size="15" />
                </a>
            </div>
        </div>
    </div>
</section>

@code {
    private static readonly (ShopSortOrder Value, string Label)[] SortOptions =
    [
        (ShopSortOrder.Newest, "Mới nhất"),
        (ShopSortOrder.PriceAscending, "Giá: Thấp đến Cao"),
        (ShopSortOrder.PriceDescending, "Giá: Cao đến Thấp")
    ];

    private readonly HashSet<int> _selectedCategoryIds = [];
    private ShopSortOrder _sort = ShopSortOrder.Newest;
    private IReadOnlyList<ProductCategoryFilterDto> _categories = [];
    private IReadOnlyList<ProductCardDto> _products = [];
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        // Safe to run in parallel — each IReadRepositoryBase handler gets its own DbContext
        // (data-access.md).
        var categoriesTask = Sender.Send(new GetShopCategoriesQuery());
        var productsTask = Sender.Send(new GetShopProductsQuery());
        await Task.WhenAll(categoriesTask, productsTask);

        _categories = await categoriesTask;
        _products = await productsTask;
    }

    /// <summary>Adds the category if absent, removes it if present — a <c>&lt;button&gt;</c> chip
    /// (unlike the old checkbox) supplies no <see cref="ChangeEventArgs"/>, so this reads current
    /// membership from <see cref="_selectedCategoryIds"/> instead of an event value.</summary>
    private async Task ToggleCategory(int categoryId)
    {
        if (!_selectedCategoryIds.Remove(categoryId))
        {
            _selectedCategoryIds.Add(categoryId);
        }

        await ReloadProductsAsync();
    }

    private async Task ClearFiltersAsync()
    {
        _selectedCategoryIds.Clear();
        await ReloadProductsAsync();
    }

    private async Task ReloadProductsAsync()
    {
        if (_loading)
            return;

        _loading = true;
        try
        {
            _products = await Sender.Send(new GetShopProductsQuery(_selectedCategoryIds.ToArray(), _sort));
        }
        finally
        {
            _loading = false;
        }
    }
}
