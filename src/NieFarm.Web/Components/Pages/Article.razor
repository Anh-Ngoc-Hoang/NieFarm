@page "/kien-thuc"

@*
    Full markup rewrite onto the NieFarm 2.0 design language (docs/plans/public-site-redesign-nf2.md
    §7, step 3.2). @code is unchanged (_query/_category client-side filtering over SiteContent.Articles).
    Header reuses the ".shophead" vocabulary from Shop.razor; search input -> ".nf-field"; category
    <select> -> ".sortwrap select" (same pattern as Shop's sort control). Cards -> the new ".acard"
    (nf-pages.css) — 16:9 media, category eyebrow, date, ".linkline". The grid container reuses
    ".grid-products" (already shared by Shop and PDP's related-products band; extended here to a
    third listing grid rather than duplicating the same responsive column rules under a new name).
*@

<PageTitle>Kiến thức cà phê - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="description"
          content="Câu chuyện từ nông trại, kiến thức pha chế chuyên sâu và xu hướng thưởng thức cà phê mới nhất từ Nie Farm Việt Nam." />
</HeadContent>

<section class="shophead">
    <div class="shell shophead__row">
        <div>
            <p class="eyebrow" data-reveal="fade">Kiến thức cà phê</p>
            <h1 data-reveal style="--d:.06s">Khám phá <span class="accent">thế giới cà phê</span></h1>
        </div>
        <p class="muted" data-reveal="fade" style="--d:.12s;font-size:.9375rem;max-width:34ch">
            Những câu chuyện từ nông trại, kiến thức pha chế chuyên sâu và xu hướng thưởng thức mới
            nhất dành cho những tâm hồn yêu cà phê.
        </p>
    </div>
</section>

<section style="padding-bottom:clamp(2rem,4vw,3rem)">
    <div class="shell" style="display:flex;flex-wrap:wrap;gap:1rem;align-items:center;justify-content:space-between">
        <div style="position:relative;flex:1 1 320px;max-width:420px">
            <label class="sr-only" for="article-search">Tìm kiếm bài viết</label>
            <span style="position:absolute;left:1rem;top:50%;translate:0 -50%;color:var(--ink-38)" aria-hidden="true">
                <NfIcon Name="search" Size="17" />
            </span>
            <input id="article-search" type="search" class="nf-field" style="padding-left:2.75rem"
                   placeholder="Tìm kiếm bài viết..." @bind="_query" @bind:event="oninput" />
        </div>
        <label class="sortwrap">
            Danh mục
            <select @bind="_category">
                <option value="">Tất cả danh mục</option>
                @foreach (var category in SiteContent.ArticleCategories)
                {
                    <option value="@category">@category</option>
                }
            </select>
        </label>
    </div>
</section>

<section style="padding-bottom:clamp(3rem,7vw,6rem)">
    <div class="shell">
        @if (FilteredArticles.Any())
        {
            <div class="grid-products">
                @foreach (var article in FilteredArticles)
                {
                    <article class="acard" data-reveal="fade">
                        <a class="acard__media" href="@article.Url">
                            <img src="@article.ImageUrl" alt="@article.ImageAlt" />
                        </a>
                        <div class="acard__body">
                            <div class="acard__meta">
                                <span class="acard__cat">@article.Category</span>
                                <span>@article.PublishedOn.ToString("dd/MM/yyyy")</span>
                            </div>
                            <h2 class="acard__title"><a href="@article.Url">@article.Title</a></h2>
                            <p class="acard__summary">@article.Summary</p>
                            <a class="linkline" href="@article.Url">
                                Đọc tiếp <NfIcon Name="arrow-right" Size="15" />
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
        else
        {
            <p class="muted" style="text-align:center;padding-block:4rem">
                Không tìm thấy bài viết phù hợp. Thử từ khóa khác hoặc chọn danh mục "Tất cả".
            </p>
        }
    </div>
</section>

@code {
    private string _query = string.Empty;
    private string _category = string.Empty;

    // Client-side filtering over fixture data; the real listing becomes a paged query.
    private IEnumerable<SiteContent.Article> FilteredArticles =>
        SiteContent.Articles.Where(a =>
            (string.IsNullOrWhiteSpace(_category) || a.Category == _category)
            && (string.IsNullOrWhiteSpace(_query)
                || a.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)
                || a.Summary.Contains(_query, StringComparison.OrdinalIgnoreCase)));
}
