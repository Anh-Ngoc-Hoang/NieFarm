@page "/san-pham/{Slug}"
@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using NieFarm.Application.Features.Carts
@using NieFarm.Application.Features.Carts.Commands
@using NieFarm.Application.Features.Products.Dtos
@using NieFarm.Application.Features.Products.Queries
@using NieFarm.Application.Features.Reviews.Commands
@using NieFarm.Application.Features.Reviews.Dtos
@using NieFarm.Application.Features.Reviews.Queries
@using NieFarm.Domain.Entities
@using NieFarm.Web.Services.Cart
@inject ISender Sender
@inject NavigationManager Navigation
@inject CartState CartState

@*
    Full markup rewrite from docs/design-preview/san-pham.html
    (docs/plans/public-site-redesign-nf2.md §7, step 2.7). Markup only — every piece of @code below
    (LoadProductAndReviewsAsync, SelectOptionValue, AddToCartAsync, ClampQuantity, LoadReviewsAsync,
    HandleSubmitAsync, CancelEdit, FocusEditFormAsync, _commentTextarea, _selectedImage, _quantity,
    _activeTab) is unchanged, and Navigation.NotFound() for an unresolved slug is kept.

    Tabs shrinks from 3 (desc/specs/reviews) to 3 informational ones (desc/specs/shipping) that
    become the prototype's ".acc" accordion — is-open is driven by _activeTab (reused, not a new
    field) rather than JS, per plan §6's "never re-implement toggle groups in JS" rule. The shipping
    panel's copy is generic policy text (free shipping threshold, storage advice), not a per-product
    field — same reasoning as the ".assure" list only ever showing the two generic assurances, never
    a roast date or lot number the DTO doesn't carry (plan §2.3).

    Reviews has validation, an edit mode and an ElementReference focus call, so it is lifted into its
    own full-width ".reviews" section below the accordion instead of becoming a fourth accordion item
    (plan §7/§10 decision 2) — nf-pages.css's Product-detail block has its CSS since the prototype has
    no reviews UI to port. StarRating -> NfStars on this page.
*@

@if (_product is not null)
{
    <PageTitle>@_product.Name - Nie Farm Việt Nam</PageTitle>
    <HeadContent>
        <meta name="description" content="@_product.SummaryPlainText" />
    </HeadContent>

    <div class="pdp">
        <div class="shell">
            <nav class="crumbs" aria-label="Đường dẫn">
                <a href="/">Trang chủ</a> <span>/</span>
                <a href="/cua-hang">Cửa hàng</a> <span>/</span>
                <span style="color:var(--ink-70)">@_product.Name</span>
            </nav>

            <div class="pdp__grid">

                @* Gallery *@
                <div data-reveal="fade">
                    <div class="gallery">
                        <div class="gallery__main">
                            @if (SelectedGalleryImage is { } main)
                            {
                                <img src="@main.Url" alt="@main.Alt" />
                            }
                        </div>
                        @if (_product.Gallery.Count > 1)
                        {
                            <div class="gallery__thumbs">
                                @for (var i = 0; i < _product.Gallery.Count; i++)
                                {
                                    var index = i;
                                    var image = _product.Gallery[index];
                                    var selected = index == _selectedImage;

                                    <button type="button" @onclick="() => _selectedImage = index"
                                            aria-current="@(selected ? "true" : "false")"
                                            aria-label="@($"Ảnh {index + 1}")">
                                        <img src="@image.Url" alt="" />
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* Buy column *@
                <div data-reveal="right">
                    <p class="eyebrow">
                        @_product.CategoryName@(_product.Badge is not null ? $" · {_product.Badge}" : "")
                    </p>
                    <h1 style="font-size:clamp(1.9rem,3.4vw,2.9rem);margin-top:.9rem">@_product.Name</h1>

                    <div class="pdp__rating">
                        <NfStars Value="@_reviews.AverageRating" Size="16" />
                        @if (_reviews.ApprovedCount > 0)
                        {
                            <span>@_reviews.AverageRating.ToString("0.0", Vietnamese) · @_reviews.ApprovedCount đánh giá</span>
                        }
                        else
                        {
                            <span>Chưa có đánh giá</span>
                        }
                    </div>

                    @if (!string.IsNullOrWhiteSpace(_product.SummaryHtml))
                    {
                        <div class="rich-text-content" style="margin-top:1.25rem">
                            @((MarkupString)_product.SummaryHtml)
                        </div>
                    }

                    <div class="pdp__price">
                        <b>@Money.Vnd(_product.PriceFor(_selectedOptionValues))</b>
                        @if (_product.OldPrice is { } old)
                        {
                            <s>@Money.Vnd(old)</s>
                        }
                    </div>

                    @if (_product.Options.Count > 0)
                    {
                        @for (var i = 0; i < _product.Options.Count; i++)
                        {
                            var optionIndex = i;
                            var option = _product.Options[optionIndex];

                            <div class="optgroup">
                                <div class="optgroup__label"><span>@option.Name</span></div>
                                <div class="opts">
                                    @foreach (var value in option.Values)
                                    {
                                        var current = value;
                                        var selected = current == _selectedOptionValues[optionIndex];

                                        <button type="button" class="opt" aria-pressed="@(selected ? "true" : "false")"
                                                @onclick="() => SelectOptionValue(optionIndex, current)">
                                            @current
                                        </button>
                                    }
                                </div>
                            </div>
                        }

                        @if (IsOutOfStock)
                        {
                            <p style="color:var(--red);font-weight:600;font-size:var(--fs-sm);margin-top:.75rem">Tạm hết hàng</p>
                        }
                    }

                    @if (_cartErrors.Count > 0)
                    {
                        <div class="alert alert--error" role="alert" style="margin-top:1.5rem">
                            @foreach (var error in _cartErrors)
                            {
                                <p>@error</p>
                            }
                        </div>
                    }

                    @if (_cartMessage is not null)
                    {
                        <div class="alert alert--ok" style="margin-top:1.5rem">
                            @_cartMessage
                            <a class="linkbtn" href="/thanh-toan">Xem giỏ hàng</a>
                        </div>
                    }

                    <div class="buyrow">
                        <div class="qty">
                            <button type="button" @onclick="() => _quantity = Math.Max(1, _quantity - 1)" aria-label="Giảm số lượng">
                                <NfIcon Name="minus" Size="16" />
                            </button>
                            <input type="number" min="1" max="@Cart.MaxQuantityPerItem" aria-label="Số lượng"
                                   @bind="_quantity" @bind:after="ClampQuantity" />
                            <button type="button" @onclick="() => _quantity = Math.Min(Cart.MaxQuantityPerItem, _quantity + 1)" aria-label="Tăng số lượng">
                                <NfIcon Name="plus" Size="16" />
                            </button>
                        </div>
                        <button type="button" class="btn btn--block" disabled="@(IsOutOfStock || _addingToCart)"
                                @onclick="() => AddToCartAsync(false)">
                            <span>@(_addingToCart ? "Đang thêm…" : "Thêm vào giỏ hàng")</span>
                        </button>
                    </div>
                    <button type="button" class="btn btn--ghost btn--block" style="margin-top:.6rem"
                            disabled="@(IsOutOfStock || _addingToCart)" @onclick="() => AddToCartAsync(true)">
                        <span>@(_addingToCart ? "Đang thêm…" : "Mua ngay")</span>
                    </button>

                    @if (_product.Features.Count > 0)
                    {
                        <ul class="pdp__features">
                            @foreach (var feature in _product.Features)
                            {
                                <li><NfIcon Name="check" /> @feature</li>
                            }
                        </ul>
                    }

                    <div class="assure">
                        <ul>
                            <li><NfIcon Name="truck" /> Giao hàng toàn quốc</li>
                            <li><NfIcon Name="shield" /> 100% cà phê nguyên chất</li>
                        </ul>
                    </div>
                </div>
            </div>

            @* Information accordion — Mô tả / Thông số / Vận chuyển & bảo quản *@
            <div style="max-width:760px;margin-top:clamp(3.5rem,7vw,6rem)" data-reveal="fade">
                <div class="acc">
                    @foreach (var tab in Tabs)
                    {
                        var current = tab;
                        var open = current.Id == _activeTab;

                        <div class="acc__item @(open ? "is-open" : null)">
                            <button type="button" class="acc__btn" id="@($"acc-btn-{current.Id}")"
                                    aria-expanded="@(open ? "true" : "false")" aria-controls="@($"acc-panel-{current.Id}")"
                                    @onclick="() => _activeTab = current.Id">
                                @current.Label <i><NfIcon Name="plus" Size="17" /></i>
                            </button>
                            <div class="acc__panel" id="@($"acc-panel-{current.Id}")" role="region" aria-labelledby="@($"acc-btn-{current.Id}")">
                                <div>
                                    @if (current.Id == "desc")
                                    {
                                        @if (string.IsNullOrWhiteSpace(_product.DescriptionHtml))
                                        {
                                            <p>Thông tin chi tiết đang được cập nhật.</p>
                                        }
                                        else
                                        {
                                            <div class="rich-text-content">@((MarkupString)_product.DescriptionHtml)</div>
                                        }
                                    }
                                    else if (current.Id == "specs")
                                    {
                                        @if (_product.Specs.Count == 0)
                                        {
                                            <p>Thông số kỹ thuật đang được cập nhật.</p>
                                        }
                                        else
                                        {
                                            <dl>
                                                @foreach (var spec in _product.Specs)
                                                {
                                                    <dt>@spec.Label</dt>
                                                    <dd>@spec.Value</dd>
                                                }
                                            </dl>
                                        }
                                    }
                                    else
                                    {
                                        @* Quoted from CartPricing so the page can never promise a
                                           shipping term that /thanh-toan then contradicts. *@
                                        <p>
                                            Phí giao hàng @Money.Vnd(CartPricing.ShippingFee) cho mọi đơn hàng, giao toàn quốc.
                                            Bảo quản nơi khô ráo, tránh ánh nắng trực tiếp; sau khi mở túi nên dùng hết trong
                                            3–4 tuần và luôn đóng kín van một chiều.
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            @* Reviews — full-width section, not an accordion panel (see block comment above). *@
            <section class="reviews" data-reveal="fade">
                <h2>Đánh giá từ khách hàng</h2>

                @if (_reviews.ApprovedCount > 0)
                {
                    <div class="reviews__summary">
                        <b>@_reviews.AverageRating.ToString("0.0", Vietnamese)</b>
                        <div>
                            <NfStars Value="@_reviews.AverageRating" Size="18" />
                            <p>@_reviews.ApprovedCount đánh giá</p>
                        </div>
                    </div>
                }
                else
                {
                    <p class="muted" style="margin:1.5rem 0 2rem">Chưa có đánh giá nào cho sản phẩm này.</p>
                }

                @if (_productId is not null)
                {
                    <AuthorizeView>
                        <Authorized>
                            <div class="reviews__form">
                                <h3>@(_editingReviewId is null ? "Viết đánh giá của bạn" : "Chỉnh sửa đánh giá của bạn")</h3>

                                @if (_errors.Count > 0)
                                {
                                    <div class="alert alert--error" role="alert" style="margin-bottom:1rem">
                                        @foreach (var error in _errors)
                                        {
                                            <p>@error</p>
                                        }
                                    </div>
                                }

                                @if (_successMessage is not null)
                                {
                                    <div class="alert alert--ok" style="margin-bottom:1rem">@_successMessage</div>
                                }

                                <StarRatingInput Value="@_rating" ValueChanged="v => _rating = v" Disabled="@_submitting" />

                                <textarea @ref="_commentTextarea" class="nf-field" style="margin-top:1rem"
                                          rows="4" maxlength="@Review.CommentMaxLength"
                                          placeholder="Chia sẻ cảm nhận của bạn về sản phẩm…"
                                          disabled="@_submitting"
                                          value="@_comment"
                                          @oninput="e => _comment = e.Value?.ToString() ?? string.Empty"></textarea>
                                <p class="reviews__count">@_comment.Length / @Review.CommentMaxLength</p>

                                <div class="reviews__form-actions">
                                    <button type="button" class="btn btn--red" disabled="@_submitting" @onclick="HandleSubmitAsync">
                                        <span>@(_submitting ? "Đang xử lý…" : _editingReviewId is null ? "Gửi đánh giá" : "Cập nhật đánh giá")</span>
                                    </button>
                                    @if (_editingReviewId is not null)
                                    {
                                        <button type="button" class="btn btn--ghost" disabled="@_submitting" @onclick="CancelEdit">
                                            <span>Hủy thay đổi</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <p class="muted" style="margin:1.5rem 0 2rem">
                                <a class="linkbtn" href="@($"/dang-nhap?returnUrl=/san-pham/{Slug}")">Vui lòng đăng nhập</a>
                                để gửi đánh giá.
                            </p>
                        </NotAuthorized>
                    </AuthorizeView>
                }

                @if (_reviews.Reviews.Count > 0)
                {
                    <div class="reviews__list">
                        @foreach (var review in _reviews.Reviews)
                        {
                            <article class="review">
                                <div class="review__head">
                                    <span class="review__author">@review.AuthorName</span>
                                    <span class="review__date">@review.CreatedAt.ToString("dd/MM/yyyy", Vietnamese)</span>
                                </div>
                                <div class="review__rating">
                                    <NfStars Value="@review.Rating" Size="14" />
                                    @if (review.IsPending)
                                    {
                                        <span class="badge-pending">Đang chờ duyệt</span>
                                        <button type="button" class="linkbtn" @onclick="() => FocusEditFormAsync(review)">Sửa đánh giá</button>
                                    }
                                </div>
                                @if (review.IsPending)
                                {
                                    <p class="review__hint">Người khác sẽ thấy được đánh giá này khi được duyệt.</p>
                                }
                                <p class="review__body">@review.Comment</p>
                            </article>
                        }
                    </div>
                }
            </section>

            @* Related products *@
            @if (_relatedProducts is { Count: > 0 })
            {
                <section style="margin-top:clamp(4rem,8vw,7rem)">
                    <div style="display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:2rem">
                        <h2 data-reveal="fade">Sản phẩm liên quan</h2>
                        <a class="linkline" href="/cua-hang" data-reveal="fade">
                            Xem tất cả <NfIcon Name="arrow-right" Size="15" />
                        </a>
                    </div>
                    <div class="grid-products">
                        @for (var i = 0; i < _relatedProducts.Count; i++)
                        {
                            var related = _relatedProducts[i];
                            var delay = (i % 3) * 0.06;

                            <ProductCard @key="related.Id" Product="related" Delay="delay" ShowQuickView="false" />
                        }
                    </div>
                </section>
            }
        </div>
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo Vietnamese =
        System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

    private sealed record Tab(string Id, string Label);

    private static readonly Tab[] Tabs =
    [
        new("desc", "Mô tả"),
        new("specs", "Thông số"),
        new("shipping", "Vận chuyển & bảo quản")
    ];

    /// <summary>Route slug.</summary>
    [Parameter]
    public string? Slug { get; set; }

    [CascadingParameter(Name = "CartAnonymousId")] public string? CartAnonymousId { get; set; }

    private ProductDetailDto? _product;

    private int _selectedImage;
    private string[] _selectedOptionValues = [];
    private int _quantity = 1;
    private string _activeTab = "desc";

    // -- Add to cart ---------------------------------------------------------
    // Deliberately separate from the review form's _errors / _successMessage: those live in
    // the reviews section and are reset by LoadReviewsAsync, so reusing them would make a
    // cart error appear inside the review box.
    private bool _addingToCart;
    private List<string> _cartErrors = [];
    private string? _cartMessage;

    private ProductImageDto? SelectedGalleryImage =>
        _product is null || _product.Gallery.Count == 0
            ? null
            : _product.Gallery[Math.Clamp(_selectedImage, 0, _product.Gallery.Count - 1)];

    private ProductVariantDto? SelectedVariant => _product?.FindVariant(_selectedOptionValues);

    private bool IsOutOfStock => SelectedVariant is { IsAvailable: false };

    // -- Reviews -----------------------------------------------------------

    private static readonly ProductReviewsDto EmptyReviews = new(0, 0, []);

    private string? _loadedSlug;
    private int? _productId;
    private ProductReviewsDto _reviews = EmptyReviews;
    private IReadOnlyList<ProductCardDto>? _relatedProducts;

    private int? _editingReviewId;
    private int _rating;
    private string _comment = string.Empty;
    private bool _submitting;
    private List<string> _errors = [];
    private string? _successMessage;
    private ElementReference _commentTextarea;

    protected override Task OnParametersSetAsync()
    {
        if (Slug == _loadedSlug)
            return Task.CompletedTask;

        _loadedSlug = Slug;
        return LoadProductAndReviewsAsync();
    }

    private async Task LoadProductAndReviewsAsync()
    {
        _product = await Sender.Send(new GetProductDetailQuery(Slug ?? string.Empty));

        if (_product is null)
        {
            _productId = null;
            _reviews = EmptyReviews;
            _relatedProducts = null;

            // Render the 404 page with a real 404 status rather than an empty product shell.
            Navigation.NotFound();
            return;
        }

        _productId = _product.Id;

        // Independent reads — safe to run in parallel (data-access.md).
        var reviewsTask = LoadReviewsAsync(_productId.Value);
        var relatedTask = Sender.Send(new GetRelatedProductsQuery(_productId.Value));
        await Task.WhenAll(reviewsTask, relatedTask);
        _relatedProducts = relatedTask.Result;

        // Reset per-product interactive state — Blazor reuses the component instance across
        // /san-pham/a -> /san-pham/b navigations, and stale state (e.g. _selectedImage) can
        // index past a shorter gallery on the new product.
        _selectedImage = 0;
        _activeTab = "desc";
        _quantity = 1;
        _selectedOptionValues = _product.Options.Select(o => o.Values.FirstOrDefault() ?? string.Empty).ToArray();
        _cartErrors = [];
        _cartMessage = null;
        _addingToCart = false;
    }

    private void SelectOptionValue(int optionIndex, string value)
    {
        if (optionIndex < 0 || optionIndex >= _selectedOptionValues.Length)
            return;

        _selectedOptionValues[optionIndex] = value;
    }

    private void ClampQuantity() => _quantity = Math.Clamp(_quantity, 1, Cart.MaxQuantityPerItem);

    private async Task AddToCartAsync(bool buyNow)
    {
        if (_product is null || _addingToCart) return;

        _addingToCart = true;
        _cartErrors = [];
        _cartMessage = null;

        try
        {
            // Copy: _selectedOptionValues is mutated in place by SelectOptionValue.
            var selection = _selectedOptionValues.ToArray();
            var quantity = Math.Clamp(_quantity, 1, Cart.MaxQuantityPerItem);

            var result = await Sender.Send(
                new AddToCartCommand(_product.Id, selection, quantity, CartAnonymousId));

            if (result.IsSuccess)
            {
                CartState.Set(result.Value.ItemCount);   // header badge, no extra round trip

                if (buyNow)
                {
                    Navigation.NavigateTo("/thanh-toan");
                    return;                               // leave _addingToCart true; navigating away
                }

                _cartMessage = "Đã thêm sản phẩm vào giỏ hàng.";
            }
            else
            {
                _cartErrors = CollectErrors(result.ValidationErrors, result.Errors,
                                            "Không thể thêm vào giỏ hàng.");
            }
        }
        finally
        {
            if (!buyNow || _cartErrors.Count > 0) _addingToCart = false;
        }
    }

    private async Task LoadReviewsAsync(int productId)
    {
        _reviews = await Sender.Send(new GetProductReviewsQuery(productId));

        // D5 guarantees at most one pending review per (author, product), so the form is
        // always in exactly one of two states, derived from the data rather than a click.
        var pending = _reviews.Reviews.FirstOrDefault(r => r.IsPending);
        if (pending is not null)
        {
            _editingReviewId = pending.Id;
            _rating = pending.Rating;
            _comment = pending.Comment;
        }
        else
        {
            _editingReviewId = null;
            _rating = 0;
            _comment = string.Empty;
        }
    }

    private async Task HandleSubmitAsync()
    {
        if (_productId is not { } productId)
            return;

        _submitting = true;
        _errors = [];
        _successMessage = null;

        try
        {
            if (_editingReviewId is { } reviewId)
            {
                var result = await Sender.Send(new EditProductReviewCommand(reviewId, _rating, _comment));
                if (result.IsSuccess)
                    _successMessage = "Đã cập nhật đánh giá. Đánh giá của bạn vẫn đang chờ duyệt.";
                else
                    _errors = CollectErrors(result.ValidationErrors, result.Errors, "Không thể cập nhật đánh giá.");
            }
            else
            {
                var result = await Sender.Send(new SubmitProductReviewCommand(productId, _rating, _comment));
                if (result.IsSuccess)
                    _successMessage = "Cảm ơn bạn! Đánh giá của bạn đang chờ duyệt.";
                else
                    _errors = CollectErrors(result.ValidationErrors, result.Errors, "Không thể gửi đánh giá.");
            }

            // Sequential, never Task.WhenAll. Re-running re-derives the edit state, so a race
            // where the review was moderated (or already has a pending row) between render and
            // submit self-corrects here rather than leaving the form stuck on stale state.
            await LoadReviewsAsync(productId);
        }
        finally
        {
            _submitting = false;
        }
    }

    /// <summary>Discards unsaved edits; does not leave edit mode — with a pending review there is no other mode to be in.</summary>
    private void CancelEdit()
    {
        if (_editingReviewId is { } id)
        {
            var pending = _reviews.Reviews.FirstOrDefault(r => r.Id == id);
            if (pending is not null)
            {
                _rating = pending.Rating;
                _comment = pending.Comment;
            }
        }

        _errors = [];
        _successMessage = null;
    }

    /// <summary>
    /// Scrolls/focuses the form instead of switching modes — the pending card's "Sửa đánh giá"
    /// affordance is pure discoverability, since the form is already in edit mode for this row.
    /// </summary>
    private async Task FocusEditFormAsync(ProductReviewDto review) => await _commentTextarea.FocusAsync();

    private static List<string> CollectErrors(
        IEnumerable<Ardalis.Result.ValidationError> validationErrors, IEnumerable<string> errors, string fallback) =>
        validationErrors.Select(e => e.ErrorMessage)
            .Concat(errors)
            .Where(m => !string.IsNullOrWhiteSpace(m))
            .DefaultIfEmpty(fallback)
            .ToList();
}
