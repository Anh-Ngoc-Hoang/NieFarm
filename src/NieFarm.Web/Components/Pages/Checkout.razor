@page "/thanh-toan"
@layout CheckoutLayout
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using NieFarm.Application.Features.Addresses.Dtos
@using NieFarm.Application.Features.Addresses.Queries
@using NieFarm.Application.Features.Carts.Commands
@using NieFarm.Application.Features.Carts.Dtos
@using NieFarm.Application.Features.Carts.Queries
@using NieFarm.Application.Features.Orders.Commands
@using NieFarm.Domain.Entities
@using NieFarm.Domain.Enums
@using NieFarm.Web.Services.Cart
@inject ISender Sender
@inject NavigationManager Navigation
@inject CartState CartState
@implements IDisposable

@*
    Markup-only rewrite onto NieFarm 2.0 (docs/plans/public-site-redesign-nf2.md
    §7, step 4.1) — every piece of @code below is unchanged: cart loading, address
    lookup/manual-entry fallback, payment method, CreateOrderCommand wiring, the
    unavailable-line / HasUnavailableLines gate, and the promo/total arithmetic
    (all server-authoritative — CartAssembler re-derives every amount from the
    Products table, see security.md). The only @code edit is cosmetic: the two
    PaymentOption.Icon strings move from Material Symbol names to NfIcon glyph
    names, the same swap SiteHeader/ProductDetail already made — nothing reads
    that string except this page's own markup.

    The stepper (CurrentStep, the Steps <ol>) is preserved exactly — it is the
    shopper's only "where am I" signal. Its Tailwind state classes become
    .nf-steps__dot--now/--done/--next and .nf-steps__bar--done/--todo
    (nf-pages.css). The three <section> cards lose their borders/shadows and
    become hairline-delimited ".checkout__section" bands in one column; the
    summary becomes a soft tint-warm panel, not a bordered card. Forms use
    .nf-field/.nf-label/.nf-row; the payment radio group keeps real
    <input type="radio"> under a new ".radio-card" hairline style. No
    data-reveal on any form content — only the page's own small heading, so a
    reveal glitch can never make a transactional field invisible.
*@

<PageTitle>Thanh toán - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="checkout">
    <div class="shell">

        <div style="text-align:center;margin-bottom:clamp(2rem,4vw,3rem)" data-reveal="fade">
            <p class="eyebrow eyebrow--plain" style="justify-content:center">Thanh toán</p>
            <h1 style="margin-top:.6rem;font-size:var(--fs-h2)">Hoàn tất đơn hàng của bạn</h1>
        </div>

        @* Stepper *@
        <ol class="nf-steps">
            @for (var i = 0; i < Steps.Length; i++)
            {
                var step = Steps[i];
                var state = i < CurrentStep ? "done" : i == CurrentStep ? "now" : "next";

                <li class="nf-steps__item">
                    <span class="nf-steps__dot nf-steps__dot--@state" aria-hidden="true">
                        @if (i < CurrentStep)
                        {
                            <NfIcon Name="check" Size="18" />
                        }
                        else
                        {
                            @(i + 1)
                        }
                    </span>
                    <span class="nf-steps__label @(i <= CurrentStep ? "nf-steps__label--active" : null)"
                          aria-current="@(i == CurrentStep ? "step" : null)">
                        @step
                    </span>
                </li>

                @if (i < Steps.Length - 1)
                {
                    <li class="nf-steps__bar @(i < CurrentStep ? "nf-steps__bar--done" : "nf-steps__bar--todo")" aria-hidden="true"></li>
                }
            }
        </ol>

        <div class="checkout__grid">

            @* Left: cart, address, payment *@
            <div>

                <section class="checkout__section">
                    <div style="display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:1.5rem">
                        <h2><NfIcon Name="cart" Size="20" /> Sản phẩm trong giỏ</h2>
                        <a class="linkline" href="/cua-hang">Tiếp tục mua sắm <NfIcon Name="arrow-right" Size="15" /></a>
                    </div>

                    @if (_lastRemoved is not null)
                    {
                        <div class="alert" style="background:var(--tint-warm);color:var(--ink-70);display:flex;justify-content:space-between;align-items:center;gap:1rem;margin-bottom:1.25rem">
                            <span>Đã xóa @_lastRemoved.Value.Name.</span>
                            <button type="button" class="linkbtn" @onclick="UndoRemoveAsync">Hoàn tác</button>
                        </div>
                    }

                    @if (_cartUnavailable)
                    {
                        <div class="alert alert--error" role="alert">
                            Trình duyệt đang chặn cookie nên giỏ hàng không thể được lưu. Vui lòng bật cookie hoặc
                            <a class="linkbtn" href="/dang-nhap?returnUrl=%2Fthanh-toan">đăng nhập</a>
                            để tiếp tục.
                        </div>
                    }
                    else if (_cart is null)
                    {
                        <div style="display:grid;gap:1rem">
                            @for (var i = 0; i < 2; i++)
                            {
                                <div style="height:6rem;border-radius:var(--r-sm);background:var(--tint)"></div>
                            }
                        </div>
                    }
                    else if (_cart.IsEmpty)
                    {
                        <div style="text-align:center;padding-block:3rem">
                            <NfIcon Name="cart" Size="40" CssClass="checkout__empty-icon" />
                            <p class="muted" style="margin:1rem 0 1.5rem">Giỏ hàng của bạn đang trống.</p>
                            <a class="btn" href="/cua-hang"><span>Tiếp tục mua sắm</span></a>
                        </div>
                    }
                    else
                    {
                        <ul style="list-style:none;margin:0;padding:0">
                            @foreach (var line in _cart.Lines)
                            {
                                <li class="checkout__cart-item @(line.IsAvailable ? null : "checkout__cart-item--unavailable")">
                                    <div class="checkout__cart-item-info">
                                        <div class="checkout__cart-item-media">
                                            <img src="@line.ImageUrl" alt="@line.ImageAlt" />
                                        </div>
                                        <div>
                                            <p class="checkout__cart-item-name">
                                                <a href="@($"/san-pham/{line.Slug}")">@line.Name</a>
                                            </p>
                                            @if (!string.IsNullOrWhiteSpace(line.Variant))
                                            {
                                                <p class="muted" style="font-size:var(--fs-xs);margin-top:.2rem">@line.Variant</p>
                                            }
                                            @if (!line.IsAvailable)
                                            {
                                                <span class="badge-error" style="margin-top:.35rem">Tạm hết hàng</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="checkout__cart-item-actions">
                                        <div class="qty">
                                            <button type="button" disabled="@(_updating || line.Quantity <= 1)"
                                                    @onclick="() => DecrementAsync(line)" aria-label="Giảm số lượng @line.Name">
                                                <NfIcon Name="minus" Size="15" />
                                            </button>
                                            <input type="number" min="1" max="99" value="@line.Quantity" disabled="@_updating"
                                                   aria-label="Số lượng @line.Name"
                                                   @onchange="e => OnQuantityInputAsync(line, e)" />
                                            <button type="button" disabled="@_updating"
                                                    @onclick="() => IncrementAsync(line)" aria-label="Tăng số lượng @line.Name">
                                                <NfIcon Name="plus" Size="15" />
                                            </button>
                                        </div>

                                        <div class="checkout__cart-item-price">
                                            <b>@Money.Vnd(line.LineTotal)</b>
                                            <span class="muted" style="font-size:var(--fs-xs)">@Money.Vnd(line.UnitPrice)/sp</span>
                                        </div>

                                        <button type="button" class="iconbtn checkout__remove" disabled="@_updating"
                                                @onclick="() => RemoveAsync(line)" aria-label="Xóa @line.Name khỏi giỏ hàng">
                                            <NfIcon Name="close" Size="17" />
                                        </button>
                                    </div>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <AuthorizeView>
                    <NotAuthorized>
                        <div class="alert checkout__note" style="background:var(--tint-warm);color:var(--ink-70);margin-bottom:1.5rem">
                            <NfIcon Name="user" Size="18" />
                            Đã có tài khoản?
                            <a class="linkbtn" href="/dang-nhap?returnUrl=%2Fthanh-toan">Đăng nhập</a>
                            để lưu đơn hàng vào tài khoản của bạn. Bạn vẫn có thể đặt hàng mà không cần tài khoản.
                        </div>
                    </NotAuthorized>
                </AuthorizeView>

                <section class="checkout__section">
                    <h2><NfIcon Name="location" Size="20" /> Địa chỉ nhận hàng</h2>

                    <div style="display:grid;gap:1.5rem">
                        <div class="nf-row nf-row--2">
                            <div>
                                <label class="nf-label" for="full-name">Họ và tên *</label>
                                <input id="full-name" type="text" placeholder="Nhập họ và tên" @bind="_fullName" class="nf-field" />
                            </div>
                            <div>
                                <label class="nf-label" for="phone">Số điện thoại *</label>
                                <input id="phone" type="tel" placeholder="Nhập số điện thoại" @bind="_phone" class="nf-field" />
                            </div>
                        </div>

                        <div>
                            <label class="nf-label" for="email">Email</label>
                            <input id="email" type="email" placeholder="Nhập email (để nhận hóa đơn)" @bind="_email" class="nf-field" />
                        </div>

                        @if (_addressLookupFailed)
                        {
                            <div class="nf-row nf-row--2">
                                <div>
                                    <label class="nf-label" for="province">Tỉnh / Thành phố *</label>
                                    <input id="province" type="text" placeholder="Nhập tỉnh/thành phố" @bind="_provinceName" class="nf-field" />
                                </div>
                                <div>
                                    <label class="nf-label" for="ward">Phường / Xã *</label>
                                    <input id="ward" type="text" placeholder="Nhập phường/xã" @bind="_wardName" class="nf-field" />
                                </div>
                            </div>
                            <p class="muted" style="font-size:var(--fs-sm)">Không tải được danh sách tỉnh/phường. Vui lòng nhập thủ công.</p>
                        }
                        else
                        {
                            <div class="nf-row nf-row--2">
                                <div>
                                    <label class="nf-label" for="province">Tỉnh / Thành phố *</label>
                                    <select id="province" @bind="_provinceCode" @bind:after="OnProvinceChangedAsync"
                                            disabled="@_provincesLoading" class="nf-field">
                                        <option value="">@(_provincesLoading ? "Đang tải..." : "Chọn Tỉnh/Thành")</option>
                                        @foreach (var p in _provinces)
                                        {
                                            <option value="@p.Code">@p.Name</option>
                                        }
                                    </select>
                                </div>
                                <div>
                                    <label class="nf-label" for="ward">Phường / Xã *</label>
                                    <select id="ward" @bind="_wardCode"
                                            disabled="@(string.IsNullOrEmpty(_provinceCode) || _wardsLoading)" class="nf-field">
                                        <option value="">@WardPlaceholder</option>
                                        @foreach (var w in _wards)
                                        {
                                            <option value="@w.Code">@w.Name</option>
                                        }
                                    </select>
                                </div>
                            </div>
                        }

                        <div>
                            <label class="nf-label" for="street">Địa chỉ cụ thể *</label>
                            <input id="street" type="text" placeholder="Số nhà, tên đường..." @bind="_street" class="nf-field" />
                        </div>

                        <div>
                            <label class="nf-label" for="note">Ghi chú đơn hàng</label>
                            <textarea id="note" placeholder="Ghi chú thêm về đơn hàng..." @bind="_note"
                                      class="nf-field" style="min-height:6rem"></textarea>
                        </div>
                    </div>
                </section>

                <section class="checkout__section">
                    <h2><NfIcon Name="receipt" Size="20" /> Phương thức thanh toán</h2>

                    <div style="display:grid;gap:1rem">
                        @foreach (var method in PaymentMethods)
                        {
                            var current = method;

                            <label class="radio-card @(_payment == current.Id ? "radio-card--checked" : null)">
                                <input type="radio" name="payment_method"
                                       checked="@(_payment == current.Id)" @onchange="() => _payment = current.Id" />
                                <span class="radio-card__body">
                                    <span class="radio-card__title">@current.Title</span>
                                    <span class="radio-card__desc">@current.Description</span>
                                </span>
                                <NfIcon Name="@current.Icon" Size="20" />
                            </label>
                        }
                    </div>
                </section>
            </div>

            @* Right: summary *@
            <div class="checkout__summary">
                <h2>Tóm tắt đơn hàng</h2>

                <dl aria-live="polite">
                    <div class="row">
                        <dt>Tạm tính (@(_cart?.ItemCount ?? 0) sản phẩm)</dt>
                        <dd>@Money.Vnd(_cart?.Subtotal ?? 0m)</dd>
                    </div>
                    <div class="row">
                        <dt>Phí vận chuyển</dt>
                        <dd>@Money.Vnd(_cart?.ShippingFee ?? 0m)</dd>
                    </div>
                </dl>

                <div class="checkout__promo">
                    <label class="sr-only" for="promo">Mã giảm giá</label>
                    <input id="promo" type="text" placeholder="Mã giảm giá" class="nf-field" style="flex:1" />
                    <button type="button" class="btn btn--ghost btn--sm"><span>Áp dụng</span></button>
                </div>

                <div class="checkout__total">
                    <span>Tổng cộng</span>
                    <b>@Money.Vnd(_cart?.Total ?? 0m)</b>
                </div>

                @if (_cart is not null && _cart.IsEmpty && !_cartUnavailable)
                {
                    <p class="alert alert--error" style="text-align:center;margin-bottom:1rem">
                        Giỏ hàng trống — hãy thêm sản phẩm trước khi đặt hàng.
                    </p>
                }

                @if (_cart is { HasUnavailableLines: true })
                {
                    <p class="alert alert--error" style="text-align:center;margin-bottom:1rem">
                        Vui lòng xóa sản phẩm đã hết hàng trước khi đặt hàng.
                    </p>
                }

                @if (_errors.Count > 0)
                {
                    <div class="alert alert--error" role="alert" style="margin-bottom:1rem">
                        @foreach (var error in _errors)
                        {
                            <p>@error</p>
                        }
                    </div>
                }

                <button type="button"
                        disabled="@(_submitting || _updating || _cartUnavailable || _cart is null || _cart.IsEmpty || _cart.HasUnavailableLines)"
                        @onclick="PlaceOrderAsync"
                        class="btn btn--red btn--block">
                    <span>@(_submitting ? "Đang xử lý..." : "Xác nhận đặt hàng")</span>
                    @if (!_submitting)
                    {
                        <NfIcon Name="arrow-right" Size="18" />
                    }
                </button>

                <p class="muted" style="text-align:center;font-size:var(--fs-xs);margin-top:1rem">
                    Bằng cách đặt hàng, bạn đồng ý với
                    <a class="linkbtn" href="@InfoPages.Terms" target="_blank" rel="noopener">Điều khoản sử dụng</a>
                    của chúng tôi.
                </p>
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly string[] Steps = ["Giỏ hàng", "Địa chỉ", "Xác nhận"];

    // The design shows the address step selected.
    private const int CurrentStep = 1;

    private sealed record PaymentOption(PaymentMethod Id, string Title, string Description, string Icon);

    private static readonly PaymentOption[] PaymentMethods =
    [
        new(PaymentMethod.CashOnDelivery, "Thanh toán khi nhận hàng (COD)", "Nhận hàng và thanh toán trực tiếp.", "truck"),
        new(PaymentMethod.BankTransfer,   "Chuyển khoản ngân hàng", "Chuyển khoản qua mã QR an toàn và nhanh chóng.", "receipt")
    ];

    private PaymentMethod _payment = PaymentMethod.CashOnDelivery;

    // Real totals are computed server-side (CartAssembler, re-derived from the Products table)
    // — see .claude/rules/security.md.
    [CascadingParameter(Name = "CartAnonymousId")] public string? CartAnonymousId { get; set; }
    private CartDto? _cart;
    private bool _updating;
    private bool _cartUnavailable;   // no user and no cookie — cookies blocked
    private (int ProductId, string VariantKey, string Name, int Quantity)? _lastRemoved;

    private IReadOnlyList<ProvinceDto> _provinces = [];
    private IReadOnlyList<WardDto> _wards = [];
    private string? _provinceCode;
    private string? _wardCode;
    private string? _provinceName;   // manual-entry fallback only
    private string? _wardName;       // manual-entry fallback only
    private bool _provincesLoading;
    private bool _wardsLoading;
    private bool _addressLookupFailed;
    private readonly CancellationTokenSource _cts = new();

    private string _fullName = string.Empty;
    private string _phone = string.Empty;
    private string? _email;
    private string _street = string.Empty;
    private string? _note;
    private bool _submitting;
    private List<string> _errors = [];

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string WardPlaceholder =>
        _wardsLoading ? "Đang tải..." : string.IsNullOrEmpty(_provinceCode) ? "Chọn Tỉnh/Thành trước" : "Chọn Phường/Xã";

    protected override async Task OnInitializedAsync()
    {
        // Prerender pass: skip the outbound calls so the first paint is never blocked by a
        // third party, and so the requests are not made twice (prerender + circuit). The
        // guest-cart merge and demo seed inside CartState are writes and must not run during
        // prerender — this is why the cart load also lives inside this guard.
        if (!RendererInfo.IsInteractive)
            return;

        ClaimsPrincipal? user = null;
        string? userId = null;
        if (AuthState is not null)
        {
            user = (await AuthState).User;
            if (user.Identity?.IsAuthenticated == true)
                userId = user.FindFirstValue(ClaimTypes.NameIdentifier);
        }

        if (string.IsNullOrWhiteSpace(userId) && string.IsNullOrWhiteSpace(CartAnonymousId))
        {
            // Cookies blocked — the page surfaces this, not the handlers.
            _cartUnavailable = true;
        }
        else
        {
            try
            {
                await CartState.EnsureInitializedAsync(userId, CartAnonymousId);
                _cart = await Sender.Send(new GetCartQuery(CartAnonymousId), _cts.Token);
            }
            catch (OperationCanceledException) { /* circuit tore down */ }
        }

        _provincesLoading = true;
        try
        {
            var result = await Sender.Send(new GetProvincesQuery(), _cts.Token);
            if (result.IsSuccess) _provinces = result.Value;
            else _addressLookupFailed = true;
        }
        catch (OperationCanceledException) { /* circuit tore down */ }
        finally { _provincesLoading = false; }

        if (user is not null && user.Identity?.IsAuthenticated == true)
        {
            _fullName = string.IsNullOrWhiteSpace(_fullName)
                ? user.FindFirst("FullName")?.Value ?? string.Empty : _fullName;
            _email = string.IsNullOrWhiteSpace(_email)
                ? user.FindFirst(ClaimTypes.Email)?.Value ?? user.Identity.Name ?? string.Empty : _email;
        }
    }

    private Task IncrementAsync(CartLineDto line) => SetQuantityAsync(line.ProductId, line.VariantKey, line.Quantity + 1);

    private Task DecrementAsync(CartLineDto line) => SetQuantityAsync(line.ProductId, line.VariantKey, line.Quantity - 1);

    private Task OnQuantityInputAsync(CartLineDto line, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var parsed))
            return SetQuantityAsync(line.ProductId, line.VariantKey, Math.Clamp(parsed, 1, Cart.MaxQuantityPerItem));

        // Unparseable input: leave the previous value, send nothing, just repaint the input
        // back to its bound value.
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task SetQuantityAsync(int productId, string variantKey, int quantity)
    {
        // Every mutation is a write on the shared scoped AppDbContext — parallel sends would
        // throw "A second operation was started on this context instance…" (data-access.md).
        if (_updating) return;
        _updating = true;

        try
        {
            var clamped = Math.Clamp(quantity, 1, Cart.MaxQuantityPerItem);
            var result = await Sender.Send(new SetCartLineQuantityCommand(productId, variantKey, clamped, CartAnonymousId), _cts.Token);

            if (result.IsSuccess)
            {
                _cart = result.Value;
                CartState.Set(_cart.ItemCount);
                _errors = [];
                _lastRemoved = null;
            }
            else
            {
                _errors = result.ValidationErrors.Select(v => v.ErrorMessage)
                    .Concat(result.Errors)
                    .DefaultIfEmpty("Không thể cập nhật giỏ hàng. Vui lòng thử lại.")
                    .ToList();
            }
        }
        catch (OperationCanceledException) { /* circuit tore down */ }
        finally { _updating = false; }
    }

    private async Task RemoveAsync(CartLineDto line)
    {
        if (_updating) return;
        _updating = true;

        try
        {
            var result = await Sender.Send(new RemoveCartLineCommand(line.ProductId, line.VariantKey, CartAnonymousId), _cts.Token);

            if (result.IsSuccess)
            {
                _cart = result.Value;
                CartState.Set(_cart.ItemCount);
                _errors = [];
                _lastRemoved = (line.ProductId, line.VariantKey, line.Name, line.Quantity);
            }
            else
            {
                _errors = result.ValidationErrors.Select(v => v.ErrorMessage)
                    .Concat(result.Errors)
                    .DefaultIfEmpty("Không thể xóa sản phẩm khỏi giỏ hàng. Vui lòng thử lại.")
                    .ToList();
            }
        }
        catch (OperationCanceledException) { /* circuit tore down */ }
        finally { _updating = false; }
    }

    private async Task UndoRemoveAsync()
    {
        if (_lastRemoved is not { } removed) return;
        _lastRemoved = null;
        await SetQuantityAsync(removed.ProductId, removed.VariantKey, removed.Quantity);
    }

    private async Task PlaceOrderAsync()
    {
        if (_submitting) return;          // guards against a double-click creating two orders
        _submitting = true;
        _errors = [];

        try
        {
            // Resolve the display names for the selected codes; fall back to the manual-entry
            // text inputs shown when the address lookup is unavailable.
            var province = _addressLookupFailed
                ? _provinceName
                : _provinces.FirstOrDefault(p => p.Code.ToString() == _provinceCode)?.Name;
            var ward = _addressLookupFailed
                ? _wardName
                : _wards.FirstOrDefault(w => w.Code.ToString() == _wardCode)?.Name;

            var result = await Sender.Send(new CreateOrderCommand(
                _fullName, _phone, _email, _street,
                ward ?? string.Empty, province ?? string.Empty,
                _note, _payment, CartAnonymousId), _cts.Token);

            if (result.IsSuccess)
            {
                CartState.Set(0);
                Navigation.NavigateTo($"/dat-hang-thanh-cong/{result.Value.Code}");
                return;                   // leave _submitting true; we are navigating away
            }

            _errors = result.ValidationErrors.Select(v => v.ErrorMessage)
                .Concat(result.Errors)
                .DefaultIfEmpty("Không thể đặt hàng. Vui lòng thử lại.")
                .ToList();
        }
        catch (OperationCanceledException) { /* circuit tore down */ }
        finally
        {
            if (_errors.Count > 0) _submitting = false;
        }
    }

    private async Task OnProvinceChangedAsync()
    {
        _wardCode = null;
        _wards = [];

        if (!int.TryParse(_provinceCode, out var code) || code <= 0)
            return;

        _wardsLoading = true;
        StateHasChanged();               // paint the "Đang tải..." state before awaiting
        try
        {
            var result = await Sender.Send(new GetWardsQuery(code), _cts.Token);
            _wards = result.IsSuccess ? result.Value : [];
        }
        catch (OperationCanceledException) { }
        finally { _wardsLoading = false; }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
