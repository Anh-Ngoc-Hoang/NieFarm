@page "/tra-cuu-don-hang"
@using Ardalis.Result
@using NieFarm.Application.Features.Orders.Commands
@using NieFarm.Application.Features.Orders.Dtos
@using NieFarm.Application.Features.Orders
@using NieFarm.Application.Features.Orders.Queries
@using NieFarm.Domain.Enums
@implements IDisposable
@inject ISender Sender
@inject NieFarm.Web.Services.Orders.PaymentStatusNotifier PaymentNotifier
@inject NieFarm.Web.Services.Orders.PlacedOrderState PlacedOrders

@*
    Real order lookup by code + phone (docs/plans/R-02-order-lookup-real.md). The page opens
    empty; ?ma= pre-fills only the code. Deliberate exception: when this circuit just placed
    that order (PlacedOrderState match) the phone is filled from circuit memory and the normal
    throttled LookupOrderQuery runs once; after a reload, in a new tab or for any other order
    nothing is filled or run. LookupOrderQuery returns a minimal, masked DTO.
    An unknown code and a wrong phone both come back as NotFound and show the same constant
    sentence (NotFoundText, never echoing the input), so the page cannot be used to discover
    which codes exist. Repeated failures are throttled in Application/Infrastructure
    (IOrderLookupThrottle) and surface here as a plain error message.

    Order workflow (docs/plans/R-07-order-workflow.md): the progress rail is OrderTrackProgress with
    real step times, and a guest New order can be cancelled here. The cancel command re-verifies
    code + phone server-side, so the page sends the values captured at the successful lookup
    (_verifiedCode/_verifiedPhone), not whatever is typed in the inputs now. Account orders show a
    sign-in hint instead.

    D18 live status: after a successful lookup the page subscribes to PaymentStatusNotifier for that
    order code (the right to see it is proven by code + phone) and, on an event, re-runs the same
    authorised LookupOrderQuery with the verified values. The event itself carries no order data.
*@

<PageTitle>Tra cứu đơn hàng - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="description"
          content="Nhập mã đơn hàng và số điện thoại để kiểm tra tình trạng giao hàng và chi tiết đơn tại Nie Farm." />
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="nf-track">
    <div class="shell">

        <div class="nf-track__intro" data-reveal="fade">
            <p class="eyebrow eyebrow--plain nf-track__eyebrow">Tra cứu đơn hàng</p>
            <h1 class="nf-track__title">Theo dõi đơn hàng của bạn</h1>
            <p class="lede nf-track__lede">
                Nhập mã đơn hàng và số điện thoại bạn đã dùng khi đặt hàng để kiểm tra tình trạng đơn.
            </p>

            <EditForm Model="_model" OnValidSubmit="SearchAsync" class="nf-track__form">
                <div class="nf-track__field">
                    <NfIcon Name="search" Size="18" CssClass="nf-track__field-ico" />
                    <label class="sr-only" for="order-code">Mã đơn hàng</label>
                    <InputText id="order-code" @bind-Value="_model.Code" placeholder="Mã đơn hàng, ví dụ NF123456"
                               autocomplete="off" autocapitalize="characters" spellcheck="false"
                               class="nf-field nf-track__field-input" />
                </div>
                <div class="nf-track__field">
                    <NfIcon Name="phone" Size="18" CssClass="nf-track__field-ico" />
                    <label class="sr-only" for="order-phone">Số điện thoại</label>
                    <InputText id="order-phone" @bind-Value="_model.Phone" placeholder="Số điện thoại đặt hàng"
                               type="tel" inputmode="tel" autocomplete="tel"
                               class="nf-field nf-track__field-input" />
                </div>
                <button type="submit" class="btn btn--red" disabled="@_busy"><span>Tra cứu</span></button>
            </EditForm>

            @if (_message is not null)
            {
                <p class="nf-track__error" role="status">@_message</p>
            }
            @foreach (var error in _errors)
            {
                <p class="nf-track__error" role="status">@error</p>
            }
        </div>

        @if (_order is not null)
        {
            <div class="nf-track__result" data-reveal="fade" @key="_order.Code">
                <p class="sr-only" aria-live="polite">@(_justPaid ? PaidText : "")</p>

                @* Progress *@
                <div class="nf-track__panel">
                    <div class="nf-track__head">
                        <div>
                            <h2>Mã đơn: <span class="nf-track__code">@_order.Code</span></h2>
                            <p class="muted nf-track__placed">Ngày đặt: @VnTime.FromUtc(_order.PlacedAtUtc).ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <span class="badge-status @OrderStatusText.PillClass(_order.Status)">@OrderStatusText.Vi(_order.Status)</span>
                    </div>

                    <OrderTrackProgress Status="_order.Status" Timeline="_order.Timeline" />

                    @* Payment (R-01): the panel shows only while the transfer is still awaited and the order is open. *@
                    @if (_order.BankTransfer is not null)
                    {
                        <BankTransferPanel Instructions="_order.BankTransfer" />
                        <p class="nf-pay__note">Nie Farm sẽ giao hàng sau khi nhận được chuyển khoản của bạn.</p>
                    }
                    else if (_order.PaymentMethod == PaymentMethod.BankTransfer
                             && _order.PaymentStatus == PaymentStatus.AwaitingPayment
                             && _order.Status != OrderStatus.Cancelled)
                    {
                        <p class="nf-pay__unavailable" role="status">Thông tin chuyển khoản đang được cập nhật. Vui lòng liên hệ Nie Farm để được hỗ trợ.</p>
                    }
                    else if (_order.PaymentStatus == PaymentStatus.Paid)
                    {
                        <p class="nf-track__ok">@PaidText</p>
                    }
                    else if (_order.PaymentStatus == PaymentStatus.RefundDue)
                    {
                        <p class="nf-track__ok" role="status">Đơn hàng đã hủy. Nie Farm sẽ liên hệ để hoàn tiền cho bạn.</p>
                    }
                    else if (_order.PaymentStatus == PaymentStatus.Refunded)
                    {
                        <p class="nf-track__ok" role="status">Nie Farm đã hoàn tiền cho đơn hàng này.</p>
                    }

                    @if (_order.CanCancel)
                    {
                        <OrderCancelForm Code="@_order.Code" Busy="_cancelBusy" Error="@_cancelError" OnConfirm="CancelAsync"
                                         Warning="@(_order.PaymentMethod == PaymentMethod.BankTransfer && _order.PaymentStatus == PaymentStatus.AwaitingPayment ? OrderLookupMessages.CancelAfterTransferWarning : null)" />
                    }
                    else if (_order.CancelRequiresSignIn)
                    {
                        <div class="nf-track__cancel">
                            <p class="nf-track__cancel-hint">
                                @OrderLookupMessages.AccountOrderRequiresSignIn
                                <a href="/dang-nhap?returnUrl=%2Ftai-khoan%2Fdon-hang">Đăng nhập</a>
                            </p>
                        </div>
                    }

                    @if (_cancelNotice is not null)
                    {
                        <p class="nf-track__ok" role="status">@_cancelNotice</p>
                    }
                </div>

                <div class="nf-track__cols">

                    @* Recipient (masked) *@
                    <div class="nf-track__panel">
                        <h3 class="nf-track__panel-title"><NfIcon Name="user" Size="18" /> Thông tin giao hàng</h3>
                        <dl class="nf-track__meta">
                            <div>
                                <dt>Người nhận</dt>
                                <dd>@_order.RecipientName</dd>
                            </div>
                            <div>
                                <dt>Số điện thoại</dt>
                                <dd>@_order.PhoneMasked</dd>
                            </div>
                            <div>
                                <dt>Khu vực giao hàng</dt>
                                <dd>@_order.DeliveryArea</dd>
                            </div>
                            <div>
                                <dt>Phương thức thanh toán</dt>
                                <dd>@OrderStatusText.Vi(_order.PaymentMethod)</dd>
                            </div>
                            @if (_order.PaymentMethod == PaymentMethod.BankTransfer)
                            {
                                <div>
                                    <dt>Thanh toán</dt>
                                    <dd><span class="badge-status @OrderStatusText.PaymentPillClass(_order.PaymentStatus)">@OrderStatusText.Vi(_order.PaymentStatus)</span></dd>
                                </div>
                            }
                        </dl>
                    </div>

                    @* Lines + totals *@
                    <div class="nf-track__stack">
                        <div class="nf-track__panel">
                            <h3 class="nf-track__panel-title"><NfIcon Name="cart" Size="18" /> Chi tiết sản phẩm</h3>

                            <ul class="nf-track__lines">
                                @foreach (var line in _order.Lines)
                                {
                                    <li class="nf-track__line">
                                        @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                                        {
                                            <div class="nf-track__line-media">
                                                <img src="@line.ImageUrl" alt="@line.ProductName" />
                                            </div>
                                        }
                                        <div class="nf-track__line-body">
                                            <div class="nf-track__line-row">
                                                <div>
                                                    <p class="nf-track__line-name">@line.ProductName</p>
                                                    @if (!string.IsNullOrWhiteSpace(line.Variant))
                                                    {
                                                        <p class="nf-track__line-meta">Phân loại: @line.Variant</p>
                                                    }
                                                </div>
                                                <span class="nf-track__line-price">@SiteContent.Vnd(line.UnitPrice)</span>
                                            </div>
                                            <p class="nf-track__line-qty">
                                                @* Parenthesised so Razor does not read "x@..." as an email literal. *@
                                                Số lượng: <b>x@(line.Quantity)</b>
                                            </p>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="nf-track__panel">
                            <dl class="nf-track__totals">
                                <div class="row">
                                    <dt>Tạm tính</dt>
                                    <dd>@SiteContent.Vnd(_order.Subtotal)</dd>
                                </div>
                                <div class="row">
                                    <dt>Phí vận chuyển@(string.IsNullOrWhiteSpace(_order.ShippingZoneName) ? null : $" ({_order.ShippingZoneName})")</dt>
                                    <dd>@(_order.ShippingFee == 0m ? "Miễn phí" : SiteContent.Vnd(_order.ShippingFee))</dd>
                                </div>
                                @if (_order.Discount > 0m)
                                {
                                    <div class="row">
                                        <dt>Giảm giá</dt>
                                        <dd class="nf-track__discount">-@SiteContent.Vnd(_order.Discount)</dd>
                                    </div>
                                }
                                <div class="total">
                                    <dt>Tổng cộng</dt>
                                    <dd>@SiteContent.Vnd(_order.Total)</dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private const string NotFoundText =
        "Không tìm thấy đơn hàng phù hợp. Vui lòng kiểm tra lại mã đơn hàng và số điện thoại đã dùng khi đặt hàng.";

    private sealed class LookupModel
    {
        public string Code { get; set; } = "";
        public string Phone { get; set; } = "";
    }

    // One visible sentence; the sr-only aria-live region above is the only announcer.
    private string PaidText =>
        _order?.PaidAtUtc is { } paidAt
            ? $"Nie Farm đã nhận được thanh toán của bạn lúc {VnTime.FromUtc(paidAt):dd/MM/yyyy HH:mm}"
            : "Nie Farm đã nhận được thanh toán của bạn.";

    private readonly CancellationTokenSource _cts = new();
    private readonly LookupModel _model = new();
    private OrderLookupDto? _order;
    private string? _message;
    private IEnumerable<string> _errors = [];
    private bool _busy;
    private bool _cancelBusy;
    private string? _cancelError;
    private string? _cancelNotice;
    private string _verifiedCode = "";
    private string _verifiedPhone = "";
    private IDisposable? _subscription;
    private bool _justPaid;
    private int _lookupGeneration;
    private bool _autoLookupTried;

    // Pre-fills the code only from the URL; the phone is never in the URL. The only automatic
    // submit is the circuit-local one in OnAfterRenderAsync below.
    [SupplyParameterFromQuery(Name = "ma")] public string? PrefillCode { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(PrefillCode))
            _model.Code = PrefillCode.Trim();
    }

    // Auto-run from the success page: OnAfterRenderAsync never runs during prerender, and a hard
    // reload starts a new circuit whose PlacedOrderState is empty, so both just show the prefilled
    // code form. firstRender makes this at most once per page instance. The phone comes only from
    // this circuit's PlacedOrderState (the customer's own just-placed order) and is never put in a
    // URL, log or other storage; SearchAsync is the normal lookup, verified server-side by code +
    // phone and subject to IOrderLookupThrottle.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _autoLookupTried) return;
        _autoLookupTried = true;

        if (string.IsNullOrWhiteSpace(_model.Code)
            || !PlacedOrders.TryGetLookupCredentials(_model.Code, out var phone))
            return;

        _model.Phone = phone;
        var search = SearchAsync();   // sets _busy synchronously before its first await
        StateHasChanged();            // show the busy state while the query runs
        await search;
        StateHasChanged();
    }

    private async Task SearchAsync()
    {
        if (_busy) return;
        _busy = true;
        _lookupGeneration++;
        _order = null;
        _justPaid = false;
        UnsubscribeFromPayment();
        _message = null;
        _errors = [];
        _cancelError = null;
        _cancelNotice = null;

        try
        {
            // Snapshot: both inputs stay editable while the query runs, so the verified
            // credentials must be the ones that were actually sent.
            var code = _model.Code;
            var phone = _model.Phone;
            var result = await Sender.Send(new LookupOrderQuery(code, phone), _cts.Token);

            if (result.IsSuccess)
            {
                _order = result.Value;
                _verifiedCode = code;
                _verifiedPhone = phone;
                SubscribeToPayment(_order.Code);
            }
            else if (result.Status == ResultStatus.NotFound)
            {
                _message = NotFoundText;
            }
            else
            {
                _errors = result.ValidationErrors.Select(v => v.ErrorMessage)
                    .Concat(result.Errors)
                    .DefaultIfEmpty("Đã có lỗi xảy ra. Vui lòng thử lại.")
                    .ToList();
            }
        }
        catch (OperationCanceledException)
        {
            // Circuit disposed mid-query; nothing to show.
        }
        catch (Exception)
        {
            _errors = ["Đã có lỗi xảy ra. Vui lòng thử lại."];
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelAsync(string? reason)
    {
        if (_cancelBusy) return;
        _cancelBusy = true;
        _cancelError = null;
        _cancelNotice = null;

        try
        {
            var result = await Sender.Send(
                new CancelLookedUpOrderCommand(_verifiedCode, _verifiedPhone, reason), _cts.Token);

            if (result.IsSuccess || result.Status == ResultStatus.Conflict)
            {
                // Re-query with the verified values so the page shows the real, latest state.
                var refreshed = await Sender.Send(new LookupOrderQuery(_verifiedCode, _verifiedPhone), _cts.Token);
                if (refreshed.IsSuccess)
                    _order = refreshed.Value;

                _cancelNotice = result.IsSuccess ? "Đơn hàng đã được hủy." : OrderLookupMessages.Conflict;
            }
            else if (result.Status == ResultStatus.NotFound)
            {
                _cancelError = NotFoundText;
            }
            else
            {
                _cancelError = result.ValidationErrors.Select(v => v.ErrorMessage)
                    .Concat(result.Errors)
                    .FirstOrDefault(m => !string.IsNullOrWhiteSpace(m))
                    ?? "Đã có lỗi xảy ra. Vui lòng thử lại.";
            }
        }
        catch (OperationCanceledException)
        {
            // Circuit disposed mid-command; nothing to show.
        }
        catch (Exception)
        {
            _cancelError = "Đã có lỗi xảy ra. Vui lòng thử lại.";
        }
        finally
        {
            _cancelBusy = false;
        }
    }

    // Called only after a successful, phone-verified lookup, with the server's own order code.
    private void SubscribeToPayment(string code)
    {
        UnsubscribeFromPayment();
        if (_order is { PaymentMethod: PaymentMethod.BankTransfer, PaymentStatus: PaymentStatus.AwaitingPayment })
        {
            var generation = _lookupGeneration;
            var verifiedCode = _verifiedCode;
            var verifiedPhone = _verifiedPhone;
            _subscription = PaymentNotifier.Subscribe(code, status => OnPaymentStatusAsync(status, generation, verifiedCode, verifiedPhone));
        }
    }

    private void UnsubscribeFromPayment()
    {
        _subscription?.Dispose();
        _subscription = null;
    }

    private Task OnPaymentStatusAsync(PaymentStatus status, int generation, string code, string phone) =>
        InvokeAsync(async () =>
        {
            if (_order is null || _cts.IsCancellationRequested || generation != _lookupGeneration) return;

            // Re-run the page's own authorised lookup with the values captured at the verified lookup.
            var refreshed = await Sender.Send(new LookupOrderQuery(code, phone), _cts.Token);

            // A newer lookup may have replaced the order while this one was in flight; drop stale results.
            if (!refreshed.IsSuccess || _order is null || _cts.IsCancellationRequested
                || generation != _lookupGeneration || refreshed.Value.Code != _order.Code) return;

            _order = refreshed.Value;
            if (status == PaymentStatus.Paid && _order.PaymentStatus == PaymentStatus.Paid)
                _justPaid = true;
            if (_order.PaymentStatus != PaymentStatus.AwaitingPayment)
                UnsubscribeFromPayment();
            StateHasChanged();
        });

    public void Dispose()
    {
        UnsubscribeFromPayment();
        _cts.Cancel();
        _cts.Dispose();
    }
}
