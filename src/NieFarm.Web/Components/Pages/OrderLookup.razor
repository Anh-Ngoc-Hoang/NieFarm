@page "/tra-cuu-don-hang"
@using Ardalis.Result
@using NieFarm.Application.Features.Orders.Dtos
@using NieFarm.Application.Features.Orders.Queries
@using NieFarm.Domain.Enums
@implements IDisposable
@inject ISender Sender

@*
    Real order lookup by code + phone (docs/plans/order-lookup-real.md). The page opens
    empty; ?ma= pre-fills only the code. LookupOrderQuery returns a minimal, masked DTO.
    An unknown code and a wrong phone both come back as NotFound and show the same constant
    sentence (NotFoundText, never echoing the input), so the page cannot be used to discover
    which codes exist. Repeated failures are throttled in Application/Infrastructure
    (IOrderLookupThrottle) and surface here as a plain error message.
*@

<PageTitle>Tra cứu đơn hàng - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="description"
          content="Nhập mã đơn hàng và số điện thoại để kiểm tra tình trạng giao hàng và chi tiết đơn tại Nie Farm." />
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="nf-track">
    <div class="shell">

        <div class="nf-track__intro" data-reveal="fade">
            <p class="eyebrow eyebrow--plain nf-track__eyebrow">Tra cứu đơn hàng</p>
            <h1 class="nf-track__title">Theo dõi đơn hàng của bạn</h1>
            <p class="lede nf-track__lede">
                Nhập mã đơn hàng và số điện thoại bạn đã dùng khi đặt hàng để kiểm tra tình trạng đơn.
            </p>

            <EditForm Model="_model" OnValidSubmit="SearchAsync" class="nf-track__form">
                <div class="nf-track__field">
                    <NfIcon Name="search" Size="18" CssClass="nf-track__field-ico" />
                    <label class="sr-only" for="order-code">Mã đơn hàng</label>
                    <InputText id="order-code" @bind-Value="_model.Code" placeholder="Mã đơn hàng, ví dụ NF123456"
                               autocomplete="off" autocapitalize="characters" spellcheck="false"
                               class="nf-field nf-track__field-input" />
                </div>
                <div class="nf-track__field">
                    <NfIcon Name="phone" Size="18" CssClass="nf-track__field-ico" />
                    <label class="sr-only" for="order-phone">Số điện thoại</label>
                    <InputText id="order-phone" @bind-Value="_model.Phone" placeholder="Số điện thoại đặt hàng"
                               type="tel" inputmode="tel" autocomplete="tel"
                               class="nf-field nf-track__field-input" />
                </div>
                <button type="submit" class="btn btn--red" disabled="@_busy"><span>Tra cứu</span></button>
            </EditForm>

            @if (_message is not null)
            {
                <p class="nf-track__error" role="status">@_message</p>
            }
            @foreach (var error in _errors)
            {
                <p class="nf-track__error" role="status">@error</p>
            }
        </div>

        @if (_order is not null)
        {
            <div class="nf-track__result" data-reveal="fade" @key="_order.Code">

                @* Progress *@
                <div class="nf-track__panel">
                    <div class="nf-track__head">
                        <div>
                            <h2>Mã đơn: <span class="nf-track__code">@_order.Code</span></h2>
                            <p class="muted nf-track__placed">Ngày đặt: @VnTime.FromUtc(_order.PlacedAtUtc).ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                        <span class="badge-status @OrderStatusText.PillClass(_order.Status)">@OrderStatusText.Vi(_order.Status)</span>
                    </div>

                    @if (_order.Status == OrderStatus.Cancelled)
                    {
                        <p class="nf-track__notice">
                            <NfIcon Name="warning" Size="18" />
                            <span>
                                Đơn hàng này đã bị hủy. Nếu cần hỗ trợ, vui lòng liên hệ Nie Farm.
                                <a href="/#lien-he">Liên hệ</a>
                            </span>
                        </p>
                    }
                    else
                    {
                        <ol class="nf-track__steps" style="--track-progress: @ProgressWidth">
                            @foreach (var step in Steps)
                            {
                                <li class="nf-track__step @(step.Reached ? "nf-track__step--reached" : null)">
                                    <span class="nf-track__dot">
                                        <NfIcon Name="@step.Icon" Size="18" />
                                    </span>
                                    <span class="nf-track__label">@step.Label</span>
                                    @if (step.Time is not null)
                                    {
                                        <span class="nf-track__time">@step.Time</span>
                                    }
                                </li>
                            }
                        </ol>
                    }
                </div>

                <div class="nf-track__cols">

                    @* Recipient (masked) *@
                    <div class="nf-track__panel">
                        <h3 class="nf-track__panel-title"><NfIcon Name="user" Size="18" /> Thông tin giao hàng</h3>
                        <dl class="nf-track__meta">
                            <div>
                                <dt>Người nhận</dt>
                                <dd>@_order.RecipientName</dd>
                            </div>
                            <div>
                                <dt>Số điện thoại</dt>
                                <dd>@_order.PhoneMasked</dd>
                            </div>
                            <div>
                                <dt>Khu vực giao hàng</dt>
                                <dd>@_order.DeliveryArea</dd>
                            </div>
                            <div>
                                <dt>Phương thức thanh toán</dt>
                                <dd>@OrderStatusText.Vi(_order.PaymentMethod)</dd>
                            </div>
                        </dl>
                    </div>

                    @* Lines + totals *@
                    <div class="nf-track__stack">
                        <div class="nf-track__panel">
                            <h3 class="nf-track__panel-title"><NfIcon Name="cart" Size="18" /> Chi tiết sản phẩm</h3>

                            <ul class="nf-track__lines">
                                @foreach (var line in _order.Lines)
                                {
                                    <li class="nf-track__line">
                                        @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                                        {
                                            <div class="nf-track__line-media">
                                                <img src="@line.ImageUrl" alt="@line.ProductName" />
                                            </div>
                                        }
                                        <div class="nf-track__line-body">
                                            <div class="nf-track__line-row">
                                                <div>
                                                    <p class="nf-track__line-name">@line.ProductName</p>
                                                    @if (!string.IsNullOrWhiteSpace(line.Variant))
                                                    {
                                                        <p class="nf-track__line-meta">Phân loại: @line.Variant</p>
                                                    }
                                                </div>
                                                <span class="nf-track__line-price">@SiteContent.Vnd(line.UnitPrice)</span>
                                            </div>
                                            <p class="nf-track__line-qty">
                                                @* Parenthesised so Razor does not read "x@..." as an email literal. *@
                                                Số lượng: <b>x@(line.Quantity)</b>
                                            </p>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="nf-track__panel">
                            <dl class="nf-track__totals">
                                <div class="row">
                                    <dt>Tạm tính</dt>
                                    <dd>@SiteContent.Vnd(_order.Subtotal)</dd>
                                </div>
                                <div class="row">
                                    <dt>Phí vận chuyển</dt>
                                    <dd>@SiteContent.Vnd(_order.ShippingFee)</dd>
                                </div>
                                <div class="row">
                                    <dt>Giảm giá</dt>
                                    <dd class="nf-track__discount">-@SiteContent.Vnd(_order.Discount)</dd>
                                </div>
                                <div class="total">
                                    <dt>Tổng cộng</dt>
                                    <dd>@SiteContent.Vnd(_order.Total)</dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private const string NotFoundText =
        "Không tìm thấy đơn hàng phù hợp. Vui lòng kiểm tra lại mã đơn hàng và số điện thoại đã dùng khi đặt hàng.";

    private sealed class LookupModel
    {
        public string Code { get; set; } = "";
        public string Phone { get; set; } = "";
    }

    private sealed record TrackStep(string Label, string Icon, bool Reached, string? Time);

    private readonly CancellationTokenSource _cts = new();
    private readonly LookupModel _model = new();
    private OrderLookupDto? _order;
    private string? _message;
    private IEnumerable<string> _errors = [];
    private bool _busy;

    // Pre-fills the code only; never the phone, and never submits on its own.
    [SupplyParameterFromQuery(Name = "ma")] public string? PrefillCode { get; set; }

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(PrefillCode))
            _model.Code = PrefillCode.Trim();
    }

    private async Task SearchAsync()
    {
        if (_busy) return;
        _busy = true;
        _order = null;
        _message = null;
        _errors = [];

        try
        {
            var result = await Sender.Send(new LookupOrderQuery(_model.Code, _model.Phone), _cts.Token);

            if (result.IsSuccess)
            {
                _order = result.Value;
            }
            else if (result.Status == ResultStatus.NotFound)
            {
                _message = NotFoundText;
            }
            else
            {
                _errors = result.ValidationErrors.Select(v => v.ErrorMessage)
                    .Concat(result.Errors)
                    .DefaultIfEmpty("Đã có lỗi xảy ra. Vui lòng thử lại.")
                    .ToList();
            }
        }
        catch (OperationCanceledException)
        {
            // Circuit disposed mid-query; nothing to show.
        }
        catch (Exception)
        {
            _errors = ["Đã có lỗi xảy ra. Vui lòng thử lại."];
        }
        finally
        {
            _busy = false;
        }
    }

    // Four steps derived from Status; only the first has a real timestamp (no status history yet).
    private IReadOnlyList<TrackStep> Steps
    {
        get
        {
            var rank = _order!.Status switch
            {
                OrderStatus.New => 0,
                OrderStatus.Confirmed => 1,
                OrderStatus.Delivering => 2,
                OrderStatus.Completed => 3,
                _ => 0
            };
            return
            [
                new("Đã đặt hàng", "receipt", rank >= 0, VnTime.FromUtc(_order.PlacedAtUtc).ToString("dd/MM, HH:mm")),
                new("Đã xác nhận", "shield", rank >= 1, null),
                new("Đang giao", "truck", rank >= 2, null),
                new("Hoàn thành", "check", rank >= 3, null)
            ];
        }
    }

    private string ProgressWidth
    {
        get
        {
            var steps = Steps;
            var reached = Math.Max(0, steps.Count(s => s.Reached) - 1);
            return $"{reached * 100 / (steps.Count - 1)}%";
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}
