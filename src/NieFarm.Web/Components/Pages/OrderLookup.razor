@page "/tra-cuu-don-hang"

@*
    Markup-only rewrite onto NieFarm 2.0 (docs/plans/public-site-redesign-nf2.md
    §7, step 4.2). @code is unchanged except for one addition: StepGlyph(), a
    pure display mapping from the fixture's Material Symbol icon names to
    NfIcon glyph names (NfIcon has no "inventory_2"/"local_shipping"/"task_alt"
    glyphs). Search()/ProgressWidth are byte-for-byte the same; the page still
    matches only the SiteContent.SampleOrderCode ("NF12345") fixture — that is
    unchanged.
*@

<PageTitle>Tra cứu đơn hàng - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="description"
          content="Nhập mã đơn hàng Nie Farm để kiểm tra tình trạng giao hàng, thông tin người nhận và chi tiết sản phẩm." />
</HeadContent>

<div class="nf-track">
    <div class="shell">

        <div class="nf-track__intro" data-reveal="fade">
            <p class="eyebrow eyebrow--plain" style="justify-content:center">Tra cứu đơn hàng</p>
            <h1 style="margin-top:.6rem">Theo dõi đơn hàng của bạn</h1>
            <p class="lede" style="margin:1rem auto 0">
                Nhập mã đơn hàng của bạn để kiểm tra tình trạng giao hàng và chi tiết sản phẩm.
            </p>

            <EditForm Model="this" OnValidSubmit="Search" class="nf-track__form">
                <div class="nf-track__field">
                    <NfIcon Name="search" Size="18" CssClass="nf-track__field-ico" />
                    <label class="sr-only" for="order-code">Mã đơn hàng</label>
                    <InputText id="order-code" @bind-Value="_code" placeholder="@($"Ví dụ: {SiteContent.SampleOrderCode}")"
                               class="nf-field nf-track__field-input" />
                </div>
                <button type="submit" class="btn btn--red"><span>Tra cứu</span></button>
            </EditForm>

            @if (_notFound)
            {
                <p class="nf-track__error" role="status">
                    Không tìm thấy đơn hàng với mã &ldquo;@_code&rdquo;. Vui lòng kiểm tra lại mã đơn.
                </p>
            }
        </div>

        @if (_order is not null)
        {
            <div class="nf-track__result" data-reveal="fade" @key="_order.Code">

                @* Progress *@
                <div class="nf-track__panel">
                    <div class="nf-track__head">
                        <div>
                            <h2>Mã đơn: <span class="nf-track__code">@_order.Code</span></h2>
                            <p class="muted" style="font-size:var(--fs-sm);margin-top:.3rem">Ngày đặt: @_order.PlacedOn</p>
                        </div>
                        <span class="badge-status badge-status--ok">@_order.Status</span>
                    </div>

                    <ol class="nf-track__steps" style="--track-progress: @ProgressWidth">
                        @foreach (var step in _order.Steps)
                        {
                            <li class="nf-track__step @(step.Reached ? "nf-track__step--reached" : null)">
                                <span class="nf-track__dot">
                                    <NfIcon Name="@StepGlyph(step.Icon)" Size="18" />
                                </span>
                                <span class="nf-track__label">@step.Label</span>
                                <span class="nf-track__time">@step.Timestamp</span>
                            </li>
                        }
                    </ol>
                </div>

                <div class="nf-track__cols">

                    @* Recipient *@
                    <div class="nf-track__panel">
                        <h3 class="nf-track__panel-title"><NfIcon Name="user" Size="18" /> Thông tin người nhận</h3>
                        <dl class="nf-track__meta">
                            <div>
                                <dt>Họ và tên</dt>
                                <dd>@_order.RecipientName</dd>
                            </div>
                            <div>
                                <dt>Số điện thoại</dt>
                                <dd>@_order.RecipientPhone</dd>
                            </div>
                            <div>
                                <dt>Địa chỉ giao hàng</dt>
                                <dd>@_order.ShippingAddress</dd>
                            </div>
                        </dl>
                    </div>

                    @* Lines + totals *@
                    <div style="display:grid;gap:clamp(1.5rem,3vw,2rem)">
                        <div class="nf-track__panel">
                            <h3 class="nf-track__panel-title"><NfIcon Name="cart" Size="18" /> Chi tiết sản phẩm</h3>

                            <ul class="nf-track__lines">
                                @foreach (var line in _order.Lines)
                                {
                                    <li class="nf-track__line">
                                        <div class="nf-track__line-media">
                                            <img src="@line.ImageUrl" alt="@line.ImageAlt" />
                                        </div>
                                        <div class="nf-track__line-body">
                                            <div class="nf-track__line-row">
                                                <div>
                                                    <p class="nf-track__line-name">@line.Name</p>
                                                    <p class="nf-track__line-meta">Phân loại: @line.Variant</p>
                                                </div>
                                                <span class="nf-track__line-price">@SiteContent.Vnd(line.UnitPrice)</span>
                                            </div>
                                            <p class="nf-track__line-qty">
                                                @* Parenthesised so Razor does not read "x@..." as an email literal. *@
                                                Số lượng: <b>x@(line.Quantity)</b>
                                            </p>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="nf-track__panel">
                            <dl class="nf-track__totals">
                                <div class="row">
                                    <dt>Tạm tính</dt>
                                    <dd>@SiteContent.Vnd(_order.Subtotal)</dd>
                                </div>
                                <div class="row">
                                    <dt>Phí vận chuyển</dt>
                                    <dd>@SiteContent.Vnd(_order.ShippingFee)</dd>
                                </div>
                                <div class="row">
                                    <dt>Giảm giá</dt>
                                    <dd style="color:var(--green)">-@SiteContent.Vnd(_order.Discount)</dd>
                                </div>
                                <div class="total">
                                    <dt>Tổng cộng</dt>
                                    <dd>@SiteContent.Vnd(_order.Total)</dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private string _code = SiteContent.SampleOrderCode;
    private SiteContent.TrackedOrder? _order = SiteContent.SampleOrder;
    private bool _notFound;

    // Lookup against the single fixture order. Replaced by a query that also asserts
    // ownership of the order — see .claude/rules/security.md.
    private void Search()
    {
        var match = string.Equals(_code?.Trim(), SiteContent.SampleOrderCode, StringComparison.OrdinalIgnoreCase);

        _order = match ? SiteContent.SampleOrder : null;
        _notFound = !match;
    }

    private string ProgressWidth
    {
        get
        {
            if (_order is null || _order.Steps.Length < 2)
            {
                return "0%";
            }

            var reached = Math.Max(0, _order.Steps.Count(s => s.Reached) - 1);
            return $"{reached * 100 / (_order.Steps.Length - 1)}%";
        }
    }

    // Display-only mapping from the fixture's Material Symbol icon names to NfIcon
    // glyph names — added for the redesign, no fixture change (SiteContent.cs untouched).
    private static string StepGlyph(string materialIcon) => materialIcon switch
    {
        "inventory_2" => "receipt",
        "local_shipping" => "truck",
        "task_alt" => "check",
        _ => "clock"
    };
}
