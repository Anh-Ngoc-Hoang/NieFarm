@page "/dang-nhap"
@layout AuthLayout

<PageTitle>Đăng nhập - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@*
    NieFarm 2.0 restyle (docs/plans/public-site-redesign-nf2.md §7, step 5.1) —
    markup/classes only. The form still POSTs to the Razor Page that owns
    SignInManager (a Blazor EditForm cannot set the auth cookie, because the
    circuit has no HTTP response) — action, input names, the RememberMe value
    and the hidden ReturnUrl field are all untouched.
*@

<div class="auth">

    <FarmStoryPanel />

    <main class="auth__main">
        <a class="auth__mobile-word wordmark" href="/">Nie<em>Farm</em></a>

        <div class="auth__panel">
            <h2>Đăng nhập</h2>
            <p class="lede">Đăng nhập để xem lịch sử đơn hàng của bạn.</p>

            @if (Error is not null)
            {
                <div class="alert alert--error" style="margin-bottom:1.5rem" role="alert">
                    <p>@ErrorMessage</p>
                </div>
            }

            <form action="/pages/tai-khoan/dang-nhap" method="post" class="auth__form">
                <input type="hidden" name="ReturnUrl" value="@ReturnUrl" />

                <div>
                    <label class="nf-label" for="Email">Email</label>
                    <input id="Email" name="Email" type="email" required autofocus autocomplete="username"
                           value="@Email" placeholder="ban@vidu.vn" class="nf-field" />
                </div>

                <div>
                    <label class="nf-label" for="Password">Mật khẩu</label>
                    <input id="Password" name="Password" type="password" required autocomplete="current-password"
                           placeholder="••••••••" class="nf-field" />
                </div>

                <label class="auth__remember">
                    <input type="checkbox" name="RememberMe" value="true" />
                    Ghi nhớ đăng nhập
                </label>

                <button type="submit" class="btn btn--red btn--block">
                    <span>Đăng nhập</span>
                    <NfIcon Name="arrow-right" Size="18" />
                </button>
            </form>

            <p class="auth__switch">
                Chưa có tài khoản?
                <a class="auth__link" href="/dang-ky">Đăng ký ngay</a>
            </p>

            <a class="auth__back" href="/">
                <NfIcon Name="arrow-right" Size="16" />
                Quay lại trang chủ
            </a>
        </div>
    </main>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string ErrorMessage => Error switch
    {
        "locked" => "Tài khoản tạm thời bị khóa do đăng nhập sai nhiều lần. Vui lòng thử lại sau.",
        _ => "Email hoặc mật khẩu không đúng. Vui lòng thử lại."
    };
}
