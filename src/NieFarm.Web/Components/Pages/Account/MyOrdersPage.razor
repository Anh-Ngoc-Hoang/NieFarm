@page "/tai-khoan/don-hang"
@attribute [Authorize]
@using NieFarm.Application.Features.Orders.Dtos
@using NieFarm.Application.Features.Orders.Queries
@using NieFarm.Domain.Enums
@inject ISender Sender

@*
    Markup-only rewrite onto NieFarm 2.0 (docs/plans/public-site-redesign-nf2.md
    §7, step 4.3). OnInitializedAsync and StatusPillClass are unchanged; the
    latter now returns one of nf-pages.css's ".badge-status--ok/--pending/
    --cancelled" modifiers instead of Tailwind utility classes. The ownership
    scoping (GetMyOrdersQuery only ever returns the signed-in user's own
    orders) lives in the handler and is untouched — see security.md.
*@

<PageTitle>Đơn hàng của tôi - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="acct">
    <div class="shell">
        <div class="acct__head">
            <h1>Đơn hàng của tôi</h1>
            <p class="lede" style="margin-top:.5rem">Theo dõi tình trạng và lịch sử các đơn hàng đã đặt.</p>
        </div>

        @if (_orders is null)
        {
            <div style="display:grid;gap:1rem">
                @for (var i = 0; i < 3; i++)
                {
                    <div style="height:6rem;border-radius:var(--r-sm);background:var(--tint)"></div>
                }
            </div>
        }
        else if (_orders.Count == 0)
        {
            <div class="acct__empty">
                <NfIcon Name="cart" Size="40" CssClass="acct__empty-icon" />
                <p class="muted" style="margin:1rem 0 1.5rem">Bạn chưa có đơn hàng nào.</p>
                <a class="btn btn--red" href="/cua-hang"><span>Mua sắm ngay</span></a>
            </div>
        }
        else
        {
            <ul class="acct__list">
                @foreach (var order in _orders)
                {
                    <li>
                        <a href="/tai-khoan/don-hang/@order.Id" class="acct__row">
                            <div class="acct__row-in">
                                <div>
                                    <p class="acct__row-code">Mã đơn: <b>@order.Code</b></p>
                                    <p class="acct__row-meta">
                                        Ngày đặt: @order.PlacedAt.ToString("dd/MM/yyyy") · @order.ItemCount sản phẩm
                                    </p>
                                </div>
                                <div class="acct__row-right">
                                    <span class="badge-status @StatusPillClass(order.Status)">
                                        @OrderStatusText.Vi(order.Status)
                                    </span>
                                    <span class="acct__row-total">@SiteContent.Vnd(order.Total)</span>
                                    <NfIcon Name="arrow-right" Size="16" CssClass="acct__row-arrow" />
                                </div>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private List<MyOrderListDto>? _orders;

    // Prerendering the list is fine here — see docs/plans/customer-accounts-order-history.md §9.
    protected override async Task OnInitializedAsync()
    {
        var result = await Sender.Send(new GetMyOrdersQuery());
        _orders = result.IsSuccess ? result.Value : [];
    }

    private static string StatusPillClass(OrderStatus status) => status switch
    {
        OrderStatus.Cancelled => "badge-status--cancelled",
        OrderStatus.Completed => "badge-status--ok",
        _ => "badge-status--pending"
    };
}
