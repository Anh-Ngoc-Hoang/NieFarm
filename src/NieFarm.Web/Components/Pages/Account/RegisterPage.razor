@page "/dang-ky"
@layout AuthLayout

<PageTitle>Đăng ký - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@*
    NieFarm 2.0 restyle (docs/plans/public-site-redesign-nf2.md §7, step 5.1) —
    markup/classes only. The form still POSTs to the Razor Page that owns
    SignInManager — action, input names and the antiforgery/query-string wiring
    are all untouched.
*@

<div class="auth">

    <FarmStoryPanel />

    <main class="auth__main">
        <a class="auth__mobile-word wordmark" href="/">Nie<em>Farm</em></a>

        <div class="auth__panel">
            <h2>Đăng ký tài khoản</h2>
            <p class="lede">Tạo tài khoản để lưu và theo dõi đơn hàng của bạn.</p>

            @if (Error is not null)
            {
                <div class="alert alert--error" style="margin-bottom:1.5rem" role="alert">
                    <p>@Error</p>
                </div>
            }

            <form action="/pages/tai-khoan/dang-ky" method="post" class="auth__form">
                <div>
                    <label class="nf-label" for="FullName">Họ và tên</label>
                    <input id="FullName" name="FullName" type="text" required autofocus
                           value="@FullName" placeholder="Nhập họ và tên" class="nf-field" />
                </div>

                <div>
                    <label class="nf-label" for="Email">Email</label>
                    <input id="Email" name="Email" type="email" required autocomplete="username"
                           value="@Email" placeholder="ban@vidu.vn" class="nf-field" />
                </div>

                <div>
                    <label class="nf-label" for="PhoneNumber">Số điện thoại (không bắt buộc)</label>
                    <input id="PhoneNumber" name="PhoneNumber" type="tel"
                           value="@Phone" placeholder="Nhập số điện thoại" class="nf-field" />
                </div>

                <div>
                    <label class="nf-label" for="Password">Mật khẩu</label>
                    <input id="Password" name="Password" type="password" required autocomplete="new-password"
                           placeholder="••••••••" class="nf-field" />
                    <p class="muted" style="font-size:var(--fs-xs);margin-top:.5rem">
                        Ít nhất 8 ký tự, gồm chữ hoa, chữ thường và số.
                    </p>
                </div>

                <div>
                    <label class="nf-label" for="ConfirmPassword">Xác nhận mật khẩu</label>
                    <input id="ConfirmPassword" name="ConfirmPassword" type="password" required autocomplete="new-password"
                           placeholder="••••••••" class="nf-field" />
                </div>

                <button type="submit" class="btn btn--red btn--block">
                    <span>Đăng ký</span>
                    <NfIcon Name="arrow-right" Size="18" />
                </button>
            </form>

            <p class="auth__switch">
                Đã có tài khoản?
                <a class="auth__link" href="/dang-nhap">Đăng nhập</a>
            </p>

            <a class="auth__back" href="/">
                <NfIcon Name="arrow-right" Size="16" />
                Quay lại trang chủ
            </a>
        </div>
    </main>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Email { get; set; }
    [SupplyParameterFromQuery] public string? FullName { get; set; }
    [SupplyParameterFromQuery] public string? Phone { get; set; }
}
