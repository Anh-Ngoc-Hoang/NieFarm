@page "/tai-khoan/don-hang/{Id:int}"
@attribute [Authorize]
@using Ardalis.Result
@using NieFarm.Application.Features.Orders
@using NieFarm.Application.Features.Orders.Commands
@using NieFarm.Application.Features.Orders.Dtos
@using NieFarm.Application.Features.Orders.Queries
@using NieFarm.Domain.Enums
@implements IDisposable
@inject ISender Sender
@inject NavigationManager Navigation
@inject NieFarm.Web.Services.Orders.PaymentStatusNotifier PaymentNotifier

@*
    Markup-only rewrite onto NieFarm 2.0 (docs/plans/public-site-redesign-nf2.md
    §7, step 4.3). OnParametersSetAsync is unchanged — including the
    !result.IsSuccess -> Navigation.NotFound() branch that covers both "does
    not exist" and "belongs to someone else", so this can never be used to
    enumerate other customers' order ids (security.md). Reuses the
    ".nf-track__panel"/".nf-track__meta"/".nf-track__lines"/".nf-track__totals"
    shapes from OrderLookup.razor's own section of nf-pages.css rather than
    duplicating them.

    Order workflow (docs/plans/R-07-order-workflow.md): the status pill now follows the status (it used
    to be a fixed green), the header carries the OrderTrackProgress rail, and a New order can be
    cancelled through CancelMyOrderCommand (ownership is enforced server-side by MyOrderByIdSpec).

    D18 live status: once the query has succeeded (the caller owns the order) the page subscribes to
    PaymentStatusNotifier in OnAfterRender and, on an event, re-runs GetMyOrderDetailQuery. Disposed
    with the component and re-subscribed when the order code changes.
*@

<PageTitle>@(_order is null ? "Đơn hàng" : $"Đơn hàng {_order.Code}") - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (_order is not null)
{
    <div class="nf-track">
        <div class="shell">
            <a href="/tai-khoan/don-hang" class="nf-track__back">
                <NfIcon Name="arrow-right" Size="16" />
                Quay lại danh sách đơn hàng
            </a>

            <div class="nf-track__result" style="margin-top:0">

                @* Header *@
                <div class="nf-track__panel">
                    <p class="sr-only" aria-live="polite">@(_justPaid ? PaidText : "")</p>
                    <div class="nf-track__head" style="margin-bottom:0">
                        <div>
                            <h1 style="font-size:var(--fs-h3)">Mã đơn: <span class="nf-track__code">@_order.Code</span></h1>
                            <p class="muted" style="font-size:var(--fs-sm);margin-top:.3rem">
                                Ngày đặt: @VnTime.FromUtc(_order.PlacedAt).ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>
                        <span class="badge-status @OrderStatusText.PillClass(_order.Status)">@OrderStatusText.Vi(_order.Status)</span>
                    </div>

                    <div style="margin-top:2rem">
                        <OrderTrackProgress Status="_order.Status" Timeline="_order.Timeline" />
                    </div>

                    @* Payment (R-01): same states as the order lookup. *@
                    @if (_order.BankTransfer is not null)
                    {
                        <BankTransferPanel Instructions="_order.BankTransfer" />
                        <p class="nf-pay__note">Nie Farm sẽ giao hàng sau khi nhận được chuyển khoản của bạn.</p>
                    }
                    else if (_order.PaymentMethod == PaymentMethod.BankTransfer
                             && _order.PaymentStatus == PaymentStatus.AwaitingPayment
                             && _order.Status != OrderStatus.Cancelled)
                    {
                        <p class="nf-pay__unavailable" role="status">Thông tin chuyển khoản đang được cập nhật. Vui lòng liên hệ Nie Farm để được hỗ trợ.</p>
                    }
                    else if (_order.PaymentStatus == PaymentStatus.Paid)
                    {
                        <p class="nf-track__ok">@PaidText</p>
                    }
                    else if (_order.PaymentStatus == PaymentStatus.RefundDue)
                    {
                        <p class="nf-track__ok" role="status">Đơn hàng đã hủy. Nie Farm sẽ liên hệ để hoàn tiền cho bạn.</p>
                    }
                    else if (_order.PaymentStatus == PaymentStatus.Refunded)
                    {
                        <p class="nf-track__ok" role="status">Nie Farm đã hoàn tiền cho đơn hàng này.</p>
                    }

                    @if (_order.CanCancel)
                    {
                        <OrderCancelForm Code="@_order.Code" Busy="_cancelBusy" Error="@_cancelError" OnConfirm="CancelAsync"
                                         Warning="@(_order.PaymentMethod == PaymentMethod.BankTransfer && _order.PaymentStatus == PaymentStatus.AwaitingPayment ? OrderLookupMessages.CancelAfterTransferWarning : null)" />
                    }

                    @if (_cancelNotice is not null)
                    {
                        <p class="nf-track__ok" role="status">@_cancelNotice</p>
                    }
                </div>

                <div class="nf-track__cols">

                    @* Recipient *@
                    <div class="nf-track__panel">
                        <h2 class="nf-track__panel-title"><NfIcon Name="user" Size="18" /> Thông tin người nhận</h2>
                        <dl class="nf-track__meta">
                            <div>
                                <dt>Họ và tên</dt>
                                <dd>@_order.CustomerName</dd>
                            </div>
                            <div>
                                <dt>Số điện thoại</dt>
                                <dd>@_order.Phone</dd>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_order.Email))
                            {
                                <div>
                                    <dt>Email</dt>
                                    <dd>@_order.Email</dd>
                                </div>
                            }
                            <div>
                                <dt>Địa chỉ giao hàng</dt>
                                <dd>@_order.ShippingAddress</dd>
                            </div>
                            <div>
                                <dt>Phương thức thanh toán</dt>
                                <dd>@OrderStatusText.Vi(_order.PaymentMethod)</dd>
                            </div>
                            @if (_order.PaymentMethod == PaymentMethod.BankTransfer)
                            {
                                <div>
                                    <dt>Thanh toán</dt>
                                    <dd><span class="badge-status @OrderStatusText.PaymentPillClass(_order.PaymentStatus)">@OrderStatusText.Vi(_order.PaymentStatus)</span></dd>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(_order.Note))
                            {
                                <div>
                                    <dt>Ghi chú</dt>
                                    <dd>@_order.Note</dd>
                                </div>
                            }
                        </dl>
                    </div>

                    @* Lines + totals *@
                    <div style="display:grid;gap:clamp(1.5rem,3vw,2rem)">
                        <div class="nf-track__panel">
                            <h2 class="nf-track__panel-title"><NfIcon Name="cart" Size="18" /> Chi tiết sản phẩm</h2>

                            <ul class="nf-track__lines">
                                @foreach (var line in _order.Lines)
                                {
                                    <li class="nf-track__line">
                                        <div class="nf-track__line-media">
                                            <img src="@line.ImageUrl" alt="@line.ProductName" />
                                        </div>
                                        <div class="nf-track__line-body">
                                            <div class="nf-track__line-row">
                                                <div>
                                                    <p class="nf-track__line-name">@line.ProductName</p>
                                                    <p class="nf-track__line-meta">Phân loại: @line.Variant</p>
                                                </div>
                                                <span class="nf-track__line-price">@SiteContent.Vnd(line.UnitPrice)</span>
                                            </div>
                                            <p class="nf-track__line-qty">
                                                Số lượng: <b>x@(line.Quantity)</b>
                                            </p>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="nf-track__panel">
                            <dl class="nf-track__totals">
                                <div class="row">
                                    <dt>Tạm tính</dt>
                                    <dd>@SiteContent.Vnd(_order.Subtotal)</dd>
                                </div>
                                <div class="row">
                                    <dt>Phí vận chuyển@(string.IsNullOrWhiteSpace(_order.ShippingZoneName) ? null : $" ({_order.ShippingZoneName})")</dt>
                                    <dd>@(_order.ShippingFee == 0m ? "Miễn phí" : SiteContent.Vnd(_order.ShippingFee))</dd>
                                </div>
                                @if (_order.Discount > 0m)
                                {
                                    <div class="row">
                                        <dt>Giảm giá@(string.IsNullOrWhiteSpace(_order.CouponCode) ? null : $" ({_order.CouponCode})")</dt>
                                        <dd style="color:var(--green)">-@SiteContent.Vnd(_order.Discount)</dd>
                                    </div>
                                }
                                <div class="total">
                                    <dt>Tổng cộng</dt>
                                    <dd>@SiteContent.Vnd(_order.Total)</dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    // One visible sentence; the sr-only aria-live region above is the only announcer.
    private string PaidText =>
        _order?.PaidAtUtc is { } paidAt
            ? $"Nie Farm đã nhận được thanh toán của bạn lúc {VnTime.FromUtc(paidAt):dd/MM/yyyy HH:mm}"
            : "Nie Farm đã nhận được thanh toán của bạn.";

    [Parameter] public int Id { get; set; }

    private IDisposable? _subscription;
    private string? _subscribedCode;
    private bool _justPaid;

    private readonly CancellationTokenSource _cts = new();
    private MyOrderDetailDto? _order;
    private bool _cancelBusy;
    private string? _cancelError;
    private string? _cancelNotice;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Sender.Send(new GetMyOrderDetailQuery(Id));

        if (!result.IsSuccess)
        {
            // Covers both "does not exist" and "belongs to someone else" — a real 404 either
            // way, so this can never be used to enumerate other customers' order ids.
            Navigation.NotFound();
            return;
        }

        if (_order is not null && _order.Code != result.Value.Code)
            _justPaid = false;
        _order = result.Value;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // The query succeeded, so the caller owns this order. Only an unpaid bank transfer can still
        // change; re-subscribe when the order (code) changes. OnAfterRender never runs in a prerender.
        var wanted = _order is { PaymentMethod: PaymentMethod.BankTransfer, PaymentStatus: PaymentStatus.AwaitingPayment }
            ? _order.Code
            : null;
        if (string.Equals(_subscribedCode, wanted, StringComparison.Ordinal))
            return;

        UnsubscribeFromPayment();
        _subscribedCode = wanted;
        if (wanted is not null)
        {
            var id = Id;
            _subscription = PaymentNotifier.Subscribe(wanted, status => OnPaymentStatusAsync(status, id, wanted));
        }
    }

    private void UnsubscribeFromPayment()
    {
        _subscription?.Dispose();
        _subscription = null;
        _subscribedCode = null;
    }

    private Task OnPaymentStatusAsync(PaymentStatus status, int id, string code) =>
        InvokeAsync(async () =>
        {
            if (_cts.IsCancellationRequested || id != Id || _order?.Code != code) return;

            // Re-run the page's own owner-scoped query; the event carries no order data.
            var refreshed = await Sender.Send(new GetMyOrderDetailQuery(id), _cts.Token);

            // Id or order may have changed while the query was in flight; drop stale results.
            if (!refreshed.IsSuccess || _cts.IsCancellationRequested
                || id != Id || _order?.Code != code || refreshed.Value.Code != code) return;

            _order = refreshed.Value;
            if (status == PaymentStatus.Paid && _order.PaymentStatus == PaymentStatus.Paid)
                _justPaid = true;
            StateHasChanged();
        });

    private async Task CancelAsync(string? reason)
    {
        if (_cancelBusy) return;
        _cancelBusy = true;
        _cancelError = null;
        _cancelNotice = null;

        try
        {
            var result = await Sender.Send(new CancelMyOrderCommand(Id, reason), _cts.Token);

            if (result.IsSuccess || result.Status == ResultStatus.Conflict)
            {
                var refreshed = await Sender.Send(new GetMyOrderDetailQuery(Id), _cts.Token);
                if (refreshed.IsSuccess)
                    _order = refreshed.Value;

                _cancelNotice = result.IsSuccess ? "Đơn hàng đã được hủy." : OrderLookupMessages.Conflict;
            }
            else if (result.Status is ResultStatus.NotFound or ResultStatus.Unauthorized)
            {
                Navigation.NotFound();
            }
            else
            {
                _cancelError = result.ValidationErrors.Select(v => v.ErrorMessage)
                    .Concat(result.Errors)
                    .FirstOrDefault(m => !string.IsNullOrWhiteSpace(m))
                    ?? "Đã có lỗi xảy ra. Vui lòng thử lại.";
            }
        }
        catch (OperationCanceledException)
        {
            // Circuit disposed mid-command; nothing to show.
        }
        catch (Exception)
        {
            _cancelError = "Đã có lỗi xảy ra. Vui lòng thử lại.";
        }
        finally
        {
            _cancelBusy = false;
        }
    }

    public void Dispose()
    {
        UnsubscribeFromPayment();
        _cts.Cancel();
        _cts.Dispose();
    }
}
