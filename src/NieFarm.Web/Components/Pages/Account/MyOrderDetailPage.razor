@page "/tai-khoan/don-hang/{Id:int}"
@attribute [Authorize]
@using NieFarm.Application.Features.Orders.Dtos
@using NieFarm.Application.Features.Orders.Queries
@inject ISender Sender
@inject NavigationManager Navigation

@*
    Markup-only rewrite onto NieFarm 2.0 (docs/plans/public-site-redesign-nf2.md
    §7, step 4.3). OnParametersSetAsync is unchanged — including the
    !result.IsSuccess -> Navigation.NotFound() branch that covers both "does
    not exist" and "belongs to someone else", so this can never be used to
    enumerate other customers' order ids (security.md). Reuses the
    ".nf-track__panel"/".nf-track__meta"/".nf-track__lines"/".nf-track__totals"
    shapes from OrderLookup.razor's own section of nf-pages.css rather than
    duplicating them. The status pill is a fixed "--ok" green, matching the
    original markup's own (unvaried) behaviour byte-for-byte.
*@

<PageTitle>@(_order is null ? "Đơn hàng" : $"Đơn hàng {_order.Code}") - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

@if (_order is not null)
{
    <div class="nf-track">
        <div class="shell">
            <a href="/tai-khoan/don-hang" class="nf-track__back">
                <NfIcon Name="arrow-right" Size="16" />
                Quay lại danh sách đơn hàng
            </a>

            <div class="nf-track__result" style="margin-top:0">

                @* Header *@
                <div class="nf-track__panel">
                    <div class="nf-track__head" style="margin-bottom:0">
                        <div>
                            <h1 style="font-size:var(--fs-h3)">Mã đơn: <span class="nf-track__code">@_order.Code</span></h1>
                            <p class="muted" style="font-size:var(--fs-sm);margin-top:.3rem">
                                Ngày đặt: @VnTime.FromUtc(_order.PlacedAt).ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>
                        <span class="badge-status badge-status--ok">@OrderStatusText.Vi(_order.Status)</span>
                    </div>
                </div>

                <div class="nf-track__cols">

                    @* Recipient *@
                    <div class="nf-track__panel">
                        <h2 class="nf-track__panel-title"><NfIcon Name="user" Size="18" /> Thông tin người nhận</h2>
                        <dl class="nf-track__meta">
                            <div>
                                <dt>Họ và tên</dt>
                                <dd>@_order.CustomerName</dd>
                            </div>
                            <div>
                                <dt>Số điện thoại</dt>
                                <dd>@_order.Phone</dd>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_order.Email))
                            {
                                <div>
                                    <dt>Email</dt>
                                    <dd>@_order.Email</dd>
                                </div>
                            }
                            <div>
                                <dt>Địa chỉ giao hàng</dt>
                                <dd>@_order.ShippingAddress</dd>
                            </div>
                            <div>
                                <dt>Phương thức thanh toán</dt>
                                <dd>@OrderStatusText.Vi(_order.PaymentMethod)</dd>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_order.Note))
                            {
                                <div>
                                    <dt>Ghi chú</dt>
                                    <dd>@_order.Note</dd>
                                </div>
                            }
                        </dl>
                    </div>

                    @* Lines + totals *@
                    <div style="display:grid;gap:clamp(1.5rem,3vw,2rem)">
                        <div class="nf-track__panel">
                            <h2 class="nf-track__panel-title"><NfIcon Name="cart" Size="18" /> Chi tiết sản phẩm</h2>

                            <ul class="nf-track__lines">
                                @foreach (var line in _order.Lines)
                                {
                                    <li class="nf-track__line">
                                        <div class="nf-track__line-media">
                                            <img src="@line.ImageUrl" alt="@line.ProductName" />
                                        </div>
                                        <div class="nf-track__line-body">
                                            <div class="nf-track__line-row">
                                                <div>
                                                    <p class="nf-track__line-name">@line.ProductName</p>
                                                    <p class="nf-track__line-meta">Phân loại: @line.Variant</p>
                                                </div>
                                                <span class="nf-track__line-price">@SiteContent.Vnd(line.UnitPrice)</span>
                                            </div>
                                            <p class="nf-track__line-qty">
                                                Số lượng: <b>x@(line.Quantity)</b>
                                            </p>
                                        </div>
                                    </li>
                                }
                            </ul>
                        </div>

                        <div class="nf-track__panel">
                            <dl class="nf-track__totals">
                                <div class="row">
                                    <dt>Tạm tính</dt>
                                    <dd>@SiteContent.Vnd(_order.Subtotal)</dd>
                                </div>
                                <div class="row">
                                    <dt>Phí vận chuyển</dt>
                                    <dd>@SiteContent.Vnd(_order.ShippingFee)</dd>
                                </div>
                                <div class="row">
                                    <dt>Giảm giá</dt>
                                    <dd style="color:var(--green)">-@SiteContent.Vnd(_order.Discount)</dd>
                                </div>
                                <div class="total">
                                    <dt>Tổng cộng</dt>
                                    <dd>@SiteContent.Vnd(_order.Total)</dd>
                                </div>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private MyOrderDetailDto? _order;

    protected override async Task OnParametersSetAsync()
    {
        var result = await Sender.Send(new GetMyOrderDetailQuery(Id));

        if (!result.IsSuccess)
        {
            // Covers both "does not exist" and "belongs to someone else" — a real 404 either
            // way, so this can never be used to enumerate other customers' order ids.
            Navigation.NotFound();
            return;
        }

        _order = result.Value;
    }
}
