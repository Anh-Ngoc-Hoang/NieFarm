@page "/dat-hang-thanh-cong/{Code}"
@using Microsoft.AspNetCore.Components.Authorization

@*
    Markup-only rewrite onto NieFarm 2.0 (docs/plans/public-site-redesign-nf2.md
    §7, step 4.3). No @code logic at all beyond the [Parameter] — the
    AuthorizeView gate that shows "Xem đơn hàng của tôi" only to a signed-in
    customer is unchanged.
*@

<PageTitle>Đặt hàng thành công - Nie Farm Việt Nam</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="acct-confirm">
    <div class="shell" style="max-width:34rem">
        <span class="acct-confirm__icon"><NfIcon Name="check" Size="28" /></span>

        <h1 style="margin-top:1.5rem">Đặt hàng thành công!</h1>
        <p class="lede" style="margin:.75rem auto 0">
            Cảm ơn bạn đã đặt hàng tại Nie Farm. Mã đơn hàng của bạn là:
        </p>

        <p class="acct-confirm__code">@Code</p>
        <p class="muted" style="font-size:var(--fs-sm);margin:0 auto 1.5rem">
            Hãy lưu lại mã đơn hàng. Bạn có thể tra cứu đơn bằng mã này cùng số điện thoại đã dùng khi đặt hàng.
        </p>

        <div style="display:flex;flex-wrap:wrap;gap:1rem;justify-content:center">
            <a href="/tra-cuu-don-hang?ma=@Uri.EscapeDataString(Code)" class="btn btn--ghost"><span>Tra cứu đơn hàng</span></a>
            <AuthorizeView>
                <Authorized>
                    <a href="/tai-khoan/don-hang" class="btn btn--red"><span>Xem đơn hàng của tôi</span></a>
                </Authorized>
            </AuthorizeView>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Code { get; set; } = string.Empty;
}
