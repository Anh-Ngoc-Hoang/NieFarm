@page "/"
@using System.Globalization
@using NieFarm.Application.Features.CoffeeRegions.Dtos
@using NieFarm.Application.Features.CoffeeRegions.Queries
@using NieFarm.Application.Features.Crops.Dtos
@using NieFarm.Application.Features.Crops.Queries
@using NieFarm.Application.Features.Products.Dtos
@using NieFarm.Application.Features.Products.Queries
@using NieFarm.Application.Features.Testimonials.Dtos
@using NieFarm.Application.Features.Testimonials.Queries
@using NieFarm.Application.Features.Partners.Dtos
@using NieFarm.Application.Features.Partners.Queries
@inject ISender Sender

@*
    Full redesign onto the NieFarm 2.0 "journey" idiom shared with /quy-trinh — hairlines,
    self-drawing glyphs, a rail-free "farm-to-cup" teaser — instead of the old skewed-wedge/plain
    grid layout (docs/plans/home-redesign-crop-testimonials.md, Phase 6). New Crop and
    Testimonials are real, admin-managed aggregates (GetCurrentCropQuery/GetTestimonialsQuery);
    Featured products switch from the SiteContent fixture to GetHomeFeaturedProductsQuery, which
    reads Product.IsFeatured. Hero copy, the vision/mission points and the process teaser stay
    SiteContent fixtures (D nothing changed there — out of scope for this plan). "New Crop" is
    the one deliberately-English heading on an otherwise Vietnamese public page.

    [PersistentState] carries the five query results across the prerender -> interactive hop
    (D12) so the New Crop section never disappears and re-fades on connect — Data ??= is what
    makes the second (interactive) OnInitializedAsync a no-op when the prerendered state
    round-tripped successfully; a failed deserialisation just falls back to re-querying.

    Classes below are all "h…"-prefixed and never reuse ".journey"/".stage"/".stages"/".rail*" —
    nf-motion.js binds the /quy-trinh scroll-progress rail to those selectors globally, and
    reusing them here would silently switch on that code for this page too.
*@

<PageTitle>Nie Farm Việt Nam - Nâng Tầm Vị Thế Cà Phê Việt Nam</PageTitle>
<HeadContent>
    <meta name="description"
          content="Nie Farm Việt Nam mang đến giải pháp toàn diện cho quy trình chế biến và nâng cao chất lượng hạt cà phê nhân xanh, hướng tới nền nông nghiệp bền vững." />
</HeadContent>

@* ============================ HERO ============================ *@
<section class="jhero">
    <div class="shell jhero__grid">
        <div>
            <p class="eyebrow" data-reveal="fade">Nie Farm Việt Nam</p>
            <h1 class="jhero__title jhero__title--long" data-reveal style="--d:.08s">
                Nâng tầm vị thế
                <span class="accent">cà phê Việt Nam</span>
            </h1>
            <p class="lede" data-reveal="fade">
                Mang đến những giải pháp toàn diện cho quy trình chế biến và nâng cao chất lượng hạt cà
                phê nhân xanh, hướng tới một nền nông nghiệp bền vững và chuyên nghiệp.
            </p>

            <div class="hhero__ctas">
                @if (Data?.Crop is not null)
                {
                    <a class="btn btn--red" href="#vu-moi"><span>Khám phá vụ mùa mới</span></a>
                }
                else
                {
                    <a class="btn btn--red" href="#tam-nhin"><span>Khám phá ngay</span></a>
                }
                <a class="btn btn--ghost" href="/cua-hang"><span>Xem cửa hàng</span></a>
            </div>

            <div class="scrollcue"><i></i> Cuộn để khám phá</div>
        </div>

        <figure class="hhero__photo hhero__photo--portrait" data-reveal="mask" style="--d:.15s">
            <img src="/images/quy-trinh-hero.jpg" width="896" height="1200" fetchpriority="high"
                 alt="Chùm quả cà phê chín đỏ trên cành giữa đồi cao nguyên phủ sương" />
        </figure>
    </div>
</section>

@* ============================ NEW CROP ============================ *@
@if (Data?.Crop is { } crop)
{
    <section class="section hcrop" id="vu-moi">
        <div class="shell hcrop__grid">
            <div class="hcrop__media" data-reveal="mask">
                <figure class="hcrop__photo">
                    <img src="@crop.ImageUrl" width="1200" height="896" loading="lazy" alt="@crop.ImageAlt" />
                </figure>
                <span class="hcrop__season"><NfIcon Name="calendar" Size="14" /> @crop.SeasonLabel</span>
                <div class="hcrop__glyph">
                    <NfIcon Name="cherries" Size="44" Draw="true" />
                </div>
            </div>

            <div class="hcrop__text">
                <p class="eyebrow" data-reveal="fade">Vụ thu hoạch · @crop.SeasonLabel</p>
                <h2 class="hcrop__title" lang="en" data-reveal>New Crop <span class="accent">@crop.Year</span></h2>
                <p class="hcrop__headline accent">@crop.Headline</p>

                <div class="hcrop__story">
                    @foreach (var paragraph in crop.StoryParagraphs)
                    {
                        <p>@paragraph</p>
                    }
                </div>

                @{ var facts = CropFacts(crop); }
                @if (facts.Count > 0)
                {
                    <dl class="hcrop__facts">
                        @foreach (var fact in facts)
                        {
                            <div>
                                <dt>@fact.Label</dt>
                                <dd>@fact.Value</dd>
                            </div>
                        }
                    </dl>
                }

                @if (crop.TastingNotes.Count > 0)
                {
                    <div>
                        <p class="eyebrow eyebrow--plain">Hương vị</p>
                        <ul class="hcrop__notes">
                            @foreach (var note in crop.TastingNotes)
                            {
                                <li class="hcrop__note">@note</li>
                            }
                        </ul>
                    </div>
                }

                @if (crop.Products.Count > 0)
                {
                    <div class="hcrop__shop">
                        <p class="eyebrow">Mua từ vụ mùa này</p>
                        <ul class="hcrop__shop-list">
                            @foreach (var product in crop.Products)
                            {
                                <li>
                                    <a class="hcrop__item" href="@($"/san-pham/{product.Slug}")">
                                        <span class="hcrop__item-media">
                                            <img src="@product.ImageUrl" alt="@product.ImageAlt" loading="lazy" />
                                        </span>
                                        <span class="hcrop__item-body">
                                            <span>@product.Name</span>
                                            <span>@Money.Vnd(product.Price)</span>
                                        </span>
                                        <NfIcon Name="arrow-right" Size="16" />
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </section>
}

@* ============================ VISION & MISSION ============================ *@
<section class="section hmission" id="tam-nhin">
    <div class="shell hmission__grid">
        <figure class="hmission__photo" data-reveal="mask">
            <img src="/images/quy-trinh-3.jpg" width="1200" height="896" loading="lazy"
                 alt="Nông dân đội nón lá rải phân ủ từ vỏ cà phê giữa những hàng cà phê xen cây che bóng" />
        </figure>
        <div data-reveal="fade">
            <p class="eyebrow">Tầm nhìn &amp; sứ mệnh</p>
            <h2>Đồng hành cùng nông dân, <span class="accent">chuẩn hóa quy trình</span>.</h2>
            <p class="lede">
                Chúng tôi tin rằng hạt cà phê Việt Nam mang trong mình tiềm năng to lớn. Sứ mệnh của
                Nie Farm là cung cấp kiến thức, công nghệ và quy trình chuẩn quốc tế để giúp người nông
                dân tối ưu hóa giá trị trên từng hạt cà phê.
            </p>
            <ul class="hmission__points">
                @foreach (var point in SiteContent.MissionPoints)
                {
                    <li><NfIcon Name="check" Size="18" /> <span>@point</span></li>
                }
            </ul>
        </div>
    </div>
</section>

@* ============================ VIETNAM COFFEE STORIES ============================ *@
@* After the mission, before the farm-to-cup teaser (docs/plans/home-vietnam-coffee-stories.md
   D11): the mission ends on the potential of Vietnamese coffee, the map widens that to the
   country's growing regions, then the teaser narrows to Nie Farm's own eight stages. "Vietnam
   Coffee Stories" is the second deliberately-English heading on this page, after "New Crop". *@
@if (Data?.Regions.Count > 0)
{
    <section class="section hflush hstories" id="cau-chuyen-ca-phe">
        <div class="shell">
            <div class="hhead">
                <p class="eyebrow" data-reveal="fade">Bản đồ cà phê Việt Nam</p>
                <h2 class="hstories__title" lang="en" data-reveal>Vietnam Coffee <span class="accent">Stories</span></h2>
                <p class="lede" data-reveal="fade">
                    Từ những triền núi Tây Bắc đến cao nguyên đất đỏ bazan — mỗi miền một câu chuyện, một
                    hương vị. Chọn một miền trên bản đồ để khám phá.
                </p>
            </div>

            <div class="hstories__body" data-reveal="fade">
                <CoffeeStories Regions="Data.Regions" />
            </div>
        </div>
    </section>
}

@* ============================ FARM-TO-CUP TEASER ============================ *@
<section class="section hflush hjourney">
    <div class="shell">
        <div class="hhead">
            <p class="eyebrow" data-reveal="fade">Từ nông trại đến ly</p>
            <h2 data-reveal>Tám chặng, <span class="accent">một hành trình</span></h2>
            <p class="lede" data-reveal="fade">
                Mỗi túi cà phê Nie Farm đi qua tám chặng kiểm soát, từ vườn ươm trên cao nguyên đến khi
                vào ly của bạn.
            </p>
            <a class="linkline" href="/quy-trinh" data-reveal="fade">
                Đi hết hành trình <NfIcon Name="arrow-right" Size="15" />
            </a>
        </div>

        <ol class="hjourney__steps" data-reveal="fade">
            @for (var i = 0; i < SiteContent.ProcessSteps.Length; i++)
            {
                var step = SiteContent.ProcessSteps[i];
                <li class="hjourney__step" style="--step:@i">
                    <a href="@($"/quy-trinh#{step.Anchor}")">
                        <span class="hjourney__glyph">
                            <NfIcon Name="@step.Glyph" Size="36" StrokeWidth="1.6" Draw="true" />
                        </span>
                        <span class="hjourney__num">@step.Number.ToString("00")</span>
                        <span class="hjourney__label">@step.RailLabel</span>
                    </a>
                </li>
            }
        </ol>
    </div>
</section>

@* ============================ FEATURED PRODUCTS ============================ *@
@if (Data?.Featured.Count > 0)
{
    <section class="section hflush hfeat">
        <div class="shell">
            <div class="hhead hhead--center" data-reveal="fade">
                <p class="eyebrow">Sản phẩm nổi bật</p>
                <h2>Những hạt cà phê <span class="accent">tinh hoa</span></h2>
                <p class="lede">Được tuyển chọn kỹ lưỡng từ nông trại Nie Farm.</p>
            </div>

            <div class="hfeat__grid">
                @for (var i = 0; i < Data.Featured.Count; i++)
                {
                    var product = Data.Featured[i];
                    var delay = (i % 4) * 0.06;

                    <ProductCard @key="product.Id" Product="product" Delay="delay" />
                }
            </div>

            <div class="hhead--center" data-reveal="fade">
                <a class="btn btn--ghost" href="/cua-hang"><span>Xem toàn bộ cửa hàng</span></a>
            </div>
        </div>
    </section>
}

@* ============================ TESTIMONIALS ============================ *@
@if (Data?.Testimonials.Count > 0)
{
    <section class="section hflush" id="cam-nhan">
        <div class="shell hquote__shell">
            <div class="hhead hhead--center" data-reveal="fade">
                <p class="eyebrow">Cảm nhận khách hàng</p>
                <h2>Khách hàng nói gì về <span class="accent">Nie Farm</span></h2>
            </div>

            <div class="hquote" data-reveal="fade">
                <TestimonialCarousel Items="Data.Testimonials" />
            </div>
        </div>
    </section>
}

@* ============================ STRATEGIC PARTNERS ============================ *@
@* Admin-managed partners (docs/plans/home-partners-marquee.md). data-reveal sits on the static
   band wrapper only; nothing inside PartnerMarquee carries data-reveal or .draw. *@
@if (Data?.Partners.Count > 0)
{
    <section class="section hflush hpartner" aria-label="Khách hàng thân thiết">
        <div class="shell">
            <div class="hpartner__band" data-reveal="fade">
                <p class="eyebrow">Khách hàng thân thiết</p>
                <PartnerMarquee Items="Data.Partners" />
            </div>
        </div>
    </section>
}

@code {
    /// <summary>
    /// The five query results this page needs, kept as one [PersistentState] blob so the
    /// interactive render after prerendering reuses them instead of re-querying and briefly
    /// showing "no crop" while the New Crop section re-fades in (D12).
    /// </summary>
    public record HomeData(
        CurrentCropDto? Crop,
        IReadOnlyList<ProductCardDto> Featured,
        List<TestimonialDto> Testimonials,
        List<CoffeeRegionDto> Regions,
        List<PartnerDto> Partners);

    [PersistentState]
    public HomeData? Data { get; set; }

    protected override async Task OnInitializedAsync() => Data ??= await LoadAsync();

    private async Task<HomeData> LoadAsync()
    {
        // Safe to run in parallel — each handler here uses IReadRepositoryBase, which gets its
        // own DbContext per call (data-access.md).
        var cropTask = Sender.Send(new GetCurrentCropQuery());
        var featuredTask = Sender.Send(new GetHomeFeaturedProductsQuery());
        var testimonialsTask = Sender.Send(new GetTestimonialsQuery());
        var regionsTask = Sender.Send(new GetCoffeeRegionsQuery());
        var partnersTask = Sender.Send(new GetPartnersQuery());
        await Task.WhenAll(cropTask, featuredTask, testimonialsTask, regionsTask, partnersTask);

        return new HomeData(
            await cropTask, await featuredTask, await testimonialsTask, await regionsTask, await partnersTask);
    }

    private static IReadOnlyList<(string Label, string Value)> CropFacts(CurrentCropDto crop) =>
    [
        .. new[]
        {
            ("Vùng trồng", crop.Region),
            ("Độ cao", crop.Altitude),
            ("Giống", crop.Varieties),
            ("Sơ chế", crop.Process)
        }.Where(f => !string.IsNullOrWhiteSpace(f.Item2))
    ];
}
