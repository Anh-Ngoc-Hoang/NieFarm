@inherits LayoutComponentBase

<div class="nf nf-shell">
    <div class="progressbar" aria-hidden="true"></div>
    <CartInitializer />
    <SiteHeader />

    @* .nf-main's padding-top:var(--hdr-h) clears the fixed header (nf.css). *@
    <main class="nf-main">
        @Body
    </main>

    <SiteFooter />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong muốn.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">🗙</span>
</div>
