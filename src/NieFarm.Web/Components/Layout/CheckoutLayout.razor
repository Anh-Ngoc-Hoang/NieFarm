@inherits LayoutComponentBase

@*
    Transactional shell — NieFarm 2.0 chrome (docs/plans/public-site-redesign-nf2.md
    §7, step 4.1). The design drops the main navigation on checkout so nothing
    competes with completing the order: this reuses SiteHeader's own ".hdr"
    treatment with <nav> removed, keeping only the wordmark link back to "/".
    Keep <CartInitializer /> exactly where it is — it is the once-per-circuit
    cart merge, not decoration.
*@

<div class="nf nf-shell">
    <CartInitializer />
    <header class="hdr">
        <div class="shell hdr__in" style="justify-content:center">
            <a class="wordmark" href="/">Nie<em>Farm</em></a>
        </div>
    </header>

    <main class="nf-main">
        @Body
    </main>

    <SiteFooter />
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong muốn.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">🗙</span>
</div>
