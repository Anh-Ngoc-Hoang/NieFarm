@inherits LayoutComponentBase

@*
    Distraction-free shell for auth screens (login, register): no site header or
    footer, so a full-height split layout can run edge-to-edge.
*@

<div class="min-h-screen bg-cream-ivory text-on-surface antialiased">
    @Body
</div>

<div id="blazor-error-ui" data-nosnippet>
    Đã xảy ra lỗi không mong muốn.
    <a href="." class="reload">Tải lại</a>
    <span class="dismiss">🗙</span>
</div>
