@using Microsoft.AspNetCore.Components.Authorization
@using NieFarm.Web.Services.Cart
@implements IDisposable
@inject NavigationManager Navigation
@inject CartState CartState

@*
    Sticky top navigation shared by every public page — NieFarm 2.0 chrome
    (docs/plans/public-site-redesign-nf2.md §7, step 2.2). Markup only: every
    piece of @code below (NavItems, IsActive, LocationChanged, CartState.OnChange,
    _mobileMenuOpen, _userMenuOpen, DisplayName, IDisposable) is unchanged from the
    Tailwind version.
*@

<header class="hdr">
    <div class="shell hdr__in">
        <a class="wordmark" href="/">Nie<em>Farm</em></a>

        <nav class="nav">
            @foreach (var item in NavItems)
            {
                <a href="@item.Href" aria-current="@(IsActive(item) ? "page" : null)">
                    @item.Label
                </a>
            }
        </nav>

        <div class="hdr__actions">
            <a class="iconbtn hdr__cart" href="/thanh-toan" aria-label="Giỏ hàng (@CartState.Count sản phẩm)">
                <NfIcon Name="cart" Size="19" />
                @if (CartState.Count > 0)
                {
                    <span class="hdr__cart-badge">@CartState.Count</span>
                }
            </a>

            <AuthorizeView>
                <Authorized>
                    <div class="hdr__user">
                        <button type="button" class="hdr__user-btn"
                                aria-haspopup="true" aria-expanded="@_userMenuOpen" @onclick="ToggleUserMenu">
                            <NfIcon Name="user" Size="18" />
                            <span class="hdr__user-name">@DisplayName(context)</span>
                            <NfIcon Name="chevron-down" Size="14" CssClass="@(_userMenuOpen ? "hdr__user-caret hdr__user-caret--up" : "hdr__user-caret")" />
                        </button>
                        @if (_userMenuOpen)
                        {
                            @* Full-viewport click-catcher so clicking anywhere outside the menu closes it. *@
                            <div class="hdr__user-scrim" @onclick="CloseUserMenu"></div>
                            <div class="hdr__user-menu">
                                <a href="/tai-khoan" @onclick="CloseUserMenu">
                                    <NfIcon Name="user" Size="18" />
                                    Tài khoản của tôi
                                </a>
                                <a href="/tai-khoan/don-hang" @onclick="CloseUserMenu">
                                    <NfIcon Name="receipt" Size="18" />
                                    Đơn hàng của tôi
                                </a>
                                <AuthorizeView Roles="Admin,SuperAdmin" Context="adminContext">
                                    <a href="/admin" @onclick="CloseUserMenu">
                                        <NfIcon Name="shield" Size="18" />
                                        Trang quản trị
                                    </a>
                                </AuthorizeView>
                                @* Full page load: sign-out must reach the Razor Page that clears the cookie. *@
                                <a href="/pages/tai-khoan/dang-xuat" data-enhance-nav="false">
                                    <NfIcon Name="logout" Size="18" />
                                    Đăng xuất
                                </a>
                            </div>
                        }
                    </div>
                </Authorized>
                <NotAuthorized>
                    <a class="hdr__login" href="/dang-nhap">
                        <NfIcon Name="user" Size="18" />
                        Đăng nhập
                    </a>
                </NotAuthorized>
            </AuthorizeView>

            <button type="button" class="iconbtn hdr__burger" aria-label="Mở menu"
                    aria-expanded="@_mobileMenuOpen" @onclick="ToggleMobileMenu">
                <NfIcon Name="@(_mobileMenuOpen ? "close" : "menu")" Size="20" />
            </button>
        </div>
    </div>

    @* Mobile drawer — the desktop nav collapses to a stacked list below the ".nav" breakpoint. *@
    @if (_mobileMenuOpen)
    {
        <nav class="hdr__drawer">
            @foreach (var item in NavItems)
            {
                <a href="@item.Href" aria-current="@(IsActive(item) ? "page" : null)" @onclick="CloseMobileMenu">
                    @item.Label
                </a>
            }
            <AuthorizeView>
                <Authorized>
                    <a href="/tai-khoan" @onclick="CloseMobileMenu">
                        <NfIcon Name="user" Size="18" />
                        Tài khoản của tôi
                    </a>
                    <a href="/tai-khoan/don-hang" @onclick="CloseMobileMenu">
                        <NfIcon Name="receipt" Size="18" />
                        Đơn hàng của tôi
                    </a>
                    <AuthorizeView Roles="Admin,SuperAdmin" Context="adminContext">
                        <a href="/admin" @onclick="CloseMobileMenu">
                            <NfIcon Name="shield" Size="18" />
                            Trang quản trị
                        </a>
                    </AuthorizeView>
                    <a href="/pages/tai-khoan/dang-xuat" data-enhance-nav="false">
                        <NfIcon Name="logout" Size="18" />
                        Đăng xuất
                    </a>
                </Authorized>
                <NotAuthorized>
                    <a href="/dang-nhap" @onclick="CloseMobileMenu">Đăng nhập</a>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    }
</header>

@code {
    private bool _mobileMenuOpen;
    private bool _userMenuOpen;
    private string _path = "/";

    /// <summary>
    /// <paramref name="Prefixes"/> lists the route prefixes that light the item up; empty means
    /// the item only matches the site root, and a fragment link never highlights.
    /// </summary>
    private sealed record NavItem(string Label, string Href, string[] Prefixes, bool IsFragment = false);

    private static readonly NavItem[] NavItems =
    [
        new("Giới thiệu", "/", []),
        new("Quy trình", "/quy-trinh", ["/quy-trinh"]),
        // The design underlines "Sản phẩm" on the detail page as well as the shop listing.
        new("Sản phẩm", "/cua-hang", ["/cua-hang", "/san-pham"]),
        new("Kiến thức", "/kien-thuc", ["/kien-thuc", "/bai-viet"]),
        new("Hoạt động", "/hoat-dong", ["/hoat-dong"]),
        new("Liên hệ", "/#lien-he", [], IsFragment: true)
    ];

    protected override void OnInitialized()
    {
        UpdatePath();
        Navigation.LocationChanged += OnLocationChanged;
        CartState.OnChange += HandleCartChanged;
    }

    private void HandleCartChanged() => InvokeAsync(StateHasChanged);

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        UpdatePath();
        _mobileMenuOpen = false;
        _userMenuOpen = false;
        StateHasChanged();
    }

    private void UpdatePath() =>
        _path = "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    private bool IsActive(NavItem item)
    {
        if (item.IsFragment)
        {
            return false;
        }

        if (item.Prefixes.Length == 0)
        {
            return _path == "/";
        }

        return item.Prefixes.Any(p =>
            _path.Equals(p, StringComparison.OrdinalIgnoreCase)
            || _path.StartsWith(p + "/", StringComparison.OrdinalIgnoreCase));
    }

    private static string DisplayName(AuthenticationState s) =>
        s.User.FindFirst("FullName")?.Value ?? s.User.Identity?.Name ?? "Tài khoản";

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;

    private void CloseMobileMenu() => _mobileMenuOpen = false;

    private void ToggleUserMenu() => _userMenuOpen = !_userMenuOpen;

    private void CloseUserMenu() => _userMenuOpen = false;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        CartState.OnChange -= HandleCartChanged;
    }
}
