@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />

    @* Public faces: Be Vietnam Pro (body/headings, drawn for Vietnamese diacritics) and
       Playfair Display italic (accents). The admin's Inter + Material Symbols are loaded by
       AdminLayout / AdminLoginLayout instead, so the storefront never pays for them. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@@300;400;500;600;700;800&family=Playfair+Display:ital,wght@@1,500;1,600&display=swap" />

    @* HeadOutlet stays last so admin.css (injected by the admin layouts' <HeadContent>)
       wins on /admin. The public design system is scoped under .nf, so it cannot leak
       into the back office. *@
    <link rel="stylesheet" href="@Assets["css/blazor-ui.css"]" />
    <link rel="stylesheet" href="@Assets["css/nf.css"]" />
    <link rel="stylesheet" href="@Assets["css/nf-pages.css"]" />
    <link rel="stylesheet" href="@Assets["NieFarm.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" CartAnonymousId="@_cartAnonymousId" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    @* Interop shim only — it pulls Quill itself from the CDN the first time an admin
       opens a rich-text field, so public pages never pay for the editor. *@
    <script src="@Assets["js/quill-editor.js"]"></script>
    @* Scroll-reveal / self-drawing SVG / sticky-header module for the NieFarm 2.0 redesign.
       A plain body-tag ES module, not IJSRuntime interop — see
       docs/plans/public-site-redesign-nf2.md §6 for why (prerendering, lifetime, precedent).
       Inert until markup carries [data-reveal]/.draw/.hdr/.progressbar, so shipping it ahead
       of the page migrations is safe. *@
    <script type="module" src="@Assets["js/nf-motion.js"]"></script>
    @* Delegated [data-copy] click handler for the bank transfer panel. Body-tag module, no IJSRuntime. *@
    <script type="module" src="@Assets["js/nf-copy.js"]"></script>
</body>

</html>

@code {
    // App.razor is statically rendered per request, so it can read the anonymous cart id
    // stashed by CartCookieMiddleware in HttpContext.Items — a live Blazor circuit has no
    // HttpContext, and the prerender DI scope is not the circuit's scope. Passed as a
    // root-component parameter (serialized into the component marker, Data-Protection-
    // protected) because a <CascadingValue> here would not cross the InteractiveServer
    // render-mode boundary.
    private string? _cartAnonymousId;

    // Every page is interactive unless it opts out with [ExcludeFromInteractiveRouting] (the R-26
    // traceability pages): those render as plain static SSR, so a QR scan never opens a circuit.
    private IComponentRenderMode? PageRenderMode =>
        HttpContextAccessor.HttpContext?.AcceptsInteractiveRouting() == false ? null : InteractiveServer;

    protected override void OnInitialized() =>
        _cartAnonymousId = HttpContextAccessor.HttpContext?
            .Items[NieFarm.Web.Services.Cart.CartCookie.HttpContextItemKey] as string;
}
