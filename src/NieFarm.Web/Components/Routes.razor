@using Microsoft.AspNetCore.Components.Authorization

<CascadingValue Value="CartAnonymousId" Name="CartAnonymousId">
    <Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @* AuthorizeRouteView so [Authorize] on a page is honoured during interactive
               navigation too, not only by endpoint authorization on the first request. *@
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.PublicLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == false)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        @* Not wrapped by any layout (AuthorizeRouteView's NotAuthorized fragment
                           renders raw), so ".nf" must be applied here explicitly — unlike
                           NotFound.razor/Error.razor, which do reach PublicLayout's ambient ".nf"
                           (docs/plans/public-site-redesign-nf2.md §7, step 5.2). *@
                        <section class="nf shell" style="max-width:42rem;padding-block:clamp(6rem,14vh,9rem);text-align:center">
                            <h1 style="margin-bottom:1.25rem">Không có quyền truy cập</h1>
                            <p class="lede" style="margin-inline:auto">
                                Tài khoản của bạn không có quyền xem trang này.
                            </p>
                        </section>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingValue>

@code {
    // Root-component parameter set by App.razor (statically rendered, reads the anonymous
    // cart id from HttpContext.Items) — see App.razor for why a <CascadingValue> there would
    // not work.
    [Parameter] public string? CartAnonymousId { get; set; }
}
