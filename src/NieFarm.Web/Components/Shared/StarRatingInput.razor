@*
    Five-star rating input for the review submission/edit form. A separate component from
    NfStars.razor (which is presentational, role="img") rather than a mode on it — mixing an
    input role into a presentational component would muddy both. Built as a radiogroup of real
    radio inputs so keyboard (arrow keys) and screen-reader (aria-checked) behaviour comes for
    free, which a row of <button>s would need extra work to match.

    Restyled to ".nf-stars-input" for the NieFarm 2.0 redesign (docs/plans/public-site-redesign-nf2.md
    §7, step 2.7) — public-only (its one call site is Components/Pages/ProductDetail.razor), so unlike
    StarRating.razor there is no admin dependency to protect. The Tailwind SizeClass parameter is gone;
    size now comes from ".nf-stars-input" (nf-pages.css), like NfStars' own font-size-driven sizing.
*@

<fieldset class="nf-stars-input @CssClass" role="radiogroup" aria-label="Chọn số sao đánh giá" disabled="@Disabled">
    <legend class="sr-only">Chọn số sao đánh giá</legend>
    @for (var i = 1; i <= 5; i++)
    {
        var star = i;
        var inputId = $"star-rating-{_groupId}-{star}";
        var filled = Value >= star;

        <span class="nf-stars-input__star">
            <input type="radio" id="@inputId" name="@_groupId" class="sr-only"
                   checked="@(Value == star)" disabled="@Disabled"
                   @onchange="() => SetValueAsync(star)" />
            <label for="@inputId">
                <svg class="ico" viewBox="0 0 24 24" stroke-width="1.3" aria-hidden="true">
                    <path d="m12 3 2.7 5.8 6.3.8-4.6 4.4 1.2 6.3L12 17.3 6.4 20.3l1.2-6.3L3 9.6l6.3-.8L12 3Z"
                          fill="@(filled ? "currentColor" : "none")" stroke="currentColor" />
                </svg>
                <span class="sr-only">@star sao</span>
            </label>
        </span>
    }
</fieldset>

@code {
    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private readonly string _groupId = Guid.NewGuid().ToString("N");

    private async Task SetValueAsync(int star)
    {
        if (Disabled)
            return;

        Value = star;
        await ValueChanged.InvokeAsync(star);
    }
}
