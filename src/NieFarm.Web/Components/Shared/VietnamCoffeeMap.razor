@*
    The line-art Vietnam map behind the home page's "Vietnam Coffee Stories" section
    (docs/plans/home-vietnam-coffee-stories.md D12/D13). SVG only; CoffeeStories.razor owns the
    selected-region state and passes it in. Geometry is generated by tools/map into
    Content/VietnamMapGeometry.g.cs — never hand-edit it.

    Layering, bottom to top (so borders are always on top and every line is exactly 1 CSS px):
      1. .hmap__region paths — fill only. These are the interactive elements: role="button",
         tabindex, aria-pressed. A region with no data row draws inert (data-disabled, no role,
         no tabindex, no handlers).
      2. .hmap__lines — one <use> per region, fill:none, non-scaling 1px stroke. Hover/focus
         reach them from the region through sibling selectors in nf-pages.css.
      3. .hmap__trace — the one-time self-drawing outline (plan Step 13): plain path copies with
         pathLength="1", drawn by nf-pages.css when the static wrapper in Home.razor gains
         "is-in". Its own rules, not the global ".draw".
      4. .hmap__halo — the selected region's red outline. Only its href changes, never its class.
      5. Archipelago dots and ellipses, and the leader lines of the two offshore labels
         (Central and South, whose strips are too narrow to hold a label).
    Labels are HTML spans positioned by --x/--y percentages, not SVG <text>, which would shrink
    to ~7 px on a 390 px phone.

    Traps:
      - Region fills are set by ".hmap__svg > .hmap__region" rules (child combinator) on purpose.
        Chromium matches plain class selectors against the clones inside a <use> shadow tree, so
        a bare ".hmap__region { fill }" would fill the border and halo clones too; the child
        combinator cannot cross into the shadow tree.
      - vector-effect is a presentation attribute on the region paths, not a CSS rule, because
        it is not inherited: the <use> clones only get a 1 CSS px non-scaling stroke if the
        attribute is copied onto them with the rest of the path.
      - Selected state is styled from aria-pressed, never a Razor class expression.
      - Never put .draw or data-reveal on anything in here. nf.css's ".draw path" rules and
        nf-motion.js's normaliseDraw would stamp pathLength and dash styling onto the interactive
        paths; the static wrapper in Home.razor carries data-reveal="fade" instead.
      - Every <use> carries tabindex="-1". Its clone copies the region's tabindex="0", which in
        Chromium made each border line and the halo an extra (aria-hidden) Tab stop after the
        three regions; a negative tabindex on the host keeps its shadow tree out of the order.
      - Space: @onkeypress:preventDefault stops the page scrolling without trapping Tab (which
        preventing keydown would). No arrow-key roving focus for the same reason.
*@
@using NieFarm.Domain.Enums

<div class="hmap" style="@_frameStyle">
    <svg class="hmap__svg" viewBox="0 0 @VietnamMapGeometry.Width @VietnamMapGeometry.Height"
         width="@VietnamMapGeometry.Width" height="@VietnamMapGeometry.Height"
         role="group" aria-label="Bản đồ ba miền cà phê Việt Nam">
        @foreach (var key in CoffeeRegionUi.All)
        {
            var slug = CoffeeRegionUi.Slug(key);
            if (Available.Contains(key))
            {
                <path id="hmap-@slug" class="hmap__region hmap__region--@slug" d="@CoffeeRegionUi.Path(key)"
                      vector-effect="non-scaling-stroke"
                      role="button" tabindex="0"
                      aria-pressed="@(Selected == key ? "true" : "false")"
                      aria-label="@CoffeeRegionUi.Label(key)"
                      aria-controls="@PanelId"
                      @onclick="() => OnSelect.InvokeAsync(key)"
                      @onkeydown="e => OnKeyDownAsync(e, key)"
                      @onkeypress:preventDefault="true" />
            }
            else
            {
                <path id="hmap-@slug" class="hmap__region hmap__region--@slug" d="@CoffeeRegionUi.Path(key)"
                      vector-effect="non-scaling-stroke" data-disabled="true" />
            }
        }

        <g class="hmap__lines" aria-hidden="true">
            @foreach (var key in CoffeeRegionUi.All)
            {
                var slug = CoffeeRegionUi.Slug(key);
                <use class="hmap__line hmap__line--@slug" href="#hmap-@slug" tabindex="-1" />
            }
        </g>

        <g class="hmap__trace" aria-hidden="true">
            @foreach (var key in CoffeeRegionUi.All)
            {
                <path d="@CoffeeRegionUi.Path(key)" pathLength="1" />
            }
        </g>

        @if (Selected is { } selected && Available.Contains(selected))
        {
            <use class="hmap__halo" href="#hmap-@CoffeeRegionUi.Slug(selected)" aria-hidden="true" tabindex="-1" />
        }

        <g class="hmap__isles" aria-hidden="true">
            @foreach (var area in new[] { VietnamMapGeometry.HoangSaArea, VietnamMapGeometry.TruongSaArea })
            {
                <ellipse class="hmap__isle-area"
                         cx="@CoffeeRegionUi.Num(area.Cx)" cy="@CoffeeRegionUi.Num(area.Cy)"
                         rx="@CoffeeRegionUi.Num(area.Rx)" ry="@CoffeeRegionUi.Num(area.Ry)"
                         transform="@($"rotate({CoffeeRegionUi.Num(area.Angle)} {CoffeeRegionUi.Num(area.Cx)} {CoffeeRegionUi.Num(area.Cy)})")" />
            }
            @foreach (var isle in VietnamMapGeometry.HoangSaIslands.Concat(VietnamMapGeometry.TruongSaIslands))
            {
                <circle class="hmap__isle" cx="@CoffeeRegionUi.Num(isle.X)" cy="@CoffeeRegionUi.Num(isle.Y)" r="2.4" />
            }
        </g>

        <g class="hmap__leader" aria-hidden="true">
            @foreach (var (from, to) in CoffeeRegionUi.Leaders)
            {
                <circle cx="@CoffeeRegionUi.Num(from.X)" cy="@CoffeeRegionUi.Num(from.Y)" r="2" />
                <line x1="@CoffeeRegionUi.Num(from.X)" y1="@CoffeeRegionUi.Num(from.Y)"
                      x2="@CoffeeRegionUi.Num(to.X)" y2="@CoffeeRegionUi.Num(to.Y)" />
            }
        </g>
    </svg>

    @foreach (var key in CoffeeRegionUi.All)
    {
        <span class="@(CoffeeRegionUi.IsOffshore(key) ? "hmap__label hmap__label--offshore" : "hmap__label")" aria-hidden="true"
              style="@CoffeeRegionUi.PositionStyle(CoffeeRegionUi.LabelPoint(key))">@for (var i = 0; i < CoffeeRegionUi.MapLabelLines(key).Count; i++)
              {
                  if (i > 0) { <br /> }
                  @CoffeeRegionUi.MapLabelLines(key)[i]
              }</span>
    }

    <span class="hmap__isle-label" style="@CoffeeRegionUi.PositionStyle(VietnamMapGeometry.HoangSaLabel)">Quần đảo<br />Hoàng Sa</span>
    <span class="hmap__isle-label" style="@CoffeeRegionUi.PositionStyle(VietnamMapGeometry.TruongSaLabel)">Quần đảo<br />Trường Sa</span>
    <span class="hmap__sea-label" style="@CoffeeRegionUi.PositionStyle(VietnamMapGeometry.SeaLabel)">Biển Đông</span>
</div>

@code {
    // The generated width/height drive the CSS aspect ratio and the phone max-width, so a
    // regenerated map with a different frame never needs a hand-edited stylesheet.
    private static readonly string _frameStyle =
        $"--hmap-w:{VietnamMapGeometry.Width};--hmap-h:{VietnamMapGeometry.Height}";

    [Parameter] public CoffeeRegionKey? Selected { get; set; }

    [Parameter, EditorRequired] public IReadOnlySet<CoffeeRegionKey> Available { get; set; } = default!;

    [Parameter] public EventCallback<CoffeeRegionKey> OnSelect { get; set; }

    /// <summary>The id of the story panel the regions control (aria-controls).</summary>
    [Parameter, EditorRequired] public string PanelId { get; set; } = default!;

    private Task OnKeyDownAsync(KeyboardEventArgs e, CoffeeRegionKey key) =>
        e.Key is "Enter" or " " or "Spacebar" ? OnSelect.InvokeAsync(key) : Task.CompletedTask;
}
