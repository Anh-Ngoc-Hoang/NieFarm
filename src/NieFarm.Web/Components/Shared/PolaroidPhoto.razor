@*
    A single framed photo with a caption underneath, used to build loosely-stacked
    photo collages (e.g. the farm-to-cup story on the login screen). NieFarm 2.0
    restyle (docs/plans/public-site-redesign-nf2.md §7, step 5.1): the per-photo
    drop shadow becomes a ".polaroid" hairline inset — the collage as a whole
    carries at most one soft photographic shadow, applied by the parent
    (FarmStoryPanel's ".auth__collage-item--4") rather than by every card here.
*@

<div class="polaroid">
    <div class="polaroid__frame">
        <img src="@ImageUrl" alt="@ImageAlt" loading="@(Lazy ? "lazy" : null)" decoding="async" />
    </div>
    <p class="polaroid__caption">@Caption</p>
</div>

@code {
    [Parameter, EditorRequired] public string ImageUrl { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string ImageAlt { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Caption { get; set; } = string.Empty;

    /// <summary>Set for photos below the first screen (R-26 traceability page).</summary>
    [Parameter] public bool Lazy { get; set; }
}
