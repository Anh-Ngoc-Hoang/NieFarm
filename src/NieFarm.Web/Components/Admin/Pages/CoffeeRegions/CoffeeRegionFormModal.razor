@using NieFarm.Application.Features.Admin.CoffeeRegions.Commands
@using NieFarm.Application.Features.Admin.CoffeeRegions.Dtos
@using NieFarm.Application.Features.Admin.CoffeeRegions.Queries
@using NieFarm.Domain.Entities
@using NieFarm.Domain.Enums
@inject ISender Sender

@*
    Edit-only form for one of the three fixed coffee regions (the same structure as
    CropFormModal). The region key is read-only, shown in the title. Areas are sent back as the
    full ordered list of (Id?, Name, Note); CoffeeRegion.SetAreas diffs it against the stored rows.
*@

@if (_visible)
{
    <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="region-form-title">
        <div class="admin-modal__dialog admin-modal__dialog--wide">
            <div class="admin-modal__head">
                <h2 id="region-form-title">Edit @CoffeeRegionsPage.RegionName(_key)</h2>
                <button class="btn-icon" type="button" title="Close" @onclick="CancelAsync">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
            </div>

            <div class="admin-modal__body">
                @if (_errors.Count > 0)
                {
                    <div class="form-alert form-alert--error">
                        @foreach (var error in _errors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }

                <div>
                    <label class="form-label-admin" for="region-title">Title *</label>
                    <input id="region-title" class="form-control-admin" maxlength="@CoffeeRegion.TitleMaxLength"
                           @bind="_model.Title" />
                </div>

                <div style="margin-top:16px;">
                    <label class="form-label-admin" for="region-tagline">Tagline</label>
                    <input id="region-tagline" class="form-control-admin" maxlength="@CoffeeRegion.TaglineMaxLength"
                           @bind="_model.Tagline" />
                </div>

                <div style="margin-top:16px;">
                    <label class="form-label-admin" for="region-description">Description *</label>
                    <textarea id="region-description" class="form-control-admin" rows="6"
                              maxlength="@CoffeeRegion.DescriptionMaxLength" @bind="_model.Description"></textarea>
                    <div class="cell-muted" style="font-size:12px;margin-top:4px;">
                        Plain text. Separate paragraphs with a blank line.
                    </div>
                </div>

                <div class="form-grid form-grid--2" style="margin-top:16px;">
                    <div>
                        <label class="form-label-admin" for="region-altitude">Altitude</label>
                        <input id="region-altitude" class="form-control-admin" maxlength="@CoffeeRegion.AltitudeMaxLength"
                               @bind="_model.Altitude" placeholder="Khoảng 400–1.600 m" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="region-varieties">Varieties</label>
                        <input id="region-varieties" class="form-control-admin" maxlength="@CoffeeRegion.VarietiesMaxLength"
                               @bind="_model.Varieties" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="region-climate">Climate</label>
                        <input id="region-climate" class="form-control-admin" maxlength="@CoffeeRegion.ClimateMaxLength"
                               @bind="_model.Climate" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="region-flavor">Flavor profile</label>
                        <input id="region-flavor" class="form-control-admin" maxlength="@CoffeeRegion.FlavorProfileMaxLength"
                               @bind="_model.FlavorProfile" />
                    </div>
                </div>

                <div class="form-grid form-grid--2" style="margin-top:16px;">
                    <div>
                        @* Unmounted with the modal so each open gets a fresh InputFile. *@
                        <SingleImageField @ref="_imageField"
                                          Label="Photo"
                                          Subfolder="@CoffeeRegionImageLimits.Subfolder"
                                          MaxBytes="CoffeeRegionImageLimits.MaxImageBytes"
                                          Value="@_model.ImageUrl"
                                          ValueChanged="url => _model.ImageUrl = url"
                                          PersistedValue="@_persistedImageUrl"
                                          Disabled="_saving"
                                          UploadingChanged="value => _uploading = value" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="region-alt">Image alt text</label>
                        <input id="region-alt" class="form-control-admin" maxlength="@CoffeeRegion.ImageAltMaxLength"
                               @bind="_model.ImageAlt" />
                        <div class="cell-muted" style="font-size:12px;margin-top:4px;">
                            Required when a photo is set. Describe what is in the picture, in Vietnamese.
                        </div>
                    </div>
                </div>

                <div style="margin-top:28px;">
                    <label class="form-label-admin">Coffee areas</label>
                    <div class="cell-muted" style="font-size:12px;margin-bottom:8px;">
                        Up to @CoffeeRegion.MaxAreas well-known areas, listed in this order on the home page.
                    </div>

                    @for (var i = 0; i < _areas.Count; i++)
                    {
                        var index = i;
                        var row = _areas[index];

                        <div class="repeat-row" @key="row.Key">
                            <input class="form-control-admin" aria-label="@($"Area {index + 1} name")"
                                   placeholder="Name *" maxlength="@CoffeeRegionArea.NameMaxLength"
                                   @bind="row.Name" />
                            <input class="form-control-admin" aria-label="@($"Area {index + 1} note")"
                                   placeholder="Short note" maxlength="@CoffeeRegionArea.NoteMaxLength"
                                   @bind="row.Note" />
                            <button class="btn-icon" type="button" title="Move up" disabled="@(index == 0)"
                                    @onclick="() => MoveArea(index, -1)">
                                <span class="material-symbols-outlined" aria-hidden="true">arrow_upward</span>
                            </button>
                            <button class="btn-icon" type="button" title="Move down"
                                    disabled="@(index == _areas.Count - 1)"
                                    @onclick="() => MoveArea(index, 1)">
                                <span class="material-symbols-outlined" aria-hidden="true">arrow_downward</span>
                            </button>
                            <button class="btn-icon btn-icon--danger" type="button" title="Remove"
                                    @onclick="() => _areas.Remove(row)">
                                <span class="material-symbols-outlined" aria-hidden="true">delete</span>
                            </button>
                        </div>
                    }

                    <button class="btn-admin-outline btn-admin--sm" type="button" style="margin-top:8px;"
                            disabled="@(_areas.Count >= CoffeeRegion.MaxAreas)"
                            @onclick="AddArea">
                        <span class="material-symbols-outlined" aria-hidden="true">add</span> Add area
                    </button>
                </div>
            </div>

            <div class="admin-modal__foot">
                <button class="btn-admin-outline" type="button" @onclick="CancelAsync" disabled="@_saving">
                    Cancel
                </button>
                <button class="btn-admin" type="button" @onclick="SaveAsync"
                        disabled="@(_saving || _uploading)">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private sealed class FormModel
    {
        public string Title { get; set; } = string.Empty;
        public string Tagline { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string Altitude { get; set; } = string.Empty;
        public string Varieties { get; set; } = string.Empty;
        public string Climate { get; set; } = string.Empty;
        public string FlavorProfile { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
        public string ImageAlt { get; set; } = string.Empty;
    }

    /// <summary>One editable area row. <see cref="Key"/> is a client-side identity for @key only.</summary>
    private sealed class AreaRow
    {
        public Guid Key { get; } = Guid.NewGuid();
        public int? Id { get; init; }
        public string Name { get; set; } = string.Empty;
        public string Note { get; set; } = string.Empty;
    }

    private CoffeeRegionKey _key;
    private FormModel _model = new();
    private readonly List<AreaRow> _areas = [];
    private SingleImageField? _imageField;
    private string _persistedImageUrl = string.Empty;
    private List<string> _errors = [];

    private bool _visible;
    private bool _saving;
    private bool _uploading;

    public async Task OpenForEditAsync(CoffeeRegionKey key)
    {
        var region = await Sender.Send(new GetCoffeeRegionForEditQuery(key));
        if (region is null)
            return;

        _key = region.Key;
        _model = new FormModel
        {
            Title = region.Title,
            Tagline = region.Tagline,
            Description = region.Description,
            Altitude = region.Altitude,
            Varieties = region.Varieties,
            Climate = region.Climate,
            FlavorProfile = region.FlavorProfile,
            ImageUrl = region.ImageUrl,
            ImageAlt = region.ImageAlt
        };

        _areas.Clear();
        _areas.AddRange(region.Areas.Select(a => new AreaRow { Id = a.Id, Name = a.Name, Note = a.Note ?? string.Empty }));

        _persistedImageUrl = region.ImageUrl;
        _errors = [];
        _visible = true;
        StateHasChanged();
    }

    private void AddArea()
    {
        if (_areas.Count < CoffeeRegion.MaxAreas)
            _areas.Add(new AreaRow());
    }

    private void MoveArea(int index, int offset)
    {
        var newIndex = index + offset;
        if (newIndex < 0 || newIndex >= _areas.Count)
            return;

        (_areas[index], _areas[newIndex]) = (_areas[newIndex], _areas[index]);
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _errors = [];

        try
        {
            var result = await Sender.Send(new SaveCoffeeRegionCommand(
                _key,
                _model.Title ?? string.Empty,
                _model.Tagline,
                _model.Description ?? string.Empty,
                _model.Altitude,
                _model.Varieties,
                _model.Climate,
                _model.FlavorProfile,
                _model.ImageUrl,
                _model.ImageAlt,
                _areas.Select(a => new CoffeeRegionAreaInput(a.Id, a.Name ?? string.Empty, a.Note)).ToList()));

            if (!result.IsSuccess)
            {
                _errors = result.ValidationErrors.Select(e => e.ErrorMessage)
                    .Concat(result.Errors)
                    .Where(m => !string.IsNullOrWhiteSpace(m))
                    .Distinct()
                    .DefaultIfEmpty("Could not save the region.")
                    .ToList();
                return;
            }

            // The upload is now a stored value, so the field must not treat it as an orphan.
            _persistedImageUrl = _model.ImageUrl ?? string.Empty;

            _visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CancelAsync()
    {
        // Removes an upload that was never persisted, before the field unmounts.
        if (_imageField is not null)
            await _imageField.DiscardAsync();

        _visible = false;
    }
}
