@page "/admin/coffee-regions"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@using NieFarm.Application.Features.Admin.CoffeeRegions.Dtos
@using NieFarm.Application.Features.Admin.CoffeeRegions.Queries
@using NieFarm.Domain.Enums
@inject ISender Sender

@*
    The three fixed "Vietnam Coffee Stories" regions (docs/plans/home-vietnam-coffee-stories.md
    D7). Edit only: the rows are created by the seeder and the map's shapes are fixed in source,
    so there is deliberately no Add and no Delete here.
*@

<AdminPageTitle Title="Coffee Regions" />

<div class="admin-page-head">
    <div class="admin-page-head__titles">
        <h1>Coffee Regions</h1>
        <p>Vietnam Coffee Stories on the home page. The three regions are fixed by the map; edit their content here.</p>
    </div>
</div>

@if (_loaded && _all.Count < 3)
{
    <div class="form-alert form-alert--error" style="margin-bottom:16px;">
        A region is missing — restart the site to re-seed it.
    </div>
}

<div class="admin-table-wrap">
    <table class="admin-table">
        <thead>
            <tr>
                <th style="width:64px;">Image</th>
                <th style="width:180px;">Region</th>
                <th>Title</th>
                <th style="width:90px;">Areas</th>
                <th style="width:120px;">Updated</th>
                <th style="width:90px;text-align:right;">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var region in _all)
            {
                <tr>
                    <td>
                        <div class="table-thumb">
                            @if (!string.IsNullOrWhiteSpace(region.ImageUrl))
                            {
                                <img src="@region.ImageUrl" alt="@region.Title" />
                            }
                            else
                            {
                                <span class="material-symbols-outlined cell-muted" aria-hidden="true">map</span>
                            }
                        </div>
                    </td>
                    <td><AdminBadge Text="@RegionName(region.Key)" /></td>
                    <td>
                        <span class="cell-primary">@region.Title</span>
                        @if (!string.IsNullOrWhiteSpace(region.Tagline))
                        {
                            <div class="cell-muted" style="font-size:12px;">@region.Tagline</div>
                        }
                    </td>
                    <td class="cell-muted">@region.AreaCount</td>
                    <td class="cell-muted">@region.UpdatedAt.ToString("dd/MM/yyyy")</td>
                    <td>
                        <div class="row-actions">
                            <button class="btn-icon" type="button" title="Edit"
                                    @onclick="() => _formModal.OpenForEditAsync(region.Key)">
                                <span class="material-symbols-outlined" aria-hidden="true">edit</span>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (_loaded && _all.Count == 0)
    {
        <div style="padding:20px;text-align:center;" class="cell-muted">No regions found.</div>
    }
</div>

<CoffeeRegionFormModal @ref="_formModal" OnSaved="ReloadAsync" />

@code {
    private List<CoffeeRegionAdminListDto> _all = [];
    private bool _loaded;
    private CoffeeRegionFormModal _formModal = default!;

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        _all = await Sender.Send(new GetCoffeeRegionsAdminQuery());
        _loaded = true;
    }

    /// <summary>"South (Tây Nguyên – Nam Bộ)" — English for the admin, with the fixed public map label.</summary>
    internal static string RegionName(CoffeeRegionKey key) => $"{key} ({CoffeeRegionUi.Label(key)})";
}
