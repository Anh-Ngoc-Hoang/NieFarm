@using NieFarm.Application.Features.Admin.Shipping.Commands
@using NieFarm.Application.Features.Admin.Shipping.Dtos
@using NieFarm.Domain.Entities
@inject ISender Sender

@if (_visible)
{
    <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="zone-form-title">
        <div class="admin-modal__dialog admin-modal__dialog--wide">
            <div class="admin-modal__head">
                <h2 id="zone-form-title">@(_model.Id is null ? "Add Zone" : "Edit Zone")</h2>
                <button class="btn-icon" type="button" title="Close" @onclick="Close">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
            </div>

            <div class="admin-modal__body">
                @if (_errors.Count > 0)
                {
                    <div class="form-alert form-alert--error">
                        @foreach (var error in _errors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }

                <div class="form-grid form-grid--2">
                    <div>
                        <label class="form-label-admin" for="zn-name">Name *</label>
                        <input id="zn-name" class="form-control-admin"
                               maxlength="@ShippingZone.NameMaxLength" @bind="_model.Name" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="zn-fee">Fee (₫) *</label>
                        <input id="zn-fee" class="form-control-admin" type="number" min="0" step="1000" @bind="_model.Fee" />
                    </div>
                </div>

                <div class="form-grid form-grid--2" style="margin-top:16px;">
                    <div>
                        <label class="form-label-admin" for="zn-order">Sort order *</label>
                        <input id="zn-order" class="form-control-admin" type="number" min="0" @bind="_model.SortOrder" />
                    </div>
                    <div style="display:flex;align-items:flex-end;">
                        <label class="form-check-admin">
                            <input type="checkbox" @bind="_model.IsActive" /> Active
                        </label>
                    </div>
                </div>

                <div style="margin-top:16px;">
                    <label class="form-label-admin" for="zn-search">Provinces * (@_model.Selected.Count selected)</label>
                    <input id="zn-search" class="form-control-admin" type="search" placeholder="Filter provinces…"
                           @bind="_search" @bind:event="oninput" />
                    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:6px 16px;margin-top:10px;max-height:280px;overflow:auto;">
                        @foreach (var province in VisibleProvinces)
                        {
                            var takenBy = province.ZoneId is { } zoneId && zoneId != _model.Id ? province.ZoneName : null;
                            <label class="form-check-admin" style="@(takenBy is null ? null : "opacity:.55;")">
                                <input type="checkbox" disabled="@(takenBy is not null)"
                                       checked="@_model.Selected.Contains(province.Code)"
                                       @onchange="e => Toggle(province.Code, (bool)e.Value!)" />
                                @province.Name
                                @if (takenBy is not null)
                                {
                                    <span class="cell-muted" style="font-size:12px;"> (@takenBy)</span>
                                }
                            </label>
                        }
                    </div>
                </div>
            </div>

            <div class="admin-modal__foot">
                <button class="btn-admin-outline" type="button" @onclick="Close" disabled="@_saving">Cancel</button>
                <button class="btn-admin" type="button" @onclick="SaveAsync" disabled="@_saving">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private sealed class FormModel
    {
        public int? Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public decimal Fee { get; set; }
        public int SortOrder { get; set; }
        public bool IsActive { get; set; } = true;
        public HashSet<int> Selected { get; } = [];
    }

    private FormModel _model = new();
    private IReadOnlyList<ShippingProvinceAdminDto> _provinces = [];
    private List<string> _errors = [];
    private string _search = string.Empty;
    private bool _visible;
    private bool _saving;

    private IEnumerable<ShippingProvinceAdminDto> VisibleProvinces =>
        string.IsNullOrWhiteSpace(_search)
            ? _provinces
            : _provinces.Where(p => p.Name.Contains(_search.Trim(), StringComparison.CurrentCultureIgnoreCase));

    public void OpenForCreate(ShippingAdminDto data)
    {
        _model = new FormModel { SortOrder = data.Zones.Count == 0 ? 0 : data.Zones.Max(z => z.SortOrder) + 1 };
        Open(data);
    }

    public void OpenForEdit(ShippingAdminDto data, ShippingZoneAdminDto zone)
    {
        _model = new FormModel
        {
            Id = zone.Id,
            Name = zone.Name,
            Fee = zone.Fee,
            SortOrder = zone.SortOrder,
            IsActive = zone.IsActive
        };
        foreach (var code in zone.ProvinceCodes)
            _model.Selected.Add(code);

        Open(data);
    }

    private void Open(ShippingAdminDto data)
    {
        _provinces = data.Provinces;
        _errors = [];
        _search = string.Empty;
        _visible = true;
        StateHasChanged();
    }

    private void Toggle(int code, bool isOn)
    {
        if (isOn) _model.Selected.Add(code);
        else _model.Selected.Remove(code);
    }

    private void Close() => _visible = false;

    private async Task SaveAsync()
    {
        _saving = true;
        _errors = [];

        try
        {
            var result = await Sender.Send(new SaveShippingZoneCommand(
                _model.Id,
                _model.Name ?? string.Empty,
                _model.Fee,
                _model.SortOrder,
                _model.IsActive,
                _model.Selected.OrderBy(c => c).ToList()));

            if (!result.IsSuccess)
            {
                _errors = result.ValidationErrors.Select(e => e.ErrorMessage)
                    .Concat(result.Errors)
                    .Where(m => !string.IsNullOrWhiteSpace(m))
                    .DefaultIfEmpty("Could not save the zone.")
                    .ToList();
                return;
            }

            _visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }
}
