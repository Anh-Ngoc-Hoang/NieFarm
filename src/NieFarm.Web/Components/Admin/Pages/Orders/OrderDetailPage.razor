@page "/admin/orders/{Id:int}"
@layout AdminLayout
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
@using NieFarm.Application.Features.Admin.Orders.Commands
@using NieFarm.Application.Features.Admin.Orders.Dtos
@using NieFarm.Application.Features.Admin.Orders.Queries
@using Ardalis.Result
@using NieFarm.Domain.Enums
@implements IDisposable
@inject ISender Sender
@inject NewOrderCountState OrderCountState

<AdminPageTitle Title="@(_order is null ? "Order" : $"Order {_order.Code}")" />

@if (_order is null)
{
    <div class="admin-card">
        <div class="admin-card__body cell-muted">
            @(_loaded ? "This order does not exist." : "Loading…")
        </div>
    </div>
}
else
{
    <div class="admin-page-head">
        <div class="admin-page-head__titles">
            <h1>Order @_order.Code</h1>
            <p>Placed @VnTime.FromUtc(_order.PlacedAt).ToString("dd/MM/yyyy HH:mm") (GMT+7)</p>
        </div>
        <a class="btn-admin-outline" href="/admin/orders">
            <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span> Back to orders
        </a>
    </div>

    @if (_statusError is not null)
    {
        <div class="form-alert form-alert--error">@_statusError</div>
    }

    <AdminCard Title="Status">
        <div class="admin-card__body" style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;">
            <AdminBadge Text="@_order.Status.ToString()" Variant="@OrdersPage.StatusVariant(_order.Status)" />
            <AdminBadge Text="@OrdersPage.PaymentText(_order.PaymentMethod, _order.PaymentStatus)"
                        Variant="@OrdersPage.PaymentVariant(_order.PaymentMethod, _order.PaymentStatus)" />
            @if (_order.AllowedNextStatuses.Count == 0 && _order.PaymentBlockedStatuses.Count == 0)
            {
                <span class="cell-muted">This order is @_order.Status. Its status can no longer change.</span>
            }
            else
            {
                @foreach (var next in _order.AllowedNextStatuses)
                {
                    <button type="button" class="@(next == OrderStatus.Cancelled ? "btn-admin-outline" : "btn-admin")"
                            style="@(next == OrderStatus.Cancelled ? "color:var(--admin-danger);border-color:var(--admin-danger);" : null)"
                            disabled="@_saving" @onclick="() => OpenStatusModal(next)">
                        @ActionLabel(next)
                    </button>
                }

                @* Moves the matrix allows but the payment rules block: shown disabled, with the reason. *@
                @foreach (var blocked in _order.PaymentBlockedStatuses)
                {
                    <button type="button" class="btn-admin" disabled aria-describedby="payment-blocked-hint">
                        @ActionLabel(blocked)
                    </button>
                }
                @if (_order.PaymentBlockedStatuses.Count > 0)
                {
                    <span id="payment-blocked-hint" class="cell-muted" style="font-size:13px;">
                        Delivery is locked until the bank transfer is recorded.
                    </span>
                }
            }
        </div>
    </AdminCard>

    <AdminCard Title="Payment">
        @if (_order.PaymentMethod == PaymentMethod.CashOnDelivery)
        {
            <div class="admin-card__body cell-muted">Cash on delivery — collected by the courier.</div>
        }
        else
        {
            <div class="admin-card__body">
                <dl style="margin:0 0 16px;display:grid;grid-template-columns:160px 1fr;gap:10px 16px;">
                    <dt class="cell-muted">Status</dt>
                    <dd style="margin:0;"><AdminBadge Text="@OrdersPage.PaymentStatusText(_order.PaymentStatus)" Variant="@OrdersPage.PaymentStatusVariant(_order.PaymentStatus)" /></dd>

                    <dt class="cell-muted">Amount due</dt>
                    <dd style="margin:0;">@Money.Vnd(_order.Total)</dd>

                    <dt class="cell-muted">Transfer content</dt>
                    <dd style="margin:0;">@_order.Code</dd>

                    @if (_order.PaidAtUtc is { } paidAt)
                    {
                        <dt class="cell-muted">Paid at (GMT+7)</dt>
                        <dd style="margin:0;">@VnTime.FromUtc(paidAt).ToString("dd/MM/yyyy HH:mm")</dd>

                        <dt class="cell-muted">Paid amount</dt>
                        <dd style="margin:0;">@Money.Vnd(_order.PaidAmount ?? 0m)</dd>
                    }

                    @if (LatestReference is not null)
                    {
                        <dt class="cell-muted">Reference</dt>
                        <dd style="margin:0;">@LatestReference</dd>
                    }
                </dl>

                <div style="display:flex;flex-wrap:wrap;gap:12px;">
                    @if (_order.CanConfirmPayment)
                    {
                        <button type="button" class="btn-admin" disabled="@_saving"
                                @onclick="() => OpenPaymentModal(PaymentModalMode.Confirm)">Record payment received</button>
                    }
                    @if (_order.CanRevertPayment)
                    {
                        <button type="button" class="btn-admin-outline"
                                style="color:var(--admin-danger);border-color:var(--admin-danger);"
                                disabled="@_saving"
                                @onclick="() => OpenPaymentModal(PaymentModalMode.Revert)">Undo payment</button>
                    }
                    @if (_order.CanMarkRefunded)
                    {
                        <button type="button" class="btn-admin" disabled="@_saving"
                                @onclick="() => OpenPaymentModal(PaymentModalMode.Refund)">Mark as refunded</button>
                    }
                </div>
            </div>

            @if (_order.PaymentHistory.Count > 0)
            {
                <div style="overflow-x:auto;">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th style="width:170px;">When (GMT+7)</th>
                                <th style="width:220px;">Change</th>
                                <th style="width:140px;">Amount</th>
                                <th style="width:160px;">By</th>
                                <th style="width:160px;">Reference</th>
                                <th>Note</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var change in _order.PaymentHistory)
                            {
                                <tr>
                                    <td class="cell-muted">@VnTime.FromUtc(change.ChangedAtUtc).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td class="cell-primary">@(change.FromStatus is null ? change.ToStatus.ToString() : $"{change.FromStatus} → {change.ToStatus}")</td>
                                    <td>@(change.Amount is { } amount ? Money.Vnd(amount) : "—")</td>
                                    <td>@PaymentActorText(change)</td>
                                    <td>@(string.IsNullOrWhiteSpace(change.Reference) ? "—" : change.Reference)</td>
                                    <td>@(string.IsNullOrWhiteSpace(change.Note) ? "—" : change.Note)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </AdminCard>

    <AdminCard Title="Status history">
        <div style="overflow-x:auto;">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width:170px;">When (GMT+7)</th>
                        <th style="width:220px;">Change</th>
                        <th style="width:200px;">By</th>
                        <th>Note</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var change in _order.History)
                    {
                        <tr>
                            <td class="cell-muted">@VnTime.FromUtc(change.ChangedAtUtc).ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="cell-primary">@(change.FromStatus is null ? "Placed" : $"{change.FromStatus} → {change.ToStatus}")</td>
                            <td>@ActorText(change)</td>
                            <td>@(string.IsNullOrWhiteSpace(change.Note) ? "—" : change.Note)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (HasHistoryGap(_order))
        {
            <div class="admin-card__body cell-muted" style="font-size:13px;">Earlier status changes were not recorded.</div>
        }
    </AdminCard>

    <div class="admin-grid" style="grid-template-columns:1fr;">
        <AdminCard Title="Customer">
            <div class="admin-card__body">
                <dl style="margin:0;display:grid;grid-template-columns:160px 1fr;gap:10px 16px;">
                    <dt class="cell-muted">Name</dt>
                    <dd style="margin:0;">@_order.CustomerName</dd>

                    <dt class="cell-muted">Phone</dt>
                    <dd style="margin:0;">@_order.Phone</dd>

                    <dt class="cell-muted">Email</dt>
                    <dd style="margin:0;">@(string.IsNullOrWhiteSpace(_order.Email) ? "—" : _order.Email)</dd>

                    <dt class="cell-muted">Shipping address</dt>
                    <dd style="margin:0;">@_order.ShippingAddress</dd>

                    <dt class="cell-muted">Note</dt>
                    <dd style="margin:0;">@(string.IsNullOrWhiteSpace(_order.Note) ? "—" : _order.Note)</dd>
                </dl>
            </div>
        </AdminCard>

        <AdminCard Title="Items">
            <div style="overflow-x:auto;">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th style="width:64px;">Image</th>
                            <th>Product</th>
                            <th style="width:150px;">Unit price</th>
                            <th style="width:90px;">Qty</th>
                            <th style="width:150px;">Line total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _order.Lines)
                        {
                            <tr>
                                <td>
                                    <div class="table-thumb">
                                        @if (!string.IsNullOrWhiteSpace(line.ImageUrl))
                                        {
                                            <img src="@line.ImageUrl" alt="@line.ProductName" />
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined cell-muted" aria-hidden="true">coffee</span>
                                        }
                                    </div>
                                </td>
                                <td class="cell-primary">
                                    @line.ProductName
                                    @if (!string.IsNullOrWhiteSpace(line.Variant))
                                    {
                                        <div class="cell-muted" style="font-size:12px;">@line.Variant</div>
                                    }
                                </td>
                                <td>@Money.Vnd(line.UnitPrice)</td>
                                <td>@line.Quantity</td>
                                <td class="cell-primary">@Money.Vnd(line.LineTotal)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="admin-card__body" style="display:flex;justify-content:flex-end;">
                <dl style="margin:0;display:grid;grid-template-columns:auto auto;gap:8px 32px;min-width:280px;">
                    <dt class="cell-muted">Subtotal</dt>
                    <dd style="margin:0;text-align:right;">@Money.Vnd(_order.Subtotal)</dd>

                    <dt class="cell-muted">Shipping@(ShippingBasis is { } basis ? $" ({basis})" : null)</dt>
                    <dd style="margin:0;text-align:right;">@(_order.ShippingFee == 0m ? "Free" : Money.Vnd(_order.ShippingFee))</dd>

                    @if (_order.Discount > 0m)
                    {
                        <dt class="cell-muted">Discount@(string.IsNullOrWhiteSpace(_order.CouponCode) ? null : $" ({_order.CouponCode})")</dt>
                        <dd style="margin:0;text-align:right;">-@Money.Vnd(_order.Discount)</dd>
                    }

                    <dt class="cell-primary">Total</dt>
                    <dd class="cell-primary" style="margin:0;text-align:right;">@Money.Vnd(_order.Total)</dd>
                </dl>
            </div>
        </AdminCard>
    </div>
}

<OrderStatusChangeModal @ref="_modal" Busy="_saving" Error="_modalError" Warning="@CancelPaidWarning"
                        OnConfirm="ConfirmStatusChangeAsync" />
<OrderPaymentModal @ref="_paymentModal" Busy="_saving" Error="_modalError" OnConfirm="ConfirmPaymentAsync" />

@code {
    [Parameter] public int Id { get; set; }

    private OrderDetailDto? _order;

    // "Zone Tây Nguyên, Đắk Lắk" or "Base fee, Hà Nội"; null for orders placed before zones existed.
    private string? ShippingBasis =>
        _order is null || string.IsNullOrWhiteSpace(_order.ShippingProvince)
            ? null
            : $"{(string.IsNullOrWhiteSpace(_order.ShippingZoneName) ? "Base fee" : $"Zone {_order.ShippingZoneName}")}, {_order.ShippingProvince}";
    private OrderStatusChangeModal? _modal;
    private OrderPaymentModal? _paymentModal;
    private string? _modalError;
    private string? _statusError;
    private bool _loaded;
    private bool _saving;
    private readonly CancellationTokenSource _cts = new();

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();

        if (_order is null)
            return;

        // Opening an order clears it from the sidebar badge.
        await Sender.Send(new MarkOrderReadCommand(Id));
        await OrderCountState.RefreshAsync();
    }

    private async Task LoadAsync()
    {
        _order = await Sender.Send(new GetOrderDetailQuery(Id));
        _loaded = true;
    }

    // The reference of the most recent payment row that carries one (what the admin looks up in the bank app).
    private string? LatestReference =>
        _order?.PaymentHistory.LastOrDefault(c => !string.IsNullOrWhiteSpace(c.Reference))?.Reference;

    // Shown in the cancel dialog only; the modal ignores it for other transitions.
    private string? CancelPaidWarning => _order is { PaymentStatus: PaymentStatus.Paid }
        ? $"This order has been paid ({Money.Vnd(_order.PaidAmount ?? 0m)}). Cancelling flags it as Refund due — refund the customer from your bank."
        : null;

    private static string PaymentActorText(OrderPaymentChangeDto change) => change.ChangedBy switch
    {
        OrderStatusActor.Admin => string.IsNullOrWhiteSpace(change.ChangedByName) ? "Admin" : change.ChangedByName,
        OrderStatusActor.Customer => "Customer",
        _ => string.IsNullOrWhiteSpace(change.ChangedByName) ? "System" : change.ChangedByName
    };

    private void OpenPaymentModal(PaymentModalMode mode)
    {
        if (_order is null) return;
        _modalError = null;
        _statusError = null;
        // The amount is display-only: Confirm shows the total due, Refund shows what was received.
        var amount = mode == PaymentModalMode.Refund ? _order.PaidAmount ?? _order.Total : _order.Total;
        _paymentModal?.Show(mode, _order.Code, amount, _order.Status == OrderStatus.Cancelled);
    }

    private async Task ConfirmPaymentAsync((PaymentModalMode Mode, string? Reference, string? Note) args)
    {
        if (_order is null || _saving) return;

        _saving = true;
        _modalError = null;
        _statusError = null;

        try
        {
            var result = args.Mode switch
            {
                PaymentModalMode.Confirm => await Sender.Send(
                    new ConfirmOrderPaymentCommand(Id, _order.Status, args.Reference, args.Note), _cts.Token),
                PaymentModalMode.Revert => await Sender.Send(
                    new RevertOrderPaymentCommand(Id, args.Note ?? string.Empty), _cts.Token),
                _ => await Sender.Send(
                    new MarkOrderRefundedCommand(Id, args.Reference, args.Note), _cts.Token)
            };

            var message = result.ValidationErrors.Select(e => e.ErrorMessage)
                .Concat(result.Errors)
                .FirstOrDefault(m => !string.IsNullOrWhiteSpace(m));

            if (result.IsSuccess)
            {
                _paymentModal?.Hide();
                await LoadAsync();
            }
            else if (result.Status == ResultStatus.Conflict)
            {
                _paymentModal?.Hide();
                _statusError = message ?? "This order was updated by someone else. The page has been refreshed.";
                await LoadAsync();
            }
            else if (result.Status == ResultStatus.NotFound)
            {
                _paymentModal?.Hide();
                _statusError = "This order no longer exists.";
                await LoadAsync();
            }
            else
            {
                _modalError = message ?? "Could not update the payment.";
            }
        }
        finally
        {
            _saving = false;
        }
    }

    private static string ActionLabel(OrderStatus to) => to switch
    {
        OrderStatus.Confirmed => "Confirm order",
        OrderStatus.Delivering => "Mark as delivering",
        OrderStatus.Completed => "Mark as completed",
        OrderStatus.Cancelled => "Cancel order",
        _ => to.ToString()
    };

    // Legacy orders only have the backfilled "placed" row, so a later move can leave the last row
    // matching Status while an earlier step was never recorded. Check the whole chain: it must start
    // at "placed", every row must continue from the previous row's target, and end at the current status.
    private static bool HasHistoryGap(OrderDetailDto order)
    {
        var history = order.History;
        if (history.Count == 0 || history[0].FromStatus is not null)
            return true;
        for (var i = 1; i < history.Count; i++)
        {
            if (history[i].FromStatus != history[i - 1].ToStatus)
                return true;
        }
        return history[^1].ToStatus != order.Status;
    }

    private static string ActorText(OrderStatusChangeDto change) => change.ChangedBy switch
    {
        OrderStatusActor.Admin => string.IsNullOrWhiteSpace(change.ChangedByName) ? "Admin" : change.ChangedByName,
        OrderStatusActor.Customer => change.ByAccount ? "Customer (account)" : "Customer (order lookup)",
        _ => "System"
    };

    private void OpenStatusModal(OrderStatus to)
    {
        if (_order is null) return;
        _modalError = null;
        _statusError = null;
        _modal?.Show(to, _order.Code);
    }

    private async Task ConfirmStatusChangeAsync((OrderStatus To, string? Note) args)
    {
        if (_order is null || _saving) return;

        _saving = true;
        _modalError = null;
        _statusError = null;

        try
        {
            var result = await Sender.Send(
                new UpdateOrderStatusCommand(Id, _order.Status, args.To, args.Note, _order.PaymentStatus));

            var message = result.ValidationErrors.Select(e => e.ErrorMessage)
                .Concat(result.Errors)
                .FirstOrDefault(m => !string.IsNullOrWhiteSpace(m));

            if (result.IsSuccess)
            {
                _modal?.Hide();
                await LoadAsync();
            }
            else if (result.Status == ResultStatus.Conflict)
            {
                // Someone else changed the order: close the dialog, say so, and show the real state.
                _modal?.Hide();
                _statusError = message ?? "This order was updated by someone else. The page has been refreshed.";
                await LoadAsync();
            }
            else if (result.Status == ResultStatus.NotFound)
            {
                _modal?.Hide();
                _statusError = "This order no longer exists.";
                await LoadAsync();
            }
            else
            {
                // Invalid or other failure: keep the dialog open with the message.
                _modalError = message ?? "Could not update the status.";
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
