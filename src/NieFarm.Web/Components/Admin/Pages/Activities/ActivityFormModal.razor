@using NieFarm.Application.Features.Admin.Activities.Commands
@using NieFarm.Application.Features.Admin.Activities.Dtos
@using NieFarm.Application.Features.Admin.Activities.Queries
@using NieFarm.Domain.Enums
@inject ISender Sender

@if (_visible)
{
    <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="activity-form-title">
        <div class="admin-modal__dialog admin-modal__dialog--wide">
            <div class="admin-modal__head">
                <h2 id="activity-form-title">@(_model.Id is null ? "Add Activity" : "Edit Activity")</h2>
                <button class="btn-icon" type="button" title="Close" @onclick="CancelAsync">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
            </div>

            <div class="admin-modal__body">
                @if (_errors.Count > 0)
                {
                    <div class="form-alert form-alert--error">
                        @foreach (var error in _errors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }

                <div class="form-grid form-grid--2">
                    <div>
                        <label class="form-label-admin" for="ac-title">Title *</label>
                        <input id="ac-title" class="form-control-admin" @bind="_model.Title" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="ac-slug">Slug</label>
                        <input id="ac-slug" class="form-control-admin" @bind="_model.Slug"
                               placeholder="Leave blank to generate from the title" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="ac-modal-title">Modal heading (optional)</label>
                        <input id="ac-modal-title" class="form-control-admin" @bind="_model.ModalTitle"
                               placeholder="Leave blank to reuse the title" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="ac-date">Event date *</label>
                        <input id="ac-date" class="form-control-admin" type="date" @bind="_model.EventDate" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="ac-size">Card size *</label>
                        <select id="ac-size" class="form-control-admin" @bind="_model.CardSize">
                            <option value="@ActivityCardSize.Short">Short</option>
                            <option value="@ActivityCardSize.Medium">Medium</option>
                            <option value="@ActivityCardSize.Tall">Tall</option>
                            <option value="@ActivityCardSize.ExtraTall">Extra tall</option>
                        </select>
                    </div>
                </div>

                <div class="form-grid form-grid--2" style="margin-top:16px;">
                    <div>
                        @* Unmounted with the modal so each open gets a fresh InputFile. *@
                        <SingleImageField @ref="_imageField"
                                          Label="Image"
                                          Subfolder="@ActivityImageLimits.Subfolder"
                                          MaxBytes="ActivityImageLimits.MaxImageBytes"
                                          Value="@_model.ImageUrl"
                                          ValueChanged="url => _model.ImageUrl = url"
                                          PersistedValue="@_persistedImageUrl"
                                          Disabled="_saving"
                                          UploadingChanged="value => _uploading = value" />
                    </div>
                    <div>
                        <label class="form-label-admin" for="ac-alt">Image alt text *</label>
                        <input id="ac-alt" class="form-control-admin" @bind="_model.ImageAlt" />
                    </div>
                </div>

                <div style="margin-top:16px;">
                    <label class="form-label-admin">Body *</label>
                    @* Keyed so reopening the modal on another activity remounts the editor —
                       Quill never re-reads Value after it initialises. *@
                    <RichTextEditor @key="@($"body-{_editorKey}")"
                                    Value="@_model.Body"
                                    ValueChanged="value => _model.Body = value"
                                    Toolbar="RichTextEditor.ToolbarKind.Full"
                                    MinHeight="220"
                                    Placeholder="Nội dung hoạt động…" />
                </div>

                <label class="form-check-admin" style="margin-top:16px;">
                    <input type="checkbox" @bind="_model.IsPublished" /> Published
                </label>
            </div>

            <div class="admin-modal__foot">
                <button class="btn-admin-outline" type="button" @onclick="CancelAsync" disabled="@_saving">
                    Cancel
                </button>
                <button class="btn-admin" type="button" @onclick="SaveAsync"
                        disabled="@(_saving || _uploading)">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private sealed class FormModel
    {
        public int? Id { get; set; }
        public string Title { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public string ModalTitle { get; set; } = string.Empty;
        public DateTime EventDate { get; set; } = DateTime.Today;
        public string ImageUrl { get; set; } = string.Empty;
        public string ImageAlt { get; set; } = string.Empty;
        public ActivityCardSize CardSize { get; set; } = ActivityCardSize.Medium;
        public string Body { get; set; } = string.Empty;
        public bool IsPublished { get; set; } = true;
    }

    private FormModel _model = new();
    private SingleImageField? _imageField;
    private string _persistedImageUrl = string.Empty;
    private List<string> _errors = [];
    private Guid _editorKey = Guid.NewGuid();

    private bool _visible;
    private bool _saving;
    private bool _uploading;

    public void OpenForCreate()
    {
        _model = new FormModel();
        _persistedImageUrl = string.Empty;
        _errors = [];
        _editorKey = Guid.NewGuid();
        _visible = true;
        StateHasChanged();
    }

    public async Task OpenForEditAsync(int id)
    {
        var activity = await Sender.Send(new GetActivityForEditQuery(id));
        if (activity is null)
            return;

        _model = new FormModel
        {
            Id = activity.Id,
            Title = activity.Title,
            Slug = activity.Slug,
            ModalTitle = activity.ModalTitle,
            EventDate = activity.EventDate.ToDateTime(TimeOnly.MinValue),
            ImageUrl = activity.ImageUrl,
            ImageAlt = activity.ImageAlt,
            CardSize = activity.CardSize,
            Body = activity.Body,
            IsPublished = activity.IsPublished
        };

        _persistedImageUrl = activity.ImageUrl;
        _errors = [];
        _editorKey = Guid.NewGuid();
        _visible = true;
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _errors = [];

        try
        {
            var result = await Sender.Send(new SaveActivityCommand(
                _model.Id,
                _model.Title ?? string.Empty,
                _model.Slug,
                _model.ModalTitle,
                DateOnly.FromDateTime(_model.EventDate),
                _model.ImageUrl ?? string.Empty,
                _model.ImageAlt ?? string.Empty,
                _model.CardSize,
                _model.Body ?? string.Empty,
                _model.IsPublished));

            if (!result.IsSuccess)
            {
                _errors = result.ValidationErrors.Select(e => e.ErrorMessage)
                    .Concat(result.Errors)
                    .Where(m => !string.IsNullOrWhiteSpace(m))
                    .DefaultIfEmpty("Could not save the activity.")
                    .ToList();
                return;
            }

            // The upload is now a stored value, so the field must not treat it as an orphan.
            _persistedImageUrl = _model.ImageUrl ?? string.Empty;

            _visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task CancelAsync()
    {
        // Removes an upload that was never persisted, before the field unmounts.
        if (_imageField is not null)
            await _imageField.DiscardAsync();

        _visible = false;
    }
}
