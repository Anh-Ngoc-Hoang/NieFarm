@using NieFarm.Application.Features.Admin.Reviews.Commands
@using NieFarm.Application.Features.Admin.Reviews.Dtos
@using NieFarm.Domain.Entities
@using NieFarm.Domain.Enums
@inject ISender Sender

@*
    The single edit surface for a review's comment text (D16): one modal, not a separate
    read-only modal plus an edit modal. No GetReviewForEditQuery and no load-on-open round trip
    — ReviewAdminListDto already carries the full Comment, so Open() is synchronous.
*@

@if (_visible)
{
    <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="review-detail-title">
        <div class="admin-modal__dialog">
            <div class="admin-modal__head">
                <h2 id="review-detail-title">Review</h2>
                <button class="btn-icon" type="button" title="Close" @onclick="Close">
                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                </button>
            </div>

            <div class="admin-modal__body">
                <dl class="form-grid form-grid--2" style="margin-bottom:16px;">
                    <div>
                        <dt class="cell-muted" style="font-size:12px;">Product</dt>
                        <dd class="cell-primary" style="margin:0;">@_productName</dd>
                    </div>
                    <div>
                        <dt class="cell-muted" style="font-size:12px;">Author</dt>
                        <dd class="cell-primary" style="margin:0;">@_authorName</dd>
                    </div>
                    <div>
                        <dt class="cell-muted" style="font-size:12px;">Rating</dt>
                        <dd style="margin:0;"><StarRating Value="@_rating" SizeClass="text-sm" /></dd>
                    </div>
                    <div>
                        <dt class="cell-muted" style="font-size:12px;">Submitted</dt>
                        <dd class="cell-primary" style="margin:0;">@_createdAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                    <div>
                        <dt class="cell-muted" style="font-size:12px;">Status</dt>
                        <dd style="margin:0;"><AdminBadge Text="@_status.ToString()" Variant="@ReviewsPage.StatusVariant(_status)" /></dd>
                    </div>
                    @if (_commentEditedAt is { } editedAt)
                    {
                        <div>
                            <dt class="cell-muted" style="font-size:12px;">Edited</dt>
                            <dd class="cell-muted" style="margin:0;">Comment edited @editedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                        </div>
                    }
                </dl>

                @if (_errors.Count > 0)
                {
                    <div class="form-alert form-alert--error">
                        @foreach (var error in _errors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }

                <label class="form-label-admin" for="rv-comment">Comment *</label>
                <textarea id="rv-comment" class="form-control-admin" style="min-height:200px;"
                          maxlength="@Review.CommentMaxLength" @bind="_comment" @bind:event="oninput"
                          disabled="@_saving"></textarea>
                <div class="cell-muted" style="font-size:12px;text-align:right;">@_comment.Length / @Review.CommentMaxLength</div>
            </div>

            <div class="admin-modal__foot">
                <button class="btn-admin-outline" type="button" @onclick="Close" disabled="@_saving">
                    Cancel
                </button>
                <button class="btn-admin" type="button" @onclick="SaveAsync"
                        disabled="@(_saving || !CanSave)">
                    @(_saving ? "Saving…" : "Save")
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnSaved { get; set; }

    private int _id;
    private string _productName = string.Empty;
    private string _authorName = string.Empty;
    private int _rating;
    private DateTime _createdAt;
    private ReviewStatus _status;
    private DateTime? _commentEditedAt;

    private string _comment = string.Empty;
    private string _original = string.Empty;
    private List<string> _errors = [];

    private bool _visible;
    private bool _saving;

    private bool CanSave => _comment != _original && _comment.Trim().Length >= Review.CommentMinLength;

    /// <summary>Synchronous — ReviewAdminListDto already carries the full comment, so there is nothing to fetch.</summary>
    public void Open(ReviewAdminListDto review)
    {
        _id = review.Id;
        _productName = review.ProductName;
        _authorName = review.AuthorName;
        _rating = review.Rating;
        _createdAt = review.CreatedAt;
        _status = review.Status;
        _commentEditedAt = review.CommentEditedAt;

        _comment = review.Comment;
        _original = review.Comment;
        _errors = [];
        _visible = true;
        StateHasChanged();
    }

    private void Close() => _visible = false;

    private async Task SaveAsync()
    {
        _saving = true;
        _errors = [];

        try
        {
            var result = await Sender.Send(new EditReviewCommentCommand(_id, _comment));

            if (!result.IsSuccess)
            {
                _errors = result.ValidationErrors.Select(e => e.ErrorMessage)
                    .Concat(result.Errors)
                    .Where(m => !string.IsNullOrWhiteSpace(m))
                    .DefaultIfEmpty("Could not save the comment.")
                    .ToList();
                return;
            }

            _visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }
}
