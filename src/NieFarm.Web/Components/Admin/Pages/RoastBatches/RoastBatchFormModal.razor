    // The sensory selects share their option list.
    private static readonly RenderFragment LevelOptions = @<text>
        <option value="">Not specified</option>
        @for (var level = 1; level <= 5; level++)
        {
            <option value="@level">@level</option>
        }
    </text>;

    private static DateTime VnToday() => NieFarm.Web.Content.VnTime.FromUtc(DateTime.UtcNow);

    private static string Humanize(string name)
    {
        // "MediumLight" -> "Medium light", "PourOver" -> "Pour over".
        var text = System.Text.RegularExpressions.Regex.Replace(name, "(?<=[a-z])(?=[A-Z])", " ");
        return text.Length == 0 ? text : char.ToUpperInvariant(text[0]) + text[1..].ToLowerInvariant();
    }

    public async Task OpenForCreateAsync()
    {
        await LoadProductsAsync();
        _model = new FormModel();
        _persistedFarmImageUrl = string.Empty;
        _persistedLabImageUrl = string.Empty;
        _wasPublished = false;
        _errors = [];
        _activeTab = FormTab.General;
        _visible = true;
        StateHasChanged();
    }

    public async Task OpenForEditAsync(int id, bool labelTab = false)
    {
        var batch = await Sender.Send(new GetRoastBatchForEditQuery(id));
        if (batch is null)
            return;

        await LoadProductsAsync();

        var g = batch.General;
        var o = batch.Origin;
        var p = batch.Process;
        var q = batch.Quality;
        _model = new FormModel
        {
            Id = batch.Id,
            Code = batch.Code,
            CodeDisplay = batch.CodeDisplay,
            ProductId = batch.ProductId,
            IsPublished = batch.IsPublished,
            RoastDate = g.RoastDate,
            BestBefore = g.BestBefore,
            PeakFromDays = g.PeakFromDays,
            PeakToDays = g.PeakToDays,
            NetWeightGrams = g.NetWeightGrams,
            PackCount = g.PackCount,
            InternalNote = g.InternalNote,
            Province = o.Province,
            Commune = o.Commune,
            Locality = o.Locality,
            AltitudeMinMeters = o.AltitudeMinMeters,
            AltitudeMaxMeters = o.AltitudeMaxMeters,
            Variety = o.Variety,
            FarmName = o.FarmName,
            FarmStory = o.FarmStory,
            FarmImageUrl = o.FarmImageUrl ?? string.Empty,
            HarvestSeason = o.HarvestSeason,
            HarvestedFrom = o.HarvestedFrom,
            HarvestedTo = o.HarvestedTo,
            HarvestMethod = o.HarvestMethod,
            ProcessingMethod = p.ProcessingMethod,
            ProcessingNote = p.ProcessingNote,
            FermentationHours = p.FermentationHours,
            DryingDays = p.DryingDays,
            DryingMethod = p.DryingMethod,
            RoastLevel = p.RoastLevel,
            RoasterName = p.RoasterName,
            RoastNote = p.RoastNote,
            PackedOn = p.PackedOn,
            HasOneWayValve = p.HasOneWayValve,
            IsNitrogenFlushed = p.IsNitrogenFlushed,
            PackagingNote = p.PackagingNote,
            CuppingScore = q.CuppingScore,
            CuppedBy = q.CuppedBy,
            FlavourNotes = q.FlavourNotes,
            AcidityLevel = q.AcidityLevel,
            BodyLevel = q.BodyLevel,
            SweetnessLevel = q.SweetnessLevel,
            BitternessLevel = q.BitternessLevel,
            MoisturePercent = q.MoisturePercent,
            ScreenSize = q.ScreenSize,
            DefectRatePercent = q.DefectRatePercent,
            LabReportImageUrl = q.LabReportImageUrl ?? string.Empty,
            Certifications = q.Certifications.Select(c => new CertModel { Name = c.Name, Number = c.Number }).ToList(),
            StorageTip = batch.Brewing.StorageTip,
            Guides = batch.Brewing.Guides.Select(x => new GuideModel
            {
                Method = x.Method,
                Ratio = x.Ratio,
                WaterTempCelsius = x.WaterTempCelsius,
                BrewTime = x.BrewTime,
                Note = x.Note
            }).ToList()
        };

        _persistedFarmImageUrl = _model.FarmImageUrl;
        _persistedLabImageUrl = _model.LabReportImageUrl;
        _wasPublished = batch.IsPublished;
        _errors = [];
        _activeTab = labelTab ? FormTab.Label : FormTab.General;
        _visible = true;
        StateHasChanged();
    }

    private async Task LoadProductsAsync()
    {
        if (_products.Count == 0)
            _products = (await Sender.Send(new GetProductsAdminQuery())).OrderBy(p => p.Name).ToList();
    }

    private void AddGuide()
    {
        // Offer the first method that does not have a guide yet (the server keeps one guide per method).
        var free = Enum.GetValues<BrewMethod>().FirstOrDefault(m => _model.Guides.All(g => g.Method != m));
        _model.Guides.Add(new GuideModel { Method = free == default ? BrewMethod.Phin : free });
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _errors = [];

        try
        {
            if (_dates.HasInvalid)
            {
                _errors = ["Fix the highlighted date fields (dd/MM/yyyy)."];
                return;
            }

            var m = _model;
            var command = new SaveRoastBatchCommand(
                m.Id,
                m.ProductId,
                m.IsPublished,
                new RoastBatchGeneralInput(m.RoastDate, m.BestBefore, m.PeakFromDays, m.PeakToDays, m.NetWeightGrams, m.PackCount, m.InternalNote),
                new RoastBatchOriginInput(m.Province, m.Commune, m.Locality, m.AltitudeMinMeters, m.AltitudeMaxMeters, m.Variety, m.FarmName,
                    m.FarmStory, m.FarmImageUrl, m.HarvestSeason, m.HarvestedFrom, m.HarvestedTo, m.HarvestMethod),
                new RoastBatchProcessInput(m.ProcessingMethod, m.ProcessingNote, m.FermentationHours, m.DryingDays, m.DryingMethod,
                    m.RoastLevel, m.RoasterName, m.RoastNote, m.PackedOn, m.HasOneWayValve, m.IsNitrogenFlushed, m.PackagingNote),
                new RoastBatchQualityInput(m.CuppingScore, m.CuppedBy, m.FlavourNotes, ToLevel(m.AcidityLevel), ToLevel(m.BodyLevel),
                    ToLevel(m.SweetnessLevel), ToLevel(m.BitternessLevel), m.MoisturePercent, m.ScreenSize, m.DefectRatePercent,
                    m.LabReportImageUrl,
                    m.Certifications.Where(c => !string.IsNullOrWhiteSpace(c.Name)).Select(c => new RoastBatchCertificationInput(c.Name, c.Number)).ToList()),
                new RoastBatchBrewingInput(m.StorageTip,
                    m.Guides.Select(g => new RoastBatchBrewGuideInput(g.Method, g.Ratio, g.WaterTempCelsius, g.BrewTime, g.Note)).ToList()));

            var result = await Sender.Send(command);
            if (!result.IsSuccess)
            {
                _errors = result.ValidationErrors.Select(e => e.ErrorMessage)
                    .Concat(result.Errors)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .DefaultIfEmpty("Could not save the batch.")
                    .ToList();
                return;
            }

            // The uploads are stored values now, so the fields must not treat them as orphans.
            _persistedFarmImageUrl = _model.FarmImageUrl;
            _persistedLabImageUrl = _model.LabReportImageUrl;

            _visible = false;
            await OnSaved.InvokeAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private static byte? ToLevel(int? value) => value is >= 1 and <= 5 ? (byte)value.Value : null;

    private async Task CancelAsync()
    {
        // Removes uploads that were never persisted, before the fields unmount.
        if (_farmImageField is not null)
            await _farmImageField.DiscardAsync();
        if (_labImageField is not null)
            await _labImageField.DiscardAsync();

        _visible = false;
    }
