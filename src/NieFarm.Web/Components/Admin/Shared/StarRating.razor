@*
    Amber star row used on product cards, the product detail header and testimonials.
    Renders filled / half / empty Material Symbols to match the Stitch screens.

    Tailwind-free (docs/plans/public-site-redesign-nf2.md §4, step 0.3): sizing used to come
    from a "text-*" utility on each glyph plus the root's "text-amber-gold" for colour. ".nf-stars"
    (defined in blazor-ui.css, later also nf.css) now supplies both the flex layout and the gold
    colour, so this component no longer depends on the Tailwind CDN or its config. Admin's two
    call sites (ReviewsPage, ReviewDetailModal) get their colour from that class too.
*@

<div class="nf-stars @CssClass" role="img" aria-label="@AriaLabel">
    @for (var i = 1; i <= 5; i++)
    {
        var filled = Value >= i;
        var half = !filled && Value >= i - 0.5;

        <span class="material-symbols-outlined @SizeClass @(filled || half ? "icon-fill" : null)"
              aria-hidden="true">
            @(half ? "star_half" : "star")
        </span>
    }
</div>

@code {
    /// <summary>Rating out of five; halves render as <c>star_half</c>.</summary>
    [Parameter]
    public double Value { get; set; } = 5;

    /// <summary>Optional font-size override for each glyph; <c>.nf-stars</c> already sets 1rem.</summary>
    [Parameter]
    public string? SizeClass { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    private string AriaLabel => $"Đánh giá {Value.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)} trên 5 sao";
}
