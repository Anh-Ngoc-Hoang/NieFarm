@if (_visible)
{
    <div class="admin-modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
        <div class="admin-modal__dialog" style="max-width:440px;">
            <div class="admin-modal__body">
                <h2 id="confirm-title" style="font-size:16px;font-weight:600;margin:0 0 8px;">@Title</h2>
                <p class="cell-muted" style="margin:0;">@Message</p>
            </div>
            <div class="admin-modal__foot">
                <button class="btn-admin-outline" type="button" @onclick="Cancel">Cancel</button>
                <button class="btn-admin" type="button"
                        style="background:var(--admin-danger);border-color:var(--admin-danger);"
                        @onclick="Confirm">
                    @ConfirmLabel
                </button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "Confirm";
    [Parameter] public string Message { get; set; } = "Are you sure?";
    [Parameter] public string ConfirmLabel { get; set; } = "Delete";
    [Parameter] public EventCallback OnConfirm { get; set; }

    private bool _visible;

    public void Show()
    {
        _visible = true;
        StateHasChanged();
    }

    public void Hide()
    {
        _visible = false;
        StateHasChanged();
    }

    private async Task Confirm()
    {
        _visible = false;
        await OnConfirm.InvokeAsync();
    }

    private void Cancel() => _visible = false;
}
